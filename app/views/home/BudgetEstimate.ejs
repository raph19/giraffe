<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Budget Estimate Calculator</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
*{box-sizing:border-box}

:root{
 --navy:#102c46;
 --blue:#087b9b;
 --light:#f3f6fa;
 --border:#dce5ed;
 --text:#263445;
}

body{
 margin:0;
 background:var(--light);
 font-family:Arial,sans-serif;
 color:var(--text);
}

/* HEADER */

.welcome{
 background:linear-gradient(120deg,#102c46,#176b87);
 color:white;
 padding:42px 20px;
 text-align:center;
 position:relative;
}

.welcome h1{
 font-size:30px;
 font-weight:bold;
 margin:0 0 10px;
}

.welcome p{
 color:#d5e6ef;
 font-size:15px;
 margin:0;
}

/* LANGUAGE SELECTOR */

.language{
 position:absolute;
 right:25px;
 top:20px;
 z-index:10;
}

.language select{
 appearance:none;
 -webkit-appearance:none;
 background:rgba(255,255,255,.14);
 color:white;
 border:1px solid rgba(255,255,255,.35);
 border-radius:10px;
 padding:11px 38px 11px 14px;
 font-size:13px;
 font-weight:bold;
 cursor:pointer;
 outline:none;
 min-width:145px;
 backdrop-filter:blur(8px);
}

.language select:hover{
 background:rgba(255,255,255,.23);
}

.language select option{
 background:#fff;
 color:#263445;
}

.language:after{
 content:"⌄";
 position:absolute;
 right:14px;
 top:7px;
 font-size:19px;
 color:white;
 pointer-events:none;
}

/* MAIN */

.main-container{
 max-width:1180px;
 margin:32px auto;
 padding:0 20px;
}

.panel-custom{
 background:#fff;
 padding:25px;
 border-radius:12px;
 margin-bottom:24px;
 box-shadow:0 3px 15px rgba(0,0,0,.06);
}

.panel-custom h3{
 margin:0 0 24px;
 font-weight:bold;
 color:#174b68;
 border-bottom:2px solid #edf1f5;
 padding-bottom:14px;
}

.form-grid{
 display:grid;
 grid-template-columns:repeat(2,minmax(0,1fr));
 gap:18px;
}

.form-group{
 min-width:0;
 margin-bottom:2px;
}

label{
 display:block;
 font-weight:600;
 margin-bottom:8px;
 font-size:14px;
}

.form-control{
 width:100%;
 height:45px;
 padding:9px 12px;
 border-radius:7px;
 border:1px solid var(--border);
 background:white;
 color:var(--text);
 font-size:14px;
 outline:none;
}

.form-control:focus{
 border-color:#1683a5;
 box-shadow:0 0 5px rgba(22,131,165,.2);
}

.btn-calculate{
 background:#087b9b;
 color:white;
 font-weight:bold;
 border:0;
 padding:13px 25px;
 border-radius:7px;
 font-size:14px;
 margin:12px 8px 0 0;
 cursor:pointer;
 transition:.2s;
 min-height:45px;
}

.btn-calculate:hover{
 background:#075e78;
}

.btn-secondary{
 background:#647789;
}

.btn-secondary:hover{
 background:#485d70;
}

.note{
 color:#758493;
 font-size:12px;
 margin-top:12px;
 line-height:1.6;
}

.status-line{
 font-size:13px;
 color:#b33c3c;
 margin:12px 0 0;
}

.derived{
 background:#f5f9fb;
 border:1px dashed #c9dbe5;
 padding:12px;
 border-radius:7px;
 color:#456273;
 font-size:12px;
 margin-top:15px;
}

/* RESULTS */

.hidden-results{
 display:none;
}

.result-card{
 background:linear-gradient(120deg,#123d58,#087b9b);
 color:white;
 padding:27px;
 border-radius:12px;
 margin-bottom:24px;
}

.result-card h4{
 color:#d6eaf2;
 margin-top:0;
}

.result-card h2{
 font-size:36px;
 font-weight:bold;
 margin:10px 0;
 overflow-wrap:anywhere;
}

.result-card p{
 line-height:1.6;
 font-size:13px;
}

.table-responsive{
 width:100%;
 overflow-x:auto;
 -webkit-overflow-scrolling:touch;
 border-radius:6px;
}

.table{
 width:100%;
 min-width:650px;
 border-collapse:collapse;
 margin-bottom:0;
 font-size:13px;
}

.table th,.table td{
 border:1px solid #dce5ed;
 padding:12px;
 text-align:left;
 vertical-align:middle;
}

.table thead{
 background:#edf3f7;
}

.total-row{
 font-weight:bold;
 background:#e8f3f7;
}

/* ASSUMPTIONS */

.assumptions-wrap{
 background:linear-gradient(120deg,#123d58,#087b9b);
 border-radius:12px;
 padding:25px;
 color:white;
}

.assumptions-head{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:12px;
 margin-bottom:20px;
}

.assumptions-head h3{
 border:0;
 margin:0;
 padding:0;
 color:white;
}

.assumptions-head span{
 font-size:11px;
 letter-spacing:.08em;
 text-transform:uppercase;
 color:#d6eaf2;
 font-weight:bold;
}

.assumption-grid{
 display:grid;
 grid-template-columns:repeat(2,minmax(0,1fr));
 gap:13px;
}

.assumption-card{
 background:rgba(255,255,255,.10);
 border:1px solid rgba(255,255,255,.22);
 border-radius:11px;
 padding:17px;
 min-height:120px;
}

.assumption-card .eyebrow{
 font-size:11px;
 color:#bce8f5;
 text-transform:uppercase;
 letter-spacing:.08em;
 font-weight:bold;
 margin-bottom:7px;
}

.assumption-card h4{
 font-size:15px;
 color:white;
 font-weight:bold;
 margin:0 0 8px;
}

.assumption-card p{
 font-size:12px;
 line-height:1.6;
 color:#e0edf3;
 margin:0;
}

.assumption-wide{
 grid-column:1/-1;
 background:rgba(255,255,255,.15);
}

footer{
 text-align:center;
 padding:24px;
 color:#84919e;
 font-size:12px;
}

/* RTL SUPPORT */

html[dir="rtl"] body{
 direction:rtl;
 text-align:right;
}

html[dir="rtl"] .language{
 right:auto;
 left:25px;
}

html[dir="rtl"] .language select{
 padding:11px 14px 11px 38px;
 text-align:right;
}

html[dir="rtl"] .language:after{
 right:auto;
 left:14px;
}

html[dir="rtl"] .table th,
html[dir="rtl"] .table td{
 text-align:right;
}

html[dir="rtl"] .btn-calculate{
 margin:12px 0 0 8px;
}

html[dir="rtl"] .assumptions-head{
 flex-direction:row;
}

/* MOBILE */

@media(max-width:767px){

 .welcome{
  padding:85px 15px 28px;
 }

 .welcome h1{
  font-size:23px;
 }

 .welcome p{
  font-size:13px;
 }

 .language{
  top:13px;
  right:13px;
 }

 html[dir="rtl"] .language{
  right:auto;
  left:13px;
 }

 .language select{
  min-width:135px;
  padding:9px 32px 9px 10px;
  font-size:12px;
 }

 .main-container{
  margin:18px auto;
  padding:0 12px;
 }

 .panel-custom{
  padding:17px;
  border-radius:10px;
 }

 .form-grid{
  grid-template-columns:1fr;
  gap:14px;
 }

 .form-control{
  height:46px;
  font-size:16px;
 }

 .btn-calculate{
  width:100%;
  margin:10px 0 0;
  min-height:47px;
 }

 html[dir="rtl"] .btn-calculate{
  margin:10px 0 0;
 }

 .result-card{
  padding:20px;
 }

 .result-card h2{
  font-size:28px;
 }

 .assumptions-wrap{
  padding:18px;
 }

 .assumption-grid{
  grid-template-columns:1fr;
 }

 .assumption-wide{
  grid-column:auto;
 }

 .assumptions-head{
  align-items:flex-start;
  flex-direction:column;
 }

 .table{
  min-width:620px;
 }

}

/* PRINT */

@media print{

 .language,
 .btn-calculate,
 footer{
  display:none!important;
 }

 body{
  background:white;
 }

 .panel-custom,
 .result-card{
  box-shadow:none;
  break-inside:avoid;
 }

}
</style>
</head>

<body>

<section class="welcome">

 <div class="language">
  <select id="language" aria-label="Select language">
   <option value="en">🇬🇧 English</option>
   <option value="el">🇬🇷 Ελληνικά</option>
   <option value="de">🇩🇪 Deutsch</option>
   <option value="fr">🇫🇷 Français</option>
   <option value="ar">🇸🇦 العربية</option>
  </select>
 </div>

 <h1 data-i18n="title">Budget Estimate Calculator</h1>
 <p data-i18n="subtitle">Preliminary EPC Project Cost Estimation Tool</p>

</section>

<div class="main-container">

<form id="budgetForm" novalidate>

<div class="panel-custom">

<h3 data-i18n="projectInfo">Project Information</h3>

<div class="form-grid">

<div class="form-group">
<label data-i18n="country" for="country">Country / Market</label>
<select id="country" class="form-control">
<option value="" data-i18n="selectCountry">Select Country</option>
</select>
</div>

<div class="form-group">
<label data-i18n="projectType" for="projectType">Project Type</label>
<select id="projectType" class="form-control">
<option value="" data-i18n="selectProject">Select Project</option>
<option value="solar">Solar PV</option>
<option value="bess">BESS</option>
<option value="datacenter">Data Center</option>
</select>
</div>

<div class="form-group">
<label id="capacityLabel" for="capacity">Project Capacity (MW)</label>
<input id="capacity" class="form-control" type="number" min="0.01" step="any" placeholder="Enter capacity">
</div>

<div class="form-group" id="solarTechnologyGroup" style="display:none">
<label data-i18n="technology" for="solarTechnology">PV Module Technology</label>
<select id="solarTechnology" class="form-control">
<option value="" data-i18n="selectTechnology">Select Technology</option>
<option value="topcon_mono">N-type TOPCon Monofacial</option>
<option value="topcon_bifacial">N-type TOPCon Bifacial</option>
</select>
</div>

<div class="form-group" id="modulePowerGroup" style="display:none">
<label data-i18n="modulePower" for="modulePower">PV Module Power (Wp)</label>
<select id="modulePower" class="form-control">
<option value="" data-i18n="selectPower">Select Module Power</option>
<option>450</option><option>500</option>
<option>550</option><option>575</option>
<option>600</option><option>610</option>
<option>620</option><option>630</option>
<option>640</option><option>650</option>
<option>700</option>
</select>
</div>

<div class="form-group" id="mountingGroup" style="display:none">
<label data-i18n="mounting" for="mountingType">Mounting System</label>
<select id="mountingType" class="form-control">
<option value="" data-i18n="selectMounting">Select Mounting System</option>
<option value="fixed" data-i18n="fixed">Fixed Tilt</option>
<option value="tracker" data-i18n="tracker">Single Axis Tracker</option>
</select>
</div>

<div class="form-group" id="invertersGroup" style="display:none">
<label data-i18n="inverters" for="inverters">Number of Inverters</label>
<input id="inverters" class="form-control" type="number" min="1" step="1">
</div>

<div class="form-group" id="substationsGroup" style="display:none">
<label data-i18n="substations" for="substations">Number of MV Substations</label>
<input id="substations" class="form-control" type="number" min="1" step="1">
</div>

<div class="form-group" id="modulesStringGroup" style="display:none">
<label data-i18n="modulesString" for="modulesPerString">Modules per String</label>
<input id="modulesPerString" class="form-control" type="number" min="1" step="1">
</div>

<div class="form-group" id="mvCableGroup" style="display:none">
<label data-i18n="mvCable" for="mvCableLength">MV Cable Route Length (m) – optional</label>
<input id="mvCableLength" class="form-control" type="number" min="0">
</div>

<div class="form-group" id="dcCableGroup" style="display:none">
<label data-i18n="dcCable" for="dcCableLength">DC Cable Length (m) – optional</label>
<input id="dcCableLength" class="form-control" type="number" min="0">
</div>

<div class="form-group" id="acCableGroup" style="display:none">
<label data-i18n="acCable" for="acCableLength">AC LV Cable Length (m) – optional</label>
<input id="acCableLength" class="form-control" type="number" min="0">
</div>

<div class="form-group" id="hvCableGroup" style="display:none">
<label data-i18n="hvCable" for="hvCableLength">HV / Export Cable Length (m) – optional</label>
<input id="hvCableLength" class="form-control" type="number" min="0">
</div>

<div class="form-group" id="fibreCableGroup" style="display:none">
<label data-i18n="fibreCable" for="fibreCableLength">Fibre Optic Cable Length (m) – optional</label>
<input id="fibreCableLength" class="form-control" type="number" min="0">
</div>

<div class="form-group" id="roadLengthGroup" style="display:none">
<label data-i18n="roadLength" for="roadLength">Access Road Length (m) – optional</label>
<input id="roadLength" class="form-control" type="number" min="0">
</div>

<div class="form-group" id="durationGroup" style="display:none">
<label data-i18n="duration" for="duration">BESS Duration (Hours)</label>
<input id="duration" class="form-control" type="number" min="0.5" step="any">
</div>

<div class="form-group" id="chemistryGroup" style="display:none">
<label data-i18n="chemistry" for="batteryChemistry">Battery Chemistry</label>
<select id="batteryChemistry" class="form-control">
<option value="" data-i18n="selectChemistry">Select Chemistry</option>
<option value="LFP">LFP</option>
<option value="NMC">NMC</option>
</select>
</div>

<div class="form-group" id="tierGroup" style="display:none">
<label data-i18n="tier" for="dataCenterTier">Data Center Tier</label>
<select id="dataCenterTier" class="form-control">
<option value="" data-i18n="selectTier">Select Tier</option>
<option>Tier II</option>
<option>Tier III</option>
<option>Tier IV</option>
</select>
</div>

<div class="form-group" id="coolingGroup" style="display:none">
<label data-i18n="cooling" for="coolingType">Cooling System</label>
<select id="coolingType" class="form-control">
<option value="" data-i18n="selectCooling">Select Cooling</option>
<option data-i18n="airCooling">Air Cooling</option>
<option data-i18n="liquidCooling">Liquid Cooling</option>
</select>
</div>

</div>

<div id="solarDerived" class="derived" style="display:none"></div>

<button class="btn-calculate" type="submit" data-i18n="calculate">Calculate Budget</button>
<button class="btn-calculate btn-secondary" type="button" id="resetBtn" data-i18n="reset">Reset</button>

<p class="note" data-i18n="inputNote">
Budget updates automatically when you change a project input.
</p>

<p id="validationMessage" class="status-line" role="status"></p>

</div>
</form>

<div id="results" class="hidden-results">

<div class="result-card">
<h4 data-i18n="totalEpc">Total Estimated EPC Cost</h4>
<h2 id="totalBudget">€0</h2>
<p id="projectSummary"></p>
<p id="marketSummary"></p>
<h4 id="costPerMW"></h4>
</div>

<div class="panel-custom">

<h3 data-i18n="breakdown">EPC Cost Breakdown</h3>

<div class="table-responsive">
<table class="table">
<thead>
<tr>
<th data-i18n="category">Work Category</th>
<th data-i18n="baseCost">Base Cost (€)</th>
<th data-i18n="factor">Market Factor</th>
<th data-i18n="estimatedCost">Estimated Cost (€)</th>
</tr>
</thead>
<tbody id="costTable"></tbody>
<tfoot>
<tr class="total-row">
<td colspan="3" data-i18n="total">TOTAL EPC COST</td>
<td id="costTotal">€0</td>
</tr>
</tfoot>
</table>
</div>

<p class="note" data-i18n="epcNote">
EPC total includes equipment procurement, construction, installation, engineering, commissioning and contingency.
</p>

</div>

<div class="panel-custom">

<h3 data-i18n="materialReference">Material / Equipment Reference</h3>

<div class="table-responsive">
<table class="table">
<thead>
<tr>
<th data-i18n="material">Material / Equipment</th>
<th data-i18n="quantity">Estimated Quantity</th>
<th data-i18n="unit">Unit</th>
<th data-i18n="unitPrice">Indicative Unit Price (€)</th>
<th data-i18n="referenceTotal">Reference Total (€)</th>
</tr>
</thead>
<tbody id="materialTable"></tbody>
<tfoot>
<tr class="total-row">
<td colspan="4" data-i18n="referenceSum">TOTAL MATERIAL REFERENCE VALUE</td>
<td id="materialTotal">€0</td>
</tr>
</tfoot>
</table>
</div>

<p class="note" data-i18n="materialNote">
Reference values are informational only and are not added again to EPC total.
</p>

</div>

<div class="panel-custom">

<div class="assumptions-wrap">

<div class="assumptions-head">
<h3 data-i18n="assumptions">Project Assumptions & Cost Parameters</h3>
<span data-i18n="budgetary">Budgetary Model</span>
</div>

<div class="assumption-grid">

<div class="assumption-card">
<div class="eyebrow" data-i18n="marketAdjustment">01 · Market</div>
<h4 data-i18n="countryFactor">Country Adjustment</h4>
<p data-i18n="countryFactorText">The selected country factor adjusts labour, logistics, installation and local subcontractor costs.</p>
</div>

<div class="assumption-card">
<div class="eyebrow" data-i18n="epcScope">02 · EPC Scope</div>
<h4 data-i18n="turnkey">Turnkey Cost Structure</h4>
<p data-i18n="turnkeyText">The EPC estimate includes procurement, civil and electrical works, installation, engineering and commissioning.</p>
</div>

<div class="assumption-card">
<div class="eyebrow" data-i18n="contingencyLabel">03 · Risk Allowance</div>
<h4 data-i18n="contingency">Contingency / Unforeseen Costs</h4>
<p data-i18n="contingencyText">A budget reserve for scope development, design changes and unforeseen site conditions. It is included once in the EPC total.</p>
</div>

<div class="assumption-card">
<div class="eyebrow" data-i18n="pricing">04 · Pricing</div>
<h4 data-i18n="bulk">Bulk Procurement References</h4>
<p data-i18n="bulkText">Indicative project-scale procurement levels, not retail prices or binding supplier quotations.</p>
</div>

<div class="assumption-card assumption-wide">
<div class="eyebrow" data-i18n="projectConsiderations">05 · Project Definition</div>
<h4 data-i18n="siteSpecific">Site-specific Cost Factors</h4>
<p data-i18n="siteSpecificText">Final project costs will be refined against grid connection scope, ground conditions, detailed design, cable routes, taxes, transport and equipment specifications.</p>
</div>

</div>
</div>
</div>

<button class="btn-calculate" type="button" id="exportBtn" data-i18n="excel">Download Excel</button>
<button class="btn-calculate" type="button" onclick="window.print()" data-i18n="print">Print / Save as PDF</button>

</div>
</div>

<footer data-i18n="footer">Budget Estimate Calculator | Preliminary EPC Estimation</footer>

<script>

const $ = id => document.getElementById(id);

/* COUNTRY LIST */

const countryCodes = `AD AE AL AM AO AR AT AU AZ BA BE BG BH BR BY CA CH CL CN CO CR CY CZ DE DK EE ES FI FR GB GE GR HR HU ID IE IL IN IS IT JP KR LT LU LV MA ME MK MT MX MY NL NO NZ PH PL PT RO RS SA SE SG SI SK TR TW UA US VN ZA`.split(/\s+/);

const countryNames = new Intl.DisplayNames(['en'],{type:'region'});

countryCodes.sort((a,b)=>countryNames.of(a).localeCompare(countryNames.of(b))).forEach(code=>{
 const option=document.createElement('option');
 option.value=code;
 option.textContent=countryNames.of(code);
 $('country').appendChild(option);
});

/* COUNTRY MARKET FACTORS */

const countryRates={
 IE:1,GB:1.04,DE:1.02,FR:1,NL:1.03,BE:1.02,
 ES:.88,PT:.86,IT:.96,GR:.83,US:1.08,CA:1.1,
 AU:1.08,JP:1.15,KR:1.02,IN:.55,CN:.62,BR:.75,
 ZA:.7,SA:.9,AE:.93,PL:.78,RO:.7,BG:.68,
 SE:1.05,NO:1.13,DK:1.07,FI:1.03,TR:.72
};

/* MODULE PRICES */

const moduleOptions={
 topcon_mono:{name:'N-type TOPCon Monofacial',price:.120},
 topcon_bifacial:{name:'N-type TOPCon Bifacial',price:.114}
};

/* EPC RATES */

const rates={
 solar:{civil:110000,mechanical:90000,electrical:160000},
 bess:{civil:300000,batteryPerMWh:93000},
 datacenter:{civil:1200000,mechanical:2400000,electrical:3800000}
};

/* TRANSLATIONS */

const labels={

en:{
 title:'Budget Estimate Calculator',
 subtitle:'Preliminary EPC Project Cost Estimation Tool',
 projectInfo:'Project Information',
 country:'Country / Market',
 selectCountry:'Select Country',
 projectType:'Project Type',
 selectProject:'Select Project',
 technology:'PV Module Technology',
 selectTechnology:'Select Technology',
 modulePower:'PV Module Power (Wp)',
 selectPower:'Select Module Power',
 mounting:'Mounting System',
 selectMounting:'Select Mounting System',
 fixed:'Fixed Tilt',
 tracker:'Single Axis Tracker',
 inverters:'Number of Inverters',
 substations:'Number of MV Substations',
 modulesString:'Modules per String',
 mvCable:'MV Cable Route Length (m) – optional',
 dcCable:'DC Cable Length (m) – optional',
 acCable:'AC LV Cable Length (m) – optional',
 hvCable:'HV / Export Cable Length (m) – optional',
 fibreCable:'Fibre Optic / Communication Cable Length (m) – optional',
 roadLength:'Access Road Length (m) – optional',
 duration:'BESS Duration (Hours)',
 chemistry:'Battery Chemistry',
 selectChemistry:'Select Chemistry',
 tier:'Data Center Tier',
 selectTier:'Select Tier',
 cooling:'Cooling System',
 selectCooling:'Select Cooling',
 airCooling:'Air Cooling',
 liquidCooling:'Liquid Cooling',
 calculate:'Calculate Budget',
 reset:'Reset',
 inputNote:'Budget updates automatically when you change a project input. Press Enter to calculate manually.',
 totalEpc:'Total Estimated EPC Cost',
 breakdown:'EPC Cost Breakdown',
 category:'Work Category',
 baseCost:'Base Cost (€)',
 factor:'Market Factor',
 estimatedCost:'Estimated Cost (€)',
 total:'TOTAL EPC COST',
 epcNote:'EPC total includes equipment procurement, construction, installation, engineering, commissioning and contingency.',
 materialReference:'Material / Equipment Reference',
 material:'Material / Equipment',
 quantity:'Estimated Quantity',
 unit:'Unit',
 unitPrice:'Indicative Unit Price (€)',
 referenceTotal:'Reference Total (€)',
 referenceSum:'TOTAL MATERIAL REFERENCE VALUE',
 materialNote:'Reference values are informational only. They are already represented within the EPC estimate and are NOT added again.',
 assumptions:'Project Assumptions & Cost Parameters',
 budgetary:'Budgetary Model',
 marketAdjustment:'01 · Market',
 countryFactor:'Country Adjustment',
