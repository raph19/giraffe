// 9. RESET CALCULATOR
// =====================================

function resetCalculator() {

    document.getElementById("country").value = "";

    document.getElementById("projectType").value = "";

    document.getElementById("capacity").value = "";

    document.getElementById("duration").value = "";

    document.getElementById("solarTechnology").value = "";

    document.getElementById("mountingType").value = "";

    document.getElementById("batteryChemistry").value = "";

    document.getElementById("dataCenterTier").value = "";

    document.getElementById("coolingType").value = "";

    document.getElementById("results").style.display = "none";

    document.getElementById("capacityLabel").textContent =
        "Project Capacity (MW)";

    updateProjectOptions();

    lastCalculation = null;

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

}

</script>

