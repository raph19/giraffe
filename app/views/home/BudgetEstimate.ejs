function tr(k){const lang=$('language').value;return (labels[lang]&&labels[lang][k])||labels.en[k]||k;}
function setLanguage(){const lang=$('language').value;document.documentElement.lang=lang;document.documentElement.dir=lang==='ar'?'rtl':'ltr';populateCountries(lang);document.querySelectorAll('[data-i18n]').forEach(el=>{el.textContent=tr(el.dataset.i18n)});document.querySelectorAll('[data-placeholder]').forEach(el=>{el.placeholder=tr(el.dataset.placeholder)});updateCapacityLabel();}
function updateCapacityLabel(){const type=$('projectType').value;$('capacityLabel').textContent=type==='solar'?tr('capacitySolar'):type==='bess'?tr('capacityBess'):type==='datacenter'?tr('capacityDc'):tr('capacityGeneric');const groups=['solarTechnologyGroup','modulePowerGroup','mountingGroup','invertersGroup','substationsGroup','modulesStringGroup','durationGroup','chemistryGroup','tierGroup','coolingGroup'];groups.forEach(id=>$(id).style.display='none');['solarOptionalGroup','bessOptionalGroup','dcOptionalGroup'].forEach(id=>$(id).style.display='none');const show=ids=>ids.forEach(id=>$(id).style.display='block');if(type==='solar'){show(['solarTechnologyGroup','modulePowerGroup','mountingGroup','invertersGroup','substationsGroup','modulesStringGroup','solarOptionalGroup']);}if(type==='bess')show(['durationGroup','chemistryGroup','bessOptionalGroup']);if(type==='datacenter')show(['tierGroup','coolingGroup','dcOptionalGroup']);}
