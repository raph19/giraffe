
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EPC Budget Estimator</title>

<link rel="stylesheet"
 href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">

<style>
:root {
    --navy: #142b49;
    --blue: #2463a6;
    --light: #f3f6fa;
    --border: #e1e7ef;
    --text: #26364a;
    --green: #15966b;
}

* { box-sizing: border-box; }

body {
    background: #f3f6fa;
    color: var(--text);
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 25px 12px;
}

.container {
    max-width: 1120px;
    width: 100%;
}

.header {
    background: linear-gradient(120deg, #142b49, #245b91);
    color: white;
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 22px;
}

.header h2 {
    font-weight: 700;
    margin: 0 0 8px;
}

.header p {
    margin: 0;
    opacity: .85;
}

.panel-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: 0 3px 12px rgba(20,43,73,.04);
}

.section-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
}

label {
    font-weight: 600;
    color: #45566c;
    margin-bottom: 7px;
}

.form-control {
    height: 44px;
    border: 1px solid #d8e0ea;
    border-radius: 7px;
    box-shadow: none;
}

.form-control:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 2px rgba(36,99,166,.08);
}

.form-group { margin-bottom: 20px; }

.help-text {
    color: #7a8796;
    font-size: 12px;
    margin-top: 6px;
}

.dynamic-section { display: none; }

.btn-main {
    background: var(--blue);
    color: white;
    border: none;
    padding: 13px 28px;
    border-radius: 7px;
    font-weight: 700;
}

.btn-main:hover {
    background: #194d83;
    color: white;
}

.btn-reset {
    background: #edf1f6;
    color: #34465d;
    border: none;
    padding: 13px 22px;
    border-radius: 7px;
    font-weight: 600;
}

.action-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.table-responsive {
    border: 0;
    margin-bottom: 0;
}

.table {
    margin-bottom: 0;
}

.table thead {
    background: #f1f5f9;
}

.table th {
    color: var(--navy);
    font-size: 13px;
}

.table td, .table th {
    padding: 12px !important;
    vertical-align: middle !important;
}

.material-note {
    background: #f4f8fc;
    border-left: 4px solid var(--blue);
    padding: 12px 15px;
    border-radius: 5px;
    color: #53647a;
    font-size: 13px;
    margin-bottom: 18px;
}

.results { display: none; }

.result-card {
    background: #f5f8fc;
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 17px;
    margin-bottom: 12px;
    min-height: 90px;
}

.result-card span {
    display: block;
    color: #6c7b8e;
    font-size: 12px;
    margin-bottom: 8px;
}

.result-card strong {
    color: var(--navy);
    font-size: 21px;
}

.result-highlight {
    background: #eaf7f1;
    border-color: #ccebdd;
}

.result-highlight strong { color: var(--green); }

.total-line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
}

.total-line:last-child { border-bottom: 0; }

.total-line strong { color: var(--navy); }

.footer-note {
    color: #7c8998;
    font-size: 12px;
    line-height: 1.6;
    margin-top: 15px;
}

@media (max-width: 767px) {
    body { padding: 12px 7px; }

    .header {
        padding: 23px 18px;
        border-radius: 9px;
    }

    .header h2 { font-size: 23px; }

    .panel-card {
        padding: 17px 13px;
        border-radius: 9px;
    }

    .section-title { font-size: 17px; }

    .form-group { margin-bottom: 16px; }

    .action-row { display: flex; }

    .action-row button {
        flex: 1 1 100%;
        width: 100%;
    }

    .result-card { min-height: auto; }

    .result-card strong { font-size: 19px; }

    .table { min-width: 590px; }

    .total-line { font-size: 13px; }
}

@media print {
    body { background: white; padding: 0; }
    .header { background: #142b49 !important; }
    .no-print { display: none !important; }
    .panel-card { box-shadow: none; }
}
</style>
</head>

<body>
<div class="container">

    <div class="header">
        <h2>EPC Project Budget Estimator</h2>
        <p>Preliminary cost estimation for renewable energy and infrastructure projects</p>
    </div>

    <!-- PROJECT INPUTS -->
    <div class="panel-card">
        <h3 class="section-title">1. Project Information</h3>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label>Country</label>
                    <select id="country" class="form-control">
                        <option value="">Select country</option>
                    </select>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    <label>Project Type</label>
                    <select id="projectType" class="form-control">
                        <option value="">Select project type</option>
                        <option value="solar">Solar PV</option>
                        <option value="bess">Battery Energy Storage (BESS)</option>
                        <option value="datacenter">Data Center</option>
                    </select>
                </div>
            </div>
        </div>

        <div id="commonFields" class="dynamic-section">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label id="capacityLabel">Project Capacity (MW)</label>
                        <input type="number" id="capacity"
                               class="form-control" min="0.01"
                               step="any" placeholder="Enter capacity">
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Target Profit Margin (%)</label>
                        <input type="number" id="margin"
                               class="form-control" min="0"
                               max="90" step="any"
                               placeholder="Enter margin">
                        <div class="help-text">
                            Margin calculated on the EPC selling price.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SOLAR OPTIONS -->
        <div id="solarFields" class="dynamic-section">
            <h4><strong>Solar PV Configuration</strong></h4>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Mounting System</label>
                        <select id="mounting" class="form-control">
                            <option value="">Select mounting system</option>
                            <option value="fixed">Fixed Tilt</option>
                            <option value="tracker">Single Axis Tracker</option>
                        </select>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>PV Module Technology</label>
                        <select id="moduleType" class="form-control">
                            <option value="">Select module technology</option>
                            <option value="topcon">TOPCon</option>
                            <option value="hjt">HJT</option>
                            <option value="perc">PERC</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- BESS OPTIONS -->
        <div id="bessFields" class="dynamic-section">
            <h4><strong>BESS Configuration</strong></h4>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Storage Duration</label>
                        <select id="duration" class="form-control">
                            <option value="">Select duration</option>
                            <option value="2">2 Hours</option>
                            <option value="4">4 Hours</option>
                            <option value="6">6 Hours</option>
                            <option value="8">8 Hours</option>
                        </select>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Battery Chemistry</label>
                        <select id="chemistry" class="form-control">
                            <option value="">Select chemistry</option>
                            <option value="lfp">LFP</option>
                            <option value="nmc">NMC</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- DATA CENTER OPTIONS -->
        <div id="dcFields" class="dynamic-section">
            <h4><strong>Data Center Configuration</strong></h4>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Facility Tier</label>
                        <select id="tier" class="form-control">
                            <option value="">Select tier</option>
                            <option value="III">Tier III</option>
                            <option value="IV">Tier IV</option>
                        </select>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Cooling Technology</label>
                        <select id="cooling" class="form-control">
                            <option value="">Select cooling technology</option>
                            <option value="air">Air Cooling</option>
                            <option value="liquid">Liquid Cooling</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MATERIALS -->
    <div class="panel-card">
        <h3 class="section-title">2. Material Price Reference</h3>

        <div class="material-note">
            Select a project type to display its typical materials,
            estimated quantities and indicative unit prices.
            Prices are planning assumptions, not supplier quotations.
        </div>

        <div id="materialPlaceholder">
            <p class="text-muted">Please select a project type above to view materials.</p>
        </div>

        <div id="materialTable" style="display:none;">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Material / Equipment</th>
                            <th>Estimated Quantity</th>
                            <th>Unit</th>
                            <th>Indicative Unit Price (€)</th>
                            <th>Reference Total (€)</th>
                        </tr>
                    </thead>
                    <tbody id="materialRows"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ACTIONS -->
    <div class="panel-card no-print">
        <div class="action-row">
            <button class="btn btn-main" onclick="calculateBudget()">
                <span class="glyphicon glyphicon-stats"></span>
                Calculate EPC Budget
            </button>

            <button class="btn btn-reset" onclick="resetCalculator()">
                Reset
            </button>

            <button class="btn btn-reset" onclick="window.print()">
                Print / Save PDF
            </button>
        </div>
        <p id="errorMessage" class="text-danger" style="margin-top:12px;"></p>
    </div>

    <!-- RESULTS -->
    <div id="results" class="results">

        <div class="panel-card">
            <h3 class="section-title">3. EPC Budget Summary</h3>

            <div class="row">
                <div class="col-sm-6 col-md-3">
                    <div class="result-card">
                        <span>Total EPC Cost</span>
                        <strong id="totalCost">€0</strong>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <div class="result-card">
                        <span>Profit Margin</span>
                        <strong id="marginResult">0%</strong>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <div class="result-card">
                        <span>Estimated Profit</span>
                        <strong id="profit">€0</strong>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <div class="result-card result-highlight">
                        <span>EPC Selling Price</span>
                        <strong id="sellingPrice">€0</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-card">
            <h3 class="section-title">4. EPC Cost Breakdown</h3>

            <div class="total-line">
                <span>Civil Works</span>
                <strong id="civilCost">€0</strong>
            </div>

            <div class="total-line">
                <span>Mechanical Works</span>
                <strong id="mechanicalCost">€0</strong>
            </div>

            <div class="total-line">
                <span>Electrical Works</span>
                <strong id="electricalCost">€0</strong>
            </div>

            <div class="total-line">
                <span>Additional EPC Costs</span>
                <strong id="extraCost">€0</strong>
            </div>

            <div class="total-line">
                <span>Estimated EPC Cost per MW</span>
                <strong id="costPerMW">€0</strong>
            </div>

            <div class="footer-note">
                This is a preliminary budget estimate. Final costs should be
                validated against project specifications, BOQs, supplier
                quotations, site conditions, grid connection requirements
                and contractor scope.
            </div>
        </div>
    </div>

</div>

<script>
// ------------------------------------
// COUNTRY LIST AND COST FACTORS
// ------------------------------------

const countryFactors = {
    IE:1.12, DE:1.08, FR:1.05, NL:1.07, BE:1.06,
    ES:0.94, PT:0.91, IT:1.00, GR:0.88, GB:1.13,
    US:1.18, CA:1.15, AU:1.16, JP:1.20, KR:1.10,
    IN:0.65, CN:0.72, BR:0.83, ZA:0.78, SA:0.96,
    AE:1.04, PL:0.84, RO:0.76, BG:0.72, TR:0.68,
    SE:1.12, NO:1.25, DK:1.14, FI:1.08
};

const countrySelect = document.getElementById("country");
const countryNames = new Intl.DisplayNames(["en"], {type:"region"});

Object.keys(countryNames.resolvedOptions()).forEach(() => {});

const regions = [
"IE","GB","DE","FR","NL","BE","ES","PT","IT","GR",
"US","CA","AU","JP","KR","IN","CN","BR","ZA","SA",
"AE","PL","RO","BG","TR","SE","NO","DK","FI","CH",
"AT","CZ","HU","HR","SI","SK","LU","EE","LV","LT",
"CY","MT","IS","NZ","MX","AR","CL","CO","EG","MA"
];

regions.sort((a,b) => countryNames.of(a).localeCompare(countryNames.of(b)));

regions.forEach(code => {
    const option = document.createElement("option");
    option.value = code;
    option.textContent = countryNames.of(code);
    countrySelect.appendChild(option);
});

// ------------------------------------
// PROJECT RATE ASSUMPTIONS PER MW
// ------------------------------------

const projectRates = {
    solar: {
        civil:110000,
        mechanical:90000,
        electrical:160000,
        extra:0
    },
    bess: {
        civil:70000,
        mechanical:120000,
        electrical:180000,
        extra:180000
    },
    datacenter: {
        civil:1200000,
        mechanical:2400000,
        electrical:3800000,
        extra:0
    }
};

// ------------------------------------
// MATERIAL PRICE REFERENCE
// Indicative prices only - EUR
// ------------------------------------

const materials = {
    solar: [
        {name:"PV Modules", qty:1820, unit:"pcs / MW", price:75},
        {name:"String Inverter", qty:1, unit:"unit / MW", price:18000},
        {name:"Mounting Structure", qty:1820, unit:"sets / MW", price:32},
        {name:"DC Cable", qty:3000, unit:"m / MW", price:1.40},
        {name:"AC Cable", qty:600, unit:"m / MW", price:8.50},
        {name:"DC Connectors", qty:3640, unit:"pcs / MW", price:2.50},
        {name:"MV Transformer", qty:0.2, unit:"unit / MW", price:65000},
        {name:"MV Switchgear", qty:0.2, unit:"unit / MW", price:28000},
        {name:"Monitoring System", qty:1, unit:"system / MW", price:2500},
        {name:"Access Roads", qty:350, unit:"m / MW", price:45},
        {name:"Fencing", qty:180, unit:"m / MW", price:22}
    ],

    bess: [
        {name:"Battery Container (5 MWh)", qty:1, unit:"container / 5 MWh", price:450000},
        {name:"Power Conversion System", qty:1, unit:"unit / MW", price:95000},
        {name:"MV Transformer", qty:0.2, unit:"unit / MW", price:65000},
        {name:"MV Switchgear", qty:0.2, unit:"unit / MW", price:28000},
        {name:"Battery Management System", qty:1, unit:"system / project", price:18000},
        {name:"Energy Management System", qty:1, unit:"system / project", price:35000},
        {name:"Fire Suppression System", qty:1, unit:"system / container", price:18000},
        {name:"HVAC System", qty:1, unit:"system / container", price:14000},
        {name:"DC Cables", qty:150, unit:"m / MWh", price:8},
        {name:"Foundations", qty:12, unit:"m³ / MWh", price:180}
    ],

    datacenter: [
        {name:"Server Racks", qty:80, unit:"units / MW", price:4500},
        {name:"UPS System", qty:1, unit:"system / MW", price:180000},
        {name:"Diesel Generator (2 MW)", qty:0.5, unit:"unit / MW", price:350000},
        {name:"MV Transformer", qty:0.2, unit:"unit / MW", price:85000},
        {name:"MV Switchgear", qty:0.5, unit:"unit / MW", price:45000},
        {name:"LV Switchboards", qty:4, unit:"units / MW", price:22000},
        {name:"Cooling System", qty:1.2, unit:"MW cooling / MW IT", price:95000},
        {name:"CRAH / CRAC Units", qty:12, unit:"units / MW", price:14000},
        {name:"Fire Protection System", qty:2, unit:"systems / MW", price:18000},
        {name:"Power Cables", qty:1800, unit:"m / MW", price:12},
        {name:"Fibre Optic Cables", qty:2500, unit:"m / MW", price:2.50},
        {name:"Concrete", qty:350, unit:"m³ / MW", price:180}
    ]
};

const money = value => new Intl.NumberFormat("en-IE", {
    style:"currency",
    currency:"EUR",
    maximumFractionDigits:0
}).format(value);

// ------------------------------------
// SHOW RELEVANT FIELDS
// ------------------------------------

document.getElementById("projectType").addEventListener("change", function() {
    const type = this.value;

    document.getElementById("commonFields").style.display =
        type ? "block" : "none";

    document.getElementById("solarFields").style.display =
        type === "solar" ? "block" : "none";

    document.getElementById("bessFields").style.display =
        type === "bess" ? "block" : "none";

    document.getElementById("dcFields").style.display =
        type === "datacenter" ? "block" : "none";

    document.getElementById("capacityLabel").textContent =
        type === "datacenter" ? "IT Capacity (MW)" : "Project Capacity (MW)";

    document.getElementById("results").style.display = "none";

    showMaterials(type);
});

// ------------------------------------
// MATERIAL TABLE
// ------------------------------------

function showMaterials(type) {
    const placeholder = document.getElementById("materialPlaceholder");
    const table = document.getElementById("materialTable");
    const rows = document.getElementById("materialRows");

    rows.innerHTML = "";

    if (!type) {
        placeholder.style.display = "block";
        table.style.display = "none";
        return;
    }

    placeholder.style.display = "none";
    table.style.display = "block";

    materials[type].forEach(item => {
        const row = document.createElement("tr");

        row.innerHTML = `
            <td>${item.name}</td>
            <td>${item.qty.toLocaleString("en-IE")}</td>
            <td>${item.unit}</td>
            <td>${money(item.price)}</td>
            <td>${money(item.qty * item.price)}</td>
        `;

        rows.appendChild(row);
    });
}

// ------------------------------------
// CALCULATE EPC BUDGET
// ------------------------------------

function calculateBudget() {
    const country = document.getElementById("country").value;
    const type = document.getElementById("projectType").value;
    const capacity = Number(document.getElementById("capacity").value);
    const margin = Number(document.getElementById("margin").value);

    const error = document.getElementById("errorMessage");
    error.textContent = "";

    if (!country || !type || !capacity || capacity <= 0 ||
        document.getElementById("margin").value === "" ||
        margin < 0 || margin >= 90) {
        error.textContent =
            "Please complete all required fields. Capacity must be positive and margin must be below 90%.";
        return;
    }

    // Project-specific selections
    if (type === "solar" &&
        (!document.getElementById("mounting").value ||
         !document.getElementById("moduleType").value)) {
        error.textContent = "Please select the solar mounting system and PV module technology.";
        return;
    }

    if (type === "bess" &&
        (!document.getElementById("duration").value ||
         !document.getElementById("chemistry").value)) {
        error.textContent = "Please select BESS duration and battery chemistry.";
        return;
    }

    if (type === "datacenter" &&
        (!document.getElementById("tier").value ||
         !document.getElementById("cooling").value)) {
        error.textContent = "Please select the Data Center tier and cooling technology.";
        return;
    }

    const rates = projectRates[type];
    const countryFactor = countryFactors[country] || 1;

    // These are preliminary EPC rates.
    // Configuration choices are recorded but do not yet alter the rates.
    const civil = capacity * rates.civil * countryFactor;
    const mechanical = capacity * rates.mechanical * countryFactor;
    const electrical = capacity * rates.electrical * countryFactor;
    const extra = capacity * rates.extra * countryFactor;

    const totalCost = civil + mechanical + electrical + extra;

    const sellingPrice = totalCost / (1 - margin / 100);
    const profit = sellingPrice - totalCost;

    document.getElementById("civilCost").textContent = money(civil);
    document.getElementById("mechanicalCost").textContent = money(mechanical);
    document.getElementById("electricalCost").textContent = money(electrical);
    document.getElementById("extraCost").textContent = money(extra);

    document.getElementById("totalCost").textContent = money(totalCost);
    document.getElementById("marginResult").textContent = margin.toFixed(2) + "%";
    document.getElementById("profit").textContent = money(profit);
    document.getElementById("sellingPrice").textContent = money(sellingPrice);
    document.getElementById("costPerMW").textContent = money(totalCost / capacity);

    document.getElementById("results").style.display = "block";

    document.getElementById("results").scrollIntoView({
        behavior:"smooth",
        block:"start"
    });
}

// ------------------------------------
// RESET
// ------------------------------------

function resetCalculator() {
    document.getElementById("country").value = "";
    document.getElementById("projectType").value = "";
    document.getElementById("capacity").value = "";
    document.getElementById("margin").value = "";

    [
        "mounting","moduleType","duration","chemistry","tier","cooling"
    ].forEach(id => document.getElementById(id).value = "");

    ["commonFields","solarFields","bessFields","dcFields"].forEach(id => {
        document.getElementById(id).style.display = "none";
    });

    document.getElementById("results").style.display = "none";
    document.getElementById("errorMessage").textContent = "";

    showMaterials("");
}
</script>
</body>
</html>
