<body>
<section class="welcome"><div class="language"><span class="language-icon" aria-hidden="true">🌐</span><select id="language" aria-label="Language"><option value="en">English</option><option value="el">Ελληνικά</option><option value="de">Deutsch</option><option value="fr">Français</option><option value="ar">العربية</option></select></div><h1 data-i18n="title">Budget Estimate Calculator</h1><p data-i18n="subtitle">Preliminary EPC Project Cost Estimation Tool</p></section>
<div class="main-container">
<form id="budgetForm" novalidate>
<div class="panel-custom">
<h3 data-i18n="projectInfo">Project Information</h3>
<div class="row">
<div class="col-md-6"><div class="form-group"><label for="country" data-i18n="country">Country / Market</label><select id="country" class="form-control" required><option value="" data-i18n="selectCountry">Select Country</option></select></div></div>
<div class="col-md-6"><div class="form-group"><label for="projectType" data-i18n="projectType">Project Type</label><select id="projectType" class="form-control" required><option value="" data-i18n="selectProject">Select Project</option><option value="solar" data-i18n="solarPV">Solar PV</option><option value="bess" data-i18n="bess">BESS</option><option value="datacenter" data-i18n="dataCenter">Data Center</option></select></div></div>
<div class="col-md-6"><div class="form-group"><label id="capacityLabel" for="capacity">Project Capacity (MW)</label><input id="capacity" class="form-control" type="number" min="0.01" step="any" data-placeholder="enterCapacity" placeholder="" required></div></div>
<div class="col-md-6" id="solarTechnologyGroup" style="display:none"><div class="form-group"><label for="solarTechnology" data-i18n="technology">PV Module Technology</label><select id="solarTechnology" class="form-control"><option value="" data-i18n="selectTechnology">Select Technology</option><option value="topcon_mono" data-i18n="monoTopcon">N-type TOPCon Monofacial</option><option value="topcon_bifacial" data-i18n="bifacialTopcon">N-type TOPCon Bifacial</option></select></div></div>
<div class="col-md-6" id="modulePowerGroup" style="display:none"><div class="form-group"><label for="modulePower" data-i18n="modulePower">PV Module Power (Wp)</label><select id="modulePower" class="form-control"><option value="" data-i18n="selectModulePower">Select Module Power</option><option>450</option><option>500</option><option>550</option><option>575</option><option>600</option><option>610</option><option>620</option><option>630</option><option>640</option><option>650</option><option>700</option></select></div></div>
<div class="col-md-6" id="mountingGroup" style="display:none"><div class="form-group"><label for="mountingType" data-i18n="mounting">Mounting System</label><select id="mountingType" class="form-control"><option value="" data-i18n="selectMounting">Select Mounting System</option><option value="fixed" data-i18n="fixedTilt">Fixed Tilt</option><option value="tracker" data-i18n="singleAxis">Single Axis Tracker</option></select></div></div>
<div class="col-md-6" id="invertersGroup" style="display:none"><div class="form-group"><label for="inverters" data-i18n="inverters">Number of Inverters</label><input id="inverters" class="form-control" type="number" min="1" step="1" data-placeholder="enterInverters" placeholder=""></div></div>
<div class="col-md-6" id="substationsGroup" style="display:none"><div class="form-group"><label for="substations" data-i18n="substations">Number of MV Substations</label><input id="substations" class="form-control" type="number" min="1" step="1" data-placeholder="enterSubstations" placeholder=""></div></div>
<div class="col-md-6" id="modulesStringGroup" style="display:none"><div class="form-group"><label for="modulesPerString" data-i18n="modulesString">Modules per String</label><input id="modulesPerString" class="form-control" type="number" min="1" step="1" data-placeholder="enterModulesString" placeholder=""></div></div>
<div class="col-md-12" id="solarOptionalGroup" style="display:none">
<details class="optional-details" id="solarOptionalDetails">
<summary><span class="optional-title"><span data-i18n="optionalProjectDetails">Optional Project Details</span><small data-i18n="optionalSubtitle">Fine-tune routes and quantities when project information is available</small></span></summary>

<div class="optional-fields"><div class="row">
<div class="col-md-6" id="mvCableGroup"><div class="form-group"><label for="mvCableLength" data-i18n="mvCable">MV Cable Route Length (m) – optional</label><input id="mvCableLength" class="form-control" type="number" min="0" step="any" data-placeholder="enterMv" placeholder=""></div></div>
<div class="col-md-6" id="dcCableGroup"><div class="form-group"><label for="dcCableLength" data-i18n="dcCable">DC Cable Length (m) – optional</label><input id="dcCableLength" class="form-control" type="number" min="0" step="any" data-placeholder="optionalDc" placeholder=""></div></div>
<div class="col-md-6" id="acCableGroup"><div class="form-group"><label for="acCableLength" data-i18n="acCable">AC LV Cable Length (m) – optional</label><input id="acCableLength" class="form-control" type="number" min="0" step="any" data-placeholder="optionalAc" placeholder=""></div></div>
<div class="col-md-6" id="hvCableGroup"><div class="form-group"><label for="hvCableLength" data-i18n="hvCable">HV / Export Cable Length (m) – optional</label><input id="hvCableLength" class="form-control" type="number" min="0" step="any" data-placeholder="optionalHv" placeholder=""></div></div>
<div class="col-md-6" id="fibreCableGroup"><div class="form-group"><label for="fibreCableLength" data-i18n="fibreCable">Fibre Optic / Communication Cable Length (m) – optional</label><input id="fibreCableLength" class="form-control" type="number" min="0" step="any" data-placeholder="optionalFibre" placeholder=""></div></div>
<div class="col-md-6" id="roadLengthGroup"><div class="form-group"><label for="roadLength" data-i18n="roadLength">Access Road Length (m) – optional</label><input id="roadLength" class="form-control" type="number" min="0" step="any" data-placeholder="optionalRoad" placeholder=""></div></div>
</div></div></details></div>
<div class="col-md-6" id="durationGroup" style="display:none"><div class="form-group"><label for="duration" data-i18n="duration">BESS Duration (Hours)</label><input id="duration" class="form-control" type="number" min="0.5" step="any" data-placeholder="enterDuration" placeholder=""></div></div>
<div class="col-md-6" id="chemistryGroup" style="display:none"><div class="form-group"><label for="batteryChemistry" data-i18n="chemistry">Battery Chemistry</label><select id="batteryChemistry" class="form-control"><option value="" data-i18n="selectChemistry">Select Chemistry</option><option value="LFP">LFP</option><option value="NMC">NMC</option></select><p class="note" data-i18n="bessTechNote">LFP is the baseline; NMC applies an indicative 8% battery premium.</p></div></div>
<div class="col-md-12" id="bessOptionalGroup" style="display:none"><details class="optional-details" id="bessOptionalDetails"><summary><span class="optional-title"><span data-i18n="bessDesignDetails">BESS Design Details</span><small data-i18n="bessOptionalSubtitle">Battery configuration, PCS sizing and site routes</small></span></summary><div class="optional-intro" data-i18n="bessDesignNote">Refine the preliminary equipment quantities. Default block sizes are used when left unchanged.</div><div class="optional-fields"><div class="row">
<div class="col-md-6"><div class="form-group"><label for="batteryBlockSize" data-i18n="batteryBlock">Battery Container Block (MWh)</label><select id="batteryBlockSize" class="form-control"><option value="2.5">2.5 MWh</option><option value="5" selected>5 MWh</option><option value="6">6 MWh</option></select></div></div>
<div class="col-md-6"><div class="form-group"><label for="pcsBlockSize" data-i18n="pcsBlock">PCS Block Size (MW)</label><select id="pcsBlockSize" class="form-control"><option value="1">1 MW</option><option value="2.5" selected>2.5 MW</option><option value="5">5 MW</option></select></div></div>
<div class="col-md-6"><div class="form-group"><label for="bessCableLength" data-i18n="bessCable">MV / HV Cable Route (m) – optional</label><input id="bessCableLength" class="form-control" type="number" min="0" step="any" data-placeholder="optionalBessCable" placeholder=""></div></div>
<div class="col-md-6"><div class="form-group"><label for="bessRoadLength" data-i18n="bessRoad">Access Road Length (m) – optional</label><input id="bessRoadLength" class="form-control" type="number" min="0" step="any" data-placeholder="optionalRoad" placeholder=""></div></div>
</div></div></details></div>
<div class="col-md-6" id="tierGroup" style="display:none"><div class="form-group"><label for="dataCenterTier" data-i18n="tier">Data Center Tier</label><select id="dataCenterTier" class="form-control"><option value="" data-i18n="selectTier">Select Tier</option><option value="Tier II" data-i18n="tierII">Tier II</option><option value="Tier III" data-i18n="tierIII">Tier III</option><option value="Tier IV" data-i18n="tierIV">Tier IV</option></select></div></div>
<div class="col-md-6" id="coolingGroup" style="display:none"><div class="form-group"><label for="coolingType" data-i18n="cooling">Cooling System</label><select id="coolingType" class="form-control"><option value="" data-i18n="selectCooling">Select Cooling</option><option value="Air Cooling" data-i18n="airCooling">Air Cooling</option><option value="Liquid Cooling" data-i18n="liquidCooling">Liquid Cooling</option></select><p class="note" data-i18n="dcTechNote">Liquid cooling applies an indicative 15% premium to cooling equipment.</p></div></div>
<div class="col-md-12" id="dcOptionalGroup" style="display:none"><details class="optional-details" id="dcOptionalDetails"><summary><span class="optional-title"><span data-i18n="dcDesignDetails">Data Center Design Details</span><small data-i18n="dcOptionalSubtitle">Cooling, resilience, generator sizing and cable routes</small></span></summary><div class="optional-intro" data-i18n="dcDesignNote">Adjust redundancy and equipment block assumptions. Cable quantities are estimated automatically unless a route length is entered.</div><div class="optional-fields"><div class="row">
<div class="col-md-6"><div class="form-group"><label for="pue" data-i18n="pue">Target PUE</label><select id="pue" class="form-control"><option value="1.25">1.25</option><option value="1.3">1.30</option><option value="1.4" selected>1.40</option><option value="1.5">1.50</option><option value="1.6">1.60</option></select></div></div>
<div class="col-md-6"><div class="form-group"><label for="upsRedundancy" data-i18n="upsRedundancy">UPS Redundancy</label><select id="upsRedundancy" class="form-control"><option value="1">N</option><option value="1.1" selected>N+1</option><option value="2">2N</option></select></div></div>
<div class="col-md-6"><div class="form-group"><label for="generatorBlock" data-i18n="generatorBlock">Generator Unit Size (MW)</label><select id="generatorBlock" class="form-control"><option value="1">1 MW</option><option value="2" selected>2 MW</option><option value="2.5">2.5 MW</option><option value="3">3 MW</option></select></div></div>
<div class="col-md-6"><div class="form-group"><label for="dcCableRoute" data-i18n="dcCableRoute">Power Cable Route (m) – optional</label><input id="dcCableRoute" class="form-control" type="number" min="0" step="any" data-placeholder="optionalDcPower" placeholder=""></div></div>
<div class="col-md-6"><div class="form-group"><label for="dcFibreRoute" data-i18n="dcFibreRoute">Fibre / Data Cable Route (m) – optional</label><input id="dcFibreRoute" class="form-control" type="number" min="0" step="any" data-placeholder="optionalFibre" placeholder=""></div></div>
</div></div></details></div>
</div>
<div id="solarDerived" class="derived" style="display:none"></div>
<button class="btn btn-calculate" type="submit" data-i18n="calculate">Calculate Budget</button><button class="btn btn-calculate btn-secondary" type="button" id="resetBtn" data-i18n="reset">Reset</button>
<p class="note" data-i18n="inputNote">Budget updates automatically when you change a project input. Press Enter in any field to calculate manually.</p><p id="validationMessage" class="status-line" role="status"></p>
</div>
</form>
<div id="results" class="hidden-results">
