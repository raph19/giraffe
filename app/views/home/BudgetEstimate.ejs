function localName(name){const lang=$('language').value;return (generatedNames[lang]&&generatedNames[lang][name])||name;}

function activeLocale(){return ({en:'en-IE',el:'el-GR',de:'de-DE',fr:'fr-FR',ar:'ar-EG'})[$('language').value]||'en-IE'}function fmt(n){return new Intl.NumberFormat(activeLocale(),{maximumFractionDigits:2}).format(n)}function money(n){return new Intl.NumberFormat(activeLocale(),{style:'currency',currency:'EUR',maximumFractionDigits:0}).format(n)}
function getMaterials(type,cap,duration,o,market){
 let m=[];
 const equipment=market.equipment,local=market.civil,blend=.65*equipment+.35*market.labour;
 if(type==='solar'){
  const count=Math.ceil(cap*1e6/o.modulePower),strings=Math.ceil(count/o.modulesPerString);
  const modRate=moduleOptions[o.tech].price*o.modulePower;
  const mountingRate=o.modulePower*mountingPricePerWp[o.mounting];
  m=[['PV Modules',count,'pcs',modRate*equipment],['PV Strings',strings,'strings',0],['String Inverters',o.inverters,'units',inverterPricePer250kW*equipment],['Mounting Structure',count,'sets',mountingRate*(.55*equipment+.45*market.labour)],['DC Cables',o.dcLength,'m',1.25*blend],['AC LV Cables',o.acLength,'m',7.5*blend],['MV Cable',o.mvLength,'m',22*blend],['HV / Export Cable',o.hvLength,'m',38*blend],['Fibre Optic / Communication Cable',o.fibreLength,'m',1.8*equipment],['Access Roads',o.roadLength,'m',95*local],['MV Substations',o.substations,'units',95000*equipment],['MV Switchgear',o.substations,'sets',28000*equipment],['DC Connectors',count*2,'pcs',2.1*equipment],['SCADA / Design / Installation / Commissioning',cap,'MWp',(rates.solar.scadaFullScopeAtAnchor/rates.solar.anchorMWp)*(.70*market.labour+.30*market.equipment)]];
 }else if(type==='bess'){
  const energy=cap*duration,containers=Math.ceil(energy/o.batteryBlockSize),pcs=Math.ceil(cap/o.pcsBlockSize),transformers=Math.ceil(cap/5);
  m=[['Battery System / Containers',energy,'MWh',rates.bess.batteryPackPerMWh*market.bessTotal*technologyFactors.bess[o.chemistry]],['Power Conversion System (PCS)',pcs,'units',rates.bess.pcsExtraPerMW*o.pcsBlockSize*equipment],['MV Transformer & Switchgear',transformers,'sets',95000*equipment],['EMS / BMS',1,'system',45000*equipment],['Fire Suppression & HVAC',containers,'sets',26000*blend],['Civil Foundations',energy,'MWh',6500*local],['MV / HV Cabling',o.bessCableLength,'m',22*blend],['Access Roads',o.bessRoadLength,'m',95*local]];
 }else{
  const upsFactor=o.upsRedundancy,genCount=Math.ceil(cap/o.generatorBlockSize),transformers=Math.ceil(cap/5),coolingLoad=cap*1.2*(o.pue/1.4);
  m=[['Server Racks',cap*80,'units',4500*equipment],['UPS Systems',cap*upsFactor,'MW',180000*equipment],['Generators',genCount,'units',o.generatorBlockSize*350000/2*equipment],['MV Transformers',transformers,'units',85000*equipment],['Cooling Systems',coolingLoad,'MWth',95000*blend],['Power Cables',o.dcPowerLength,'m',12*blend],['Fibre Optic / Data Cables',o.dcFibreLength,'m',1.8*equipment],['Fire Suppression',cap,'systems',18000*blend]];
 }
 return m.filter(x=>x[1]>0&&x[3]>0);
}

const readLength=(id,assumption)=>{const raw=$(id).value;return raw.trim()===''?assumption:Math.max(0,Number(raw)||0)};

function calculateBudget(scroll=false){
 const country=$('country').value,type=$('projectType').value,cap=Number($('capacity').value);
 let err='';
 if(!country||!type||!Number.isFinite(cap)||cap<=0)err=tr('validation');
 if(type==='solar'){
  const required=['solarTechnology','modulePower','mountingType','inverters','substations','modulesPerString'];
  if(required.some(id=>!$(id)||!$(id).value))err=tr('solarValidation');
 }
 if(type==='bess'&&(!$('duration').value||!$('batteryChemistry').value))err=tr('bessValidation');
 if(type==='datacenter'&&(!$('dataCenterTier').value||!$('coolingType').value))err=tr('dcValidation');
 if(err){$('validationMessage').textContent=err;$('results').style.display='none';lastCalculation=null;return false;}
 $('validationMessage').textContent='';
 const market=marketFactors(country),costs=[];
 // Route deltas: additional metres use the full installed unit rate +15%; reduced quantities receive a 55% credit only, retaining fixed design, mobilisation, terminations and site overhead. This is a transparent budgetary commercial assumption, not a supplier quotation.
 const routeCost=(actual,baseline,unitRate)=>{const delta=actual-baseline;return delta>=0?delta*unitRate*1.15:delta*unitRate*1.15*.55;};
 const addCost=(name,base,factor)=>costs.push([name,Math.max(0,base),factor]);
 if(type==='solar'){
  const o={tech:$('solarTechnology').value,modulePower:Number($('modulePower').value),mounting:$('mountingType').value,inverters:Number($('inverters').value),substations:Number($('substations').value),modulesPerString:Number($('modulesPerString').value)};
  o.dcLength=readLength('dcCableLength',cap*assumptions.solar.dc);o.acLength=readLength('acCableLength',cap*assumptions.solar.ac);o.mvLength=readLength('mvCableLength',cap*assumptions.solar.mv);o.hvLength=readLength('hvCableLength',cap*assumptions.solar.hv);o.fibreLength=readLength('fibreCableLength',cap*assumptions.solar.fibre);o.roadLength=readLength('roadLength',cap*assumptions.solar.road);
  const scadaBase=cap*(rates.solar.scadaFullScopeAtAnchor/rates.solar.anchorMWp);
  const anchorPre=(cap*(rates.solar.anchorEpc/rates.solar.anchorMWp)-scadaBase)/(1+rates.solar.engineering+rates.solar.contingency);
  const civilBase=cap*rates.solar.civil;
  const mechanicalBase=cap*rates.solar.mechanical+(o.mounting==='tracker'?cap*1e6*(mountingPricePerWp.tracker-mountingPricePerWp.fixed):0);
  const electricalBase=anchorPre-cap*(rates.solar.civil+rates.solar.mechanical);
  const baseInverters=Math.ceil(cap*4),baseSubstations=Math.ceil(cap/5);
  const moduleDelta=(moduleOptions[o.tech].price-moduleOptions.topcon_bifacial.price)*cap*1e6;
  const inverterDelta=(o.inverters-baseInverters)*inverterPricePer250kW;
  const substationDelta=(o.substations-baseSubstations)*(95000+28000);
  const cableDelta=routeCost(o.dcLength,cap*assumptions.solar.dc,routeRates.dc)+routeCost(o.acLength,cap*assumptions.solar.ac,routeRates.ac)+routeCost(o.mvLength,cap*assumptions.solar.mv,routeRates.mv)+routeCost(o.hvLength,cap*assumptions.solar.hv,routeRates.hv)+routeCost(o.fibreLength,cap*assumptions.solar.fibre,routeRates.fibre);
  const roadDelta=routeCost(o.roadLength,cap*assumptions.solar.road,routeRates.road);
  const mechanicalFactor=.55*market.labour+.45*market.equipment;
  const electricalFactor=.25*market.labour+.75*market.equipment;
  const civil=civilBase+roadDelta;
  const mechanical=mechanicalBase;
  const electrical=Math.max(0,electricalBase+moduleDelta+inverterDelta+substationDelta+cableDelta);
  const pre=civil+mechanical+electrical;
  addCost('Civil Works & Infrastructure',civil,market.civil);
  addCost('Mechanical Works & Mounting',mechanical,mechanicalFactor);
  addCost('Electrical Works & Grid Equipment',electrical,electricalFactor);
  addCost('SCADA, Design, Installation & Commissioning',scadaBase,.70*market.labour+.30*market.equipment);
  addCost('Engineering, PM & Commissioning',pre*rates.solar.engineering,.70*market.labour+.30*market.equipment);
  addCost('Contingency / Unforeseen Costs',pre*rates.solar.contingency,1);
  o.inverters=o.inverters;o.substations=o.substations;
 }else if(type==='bess'){
  const o={duration:Number($('duration').value),chemistry:$('batteryChemistry').value,batteryBlockSize:Number($('batteryBlockSize').value),pcsBlockSize:Number($('pcsBlockSize').value)};
  o.bessCableLength=readLength('bessCableLength',cap*assumptions.bess.cable);o.bessRoadLength=readLength('bessRoadLength',cap*assumptions.bess.road);
  const energy=cap*o.duration;
  // Modo 2026: 2h = $325k/MWh; 4h = $201k/MWh.
  // Solving C($/kWh)=pack + BOS($/kW)/duration gives $77/kWh + $496/kW.
  // Convert with ECB EUR1=USD1.1172 (30-Oct-2026). Engineering and contingency are carved
  // out of the benchmark total once; they are not stacked on top of the benchmark.
  const packBase=energy*(BESS_USD_PER_KWH*1000/FX_USD_PER_EUR)*technologyFactors.bess[o.chemistry];
  const bosPowerBase=cap*(BESS_USD_PER_KW*1000/FX_USD_PER_EUR);
  const installedPcsCapacity=Math.ceil(cap/o.pcsBlockSize)*o.pcsBlockSize;
  const pcsRounding=(installedPcsCapacity-cap)*rates.bess.pcsExtraPerMW;
  const actualContainers=Math.ceil(energy/o.batteryBlockSize),baselineContainers=Math.ceil(energy/5);
  const containerDelta=(actualContainers-baselineContainers)*rates.bess.containerDeltaPerUnit;
  const cableDelta=routeCost(o.bessCableLength,cap*assumptions.bess.cable,routeRates.bessCable);
  const roadDelta=routeCost(o.bessRoadLength,cap*assumptions.bess.road,routeRates.bessRoad);
  const bosRaw=Math.max(0,bosPowerBase+pcsRounding+containerDelta+cableDelta+roadDelta);
  const eng=rates.bess.engineering,cont=rates.bess.contingency,preScale=1/(1+eng+cont);
  addCost('Battery System Procurement',packBase*preScale,market.bessTotal);
  addCost('PCS, MV & Electrical Balance of Plant',bosRaw*preScale,market.bessLocal*market.bessTotal);
  addCost('Engineering, Integration & Commissioning',(packBase+bosRaw)*preScale*eng,market.bessEngineering*market.bessTotal);
  addCost('Contingency / Unforeseen Costs',(packBase+bosRaw)*preScale*cont,market.bessTotal);
 }else{
  const o={tier:$('dataCenterTier').value,cooling:$('coolingType').value,pue:Number($('pue').value),upsRedundancy:Number($('upsRedundancy').value),generatorBlockSize:Number($('generatorBlock').value)};
  o.dcPowerLength=readLength('dcCableRoute',cap*assumptions.datacenter.powerCable);o.dcFibreLength=readLength('dcFibreRoute',cap*assumptions.datacenter.fibre);
  // Irish Government/KPMG 2026 hyperscale CAPEX: €11–13m per MW; use midpoint €12m/MW IT.
  // T&T 2026-27 $/W market ratios adjust the national baseline. IT servers and land excluded.
  const totalBenchmark=cap*rates.datacenter.irishTotalPerMWIT;
  const preBenchmark=totalBenchmark/(1+rates.datacenter.engineering+rates.datacenter.contingency);
  const baseCivil=preBenchmark*(1.2/7.4),baseMechanical=preBenchmark*(2.4/7.4),baseElectrical=preBenchmark*(3.8/7.4);
  const coolingRatio=Math.max(.60,Math.min(1.75,(o.pue-1)/(.4)));
  const coolingShare=rates.datacenter.coolingShareOfMechanical;
  let mechanical=baseMechanical*((1-coolingShare)+coolingShare*coolingRatio);
  if(o.cooling==='Liquid Cooling')mechanical+=totalBenchmark*rates.datacenter.liquidCoolingPremium/(1+rates.datacenter.engineering+rates.datacenter.contingency);
  const upsRatio=o.upsRedundancy/1.1;
  let electrical=baseElectrical*(1+rates.datacenter.upsShareOfElectrical*(upsRatio-1));
  const tierPathPremium=o.tier==='Tier IV'?.15:o.tier==='Tier III'?.06:0;
  electrical+=baseElectrical*rates.datacenter.distributionShareOfElectrical*tierPathPremium;
  const baselineGeneratorCapacity=Math.ceil(cap/2)*2;
  const actualGeneratorCapacity=Math.ceil(cap/o.generatorBlockSize)*o.generatorBlockSize;
  const generatorDelta=(actualGeneratorCapacity-baselineGeneratorCapacity)*175000;
  const cableDelta=routeCost(o.dcPowerLength,cap*assumptions.datacenter.powerCable,routeRates.dcPower)+routeCost(o.dcFibreLength,cap*assumptions.datacenter.fibre,routeRates.dcFibre);
  electrical=Math.max(0,electrical+generatorDelta+cableDelta);
  const civil=baseCivil;
  const pre=civil+mechanical+electrical;
  const adjustedPre=civil+mechanical+electrical;
  addCost('Civil Works',civil,market.dataCenter);
  addCost('Mechanical & Cooling',mechanical,market.dataCenter);
  addCost('Electrical & Power Systems',electrical,market.dataCenter);
  addCost('Engineering, Integration & Commissioning',adjustedPre*rates.datacenter.engineering,market.dataCenter);
  addCost('Contingency / Unforeseen Costs',adjustedPre*rates.datacenter.contingency,market.dataCenter);
 }
 const baseTotal=costs.reduce((sum,x)=>sum+x[1],0);
 const adjustedCosts=costs.map(x=>[x[0],x[1],x[2],x[1]*x[2]]);
 const total=adjustedCosts.reduce((sum,x)=>sum+x[3],0);
 const factor=baseTotal>0?total/baseTotal:1;
 const denominator=type==='bess'?cap*Number($('duration').value):cap;
 const unitLabel=type==='bess'?tr('perMWh'):tr('perMW');
 $('costTable').innerHTML=adjustedCosts.map(x=>`<tr><td>${localName(x[0])}</td><td>${money(x[1])}</td><td>${money(x[3])}</td></tr>`).join('');
 $('costTotal').textContent=money(total);$('totalBudget').textContent=money(total);$('costPerMW').textContent=`${tr('estimatedCostPer')} ${unitLabel}: ${money(total/denominator)}`;
 let detail='';
 if(type==='solar'){
  const tech=$('solarTechnology').value,wp=Number($('modulePower').value),mount=$('mountingType').value,mods=Math.ceil(cap*1e6/wp),strings=Math.ceil(mods/Number($('modulesPerString').value));
  detail=`${moduleOptions[tech].name} · €${moduleOptions[tech].price.toFixed(3)}/Wp · ${wp} Wp · ${mount==='tracker'?tr('singleAxis'):tr('fixedTilt')} (€${mountingPricePerWp[mount].toFixed(3)}/Wp) · ${fmt(mods)} ${tr('modules')} · ${fmt(strings)} ${tr('strings')} · ${$('inverters').value} ${tr('invertersUnit')} · ${$('substations').value} ${tr('mvSubstations')}`;
 }else if(type==='bess'){
  const chem=$('batteryChemistry').value,dur=Number($('duration').value),blocks=Number($('pcsBlockSize').value);
  detail=`${chem} · ${fmt(cap*dur)} MWh · ${dur} ${tr('hours')} · ${Math.ceil(cap/blocks)} PCS blocks · ${tr('batteryPriceFactor')}: ${Math.round(technologyFactors.bess[chem]*100)}%`;
 }else{
  const tier=$('dataCenterTier').value,cooling=$('coolingType').value,pue=Number($('pue').value),ups=Number($('upsRedundancy').value);
  detail=`${tier} · ${cooling==='Liquid Cooling'?tr('liquidCooling'):tr('airCooling')} · PUE ${pue} · UPS ${ups===2?'2N':ups===1.1?'N+1':'N'} · ${tr('coolingPriceFactor')}: ${Math.round(technologyFactors.datacenter[cooling]*100)}%`;
 }
 $('projectSummary').textContent=`${type==='solar'?tr('solarPV'):type==='bess'?tr('bess'):tr('dataCenter')} | ${fmt(cap)} ${type==='solar'?'MWp':'MW'} | ${detail}`;
 $('marketSummary').textContent=`${tr('market')}: ${getCountryName(country)}`;
 const materials=getMaterials(type,cap,Number($('duration').value)||0,{tech:$('solarTechnology').value,modulePower:Number($('modulePower').value),mounting:$('mountingType').value,inverters:Number($('inverters').value),substations:Number($('substations').value),modulesPerString:Number($('modulesPerString').value),dcLength:readLength('dcCableLength',cap*assumptions.solar.dc),acLength:readLength('acCableLength',cap*assumptions.solar.ac),mvLength:readLength('mvCableLength',cap*assumptions.solar.mv),hvLength:readLength('hvCableLength',cap*assumptions.solar.hv),fibreLength:readLength('fibreCableLength',cap*assumptions.solar.fibre),roadLength:readLength('roadLength',cap*assumptions.solar.road),chemistry:$('batteryChemistry').value,batteryBlockSize:Number($('batteryBlockSize').value),pcsBlockSize:Number($('pcsBlockSize').value),bessCableLength:readLength('bessCableLength',cap*assumptions.bess.cable),bessRoadLength:readLength('bessRoadLength',cap*assumptions.bess.road),upsRedundancy:Number($('upsRedundancy').value),generatorBlockSize:Number($('generatorBlock').value),pue:Number($('pue').value),dcPowerLength:readLength('dcCableRoute',cap*assumptions.datacenter.powerCable),dcFibreLength:readLength('dcFibreRoute',cap*assumptions.datacenter.fibre)},market);
 $('materialTable').innerHTML=materials.map(x=>{const q=x[1],line=q*x[3];return `<tr><td>${localName(x[0])}</td><td>${fmt(q)}</td><td>${x[2]}</td><td>${money(x[3])}</td><td>${money(line)}</td></tr>`}).join('');
 const materialTotal=materials.reduce((sum,x)=>sum+x[1]*x[3],0);$('materialTotal').textContent=money(materialTotal);
 const routeNote=$('materialAssumptionsDynamic');
 if(routeNote){const fmtRoute=(label,actual,baseline)=>`${label}: ${fmt(actual)} m (default ${fmt(baseline)} m)`;let routeLines=[];if(type==='solar'){routeLines=[fmtRoute('DC',readLength('dcCableLength',cap*assumptions.solar.dc),cap*assumptions.solar.dc),fmtRoute('AC LV',readLength('acCableLength',cap*assumptions.solar.ac),cap*assumptions.solar.ac),fmtRoute('MV',readLength('mvCableLength',cap*assumptions.solar.mv),cap*assumptions.solar.mv),fmtRoute('HV / Export',readLength('hvCableLength',cap*assumptions.solar.hv),cap*assumptions.solar.hv),fmtRoute('Fibre',readLength('fibreCableLength',cap*assumptions.solar.fibre),cap*assumptions.solar.fibre),fmtRoute('Roads',readLength('roadLength',cap*assumptions.solar.road),cap*assumptions.solar.road)];}else if(type==='bess'){routeLines=[fmtRoute('MV / HV cable',readLength('bessCableLength',cap*assumptions.bess.cable),cap*assumptions.bess.cable),fmtRoute('Roads',readLength('bessRoadLength',cap*assumptions.bess.road),cap*assumptions.bess.road)];}else{routeLines=[fmtRoute('Power cable',readLength('dcCableRoute',cap*assumptions.datacenter.powerCable),cap*assumptions.datacenter.powerCable),fmtRoute('Fibre / Data',readLength('dcFibreRoute',cap*assumptions.datacenter.fibre),cap*assumptions.datacenter.fibre)];}const lang=$('language').value;const noteText={en:'Route quantities used in this estimate — ',el:'Ποσότητες διαδρομών που χρησιμοποιούνται στην εκτίμηση — ',de:'Verwendete Trassenmengen — ',fr:'Quantités de tracé utilisées dans cette estimation — ',ar:'كميات المسارات المستخدمة في هذا التقدير — '};const suffix={en:'. For shorter routes, only 55% of the installed-cost difference is credited; the balance retains design, mobilisation, termination and site overhead (budgetary assumption).',el:'. Για μικρότερες διαδρομές πιστώνεται το 55% της διαφοράς του εγκατεστημένου κόστους· το υπόλοιπο καλύπτει σταθερά έξοδα μελέτης, κινητοποίησης, τερματισμών και εργοταξίου (παραδοχή προϋπολογισμού).',de:'. Bei kürzeren Trassen werden nur 55% der installierten Kostendifferenz gutgeschrieben; der Rest deckt Planung, Mobilisierung, Anschlüsse und Baustellenaufwand (Budgetannahme).',fr:'. Pour les tracés plus courts, seuls 55% de la différence de coût installé sont crédités ; le solde couvre la conception, la mobilisation, les terminaisons et les frais de chantier (hypothèse budgétaire).',ar:'. للمسارات الأقصر يُخصم 55٪ فقط من فرق التكلفة المركبة؛ ويغطي الباقي التصميم والتعبئة والنهايات ومصاريف الموقع (افتراض تقديري).'};routeNote.textContent=(noteText[lang]||noteText.en)+routeLines.join(' | ')+(suffix[lang]||suffix.en);}
 lastCalculation={country,countryName:getCountryName(country),type,capacity:cap,options:{},factor,costs:adjustedCosts.map(x=>[x[0],x[1],x[3]]),total,unitCost:total/denominator,materials,materialTotal,baselineAssumptions:assumptions[type]||{},market,routeNote:routeNote?.textContent||''};
 $('results').style.display='block';if(scroll)$('results').scrollIntoView({behavior:'smooth',block:'start'});return true;
}

function scheduleCalculation(){clearTimeout(autoTimer);autoTimer=setTimeout(()=>{if($('country').value&&$('projectType').value&&$('capacity').value)calculateBudget(false);},220)}
$('budgetForm').addEventListener('submit',e=>{e.preventDefault();calculateBudget(true);});$('budgetForm').addEventListener('keydown',e=>{if(e.key==='Enter'&&(e.target.matches('input,select'))){e.preventDefault();calculateBudget(true);}});$('projectType').addEventListener('change',()=>{updateCapacityLabel();scheduleCalculation()});$('dataCenterTier').addEventListener('change',()=>{const tier=$('dataCenterTier').value;if(tier==='Tier II')$('upsRedundancy').value='1.1';else if(tier==='Tier III')$('upsRedundancy').value='1.1';else if(tier==='Tier IV')$('upsRedundancy').value='2';scheduleCalculation()});$('language').addEventListener('change',()=>{setLanguage();if(lastCalculation)calculateBudget(false);});$('budgetForm').querySelectorAll('input,select').forEach(el=>{el.addEventListener('input',scheduleCalculation);el.addEventListener('change',scheduleCalculation);});
$('resetBtn').addEventListener('click',()=>{$('budgetForm').reset();$('results').style.display='none';$('validationMessage').textContent='';$('solarDerived').style.display='none';lastCalculation=null;updateCapacityLabel();});
$('exportBtn').addEventListener('click',()=>{
 if(!lastCalculation){alert(tr('exportAlert'));return;}
 if(typeof XLSX==='undefined'){alert(tr('excelAlert'));return;}
 const d=lastCalculation,wb=XLSX.utils.book_new();
 const summaryRows=[
  ['EPC BUDGET ESTIMATE'],['Preliminary project cost estimate · VAT excluded'],[],
  ['PROJECT INFORMATION'],['Country / Market',d.countryName],['Project Type',d.type],['Capacity (MW / MWp)',d.capacity],['Estimated EPC Cost (€)',d.total],['Unit Cost (€/MW or €/MWh)',d.unitCost],[],
  ['EPC COST BREAKDOWN'],['Work Category','Base Cost (€)','Estimated Cost (€)'],
  ...d.costs.map(x=>[x[0],x[1],x[2]]),['TOTAL EPC COST','',d.total],[],
  ['ESTIMATING NOTES'],['All prices are VAT excluded.'],['Material reference values are informational and are not added again to the EPC total.'],[d.routeNote||'Route quantities use the defaults shown in the Material BOQ unless a project-specific length was entered.'],['Shorter routes receive partial cost credit only to reflect retained design, mobilisation, termination and installation overhead.']
 ];
 const ws=XLSX.utils.aoa_to_sheet(summaryRows);ws['!cols']=[{wch:43},{wch:22},{wch:24}];ws['!merges']=[{s:{r:0,c:0},e:{r:0,c:2}},{s:{r:1,c:0},e:{r:1,c:2}}];ws['!freeze']={xSplit:0,ySplit:11};
 for(let r=0;r<summaryRows.length;r++){for(let c=0;c<summaryRows[r].length;c++){const cell=ws[XLSX.utils.encode_cell({r,c})];if(cell&&typeof cell.v==='number'&&(c===1||c===2))cell.z='€#,##0.00;[Red](€#,##0.00)';}}
 ws['!autofilter']={ref:`A12:C${12+d.costs.length}`};XLSX.utils.book_append_sheet(wb,ws,'EPC Summary');
 const materialRows=[['MATERIAL & EQUIPMENT REFERENCE'],['Informational BOQ · values are included within the EPC estimate and are not added again'],[],['Material / Equipment','Estimated Quantity','Unit','Indicative Unit Price (€)','Reference Total (€)'],...d.materials.map(x=>[x[0],x[1],x[2],x[3],x[1]*x[3]]),['TOTAL MATERIAL REFERENCE VALUE','','','',d.materialTotal],[],['ROUTE ASSUMPTIONS'],['Default assumptions are scaled by project capacity. Entered route lengths replace the default quantity in the BOQ.'],[d.routeNote||'']];
 const wm=XLSX.utils.aoa_to_sheet(materialRows);wm['!cols']=[{wch:48},{wch:20},{wch:15},{wch:25},{wch:25}];const materialNoteStart=7+d.materials.length;wm['!merges']=[{s:{r:0,c:0},e:{r:0,c:4}},{s:{r:1,c:0},e:{r:1,c:4}},{s:{r:materialNoteStart-1,c:0},e:{r:materialNoteStart-1,c:4}},{s:{r:materialNoteStart,c:0},e:{r:materialNoteStart,c:4}},{s:{r:materialNoteStart+1,c:0},e:{r:materialNoteStart+1,c:4}}];wm['!freeze']={xSplit:0,ySplit:4};wm['!autofilter']={ref:`A4:E${4+d.materials.length}`};
 for(let r=0;r<materialRows.length;r++){for(let c=1;c<5;c++){const cell=wm[XLSX.utils.encode_cell({r,c})];if(cell&&typeof cell.v==='number'&&c>=3)cell.z='€#,##0.00;[Red](€#,##0.00)';}}
 XLSX.utils.book_append_sheet(wb,wm,'Material BOQ');
 wb.Props={Title:'EPC Budget Estimate',Subject:'Preliminary EPC estimate - VAT excluded',Author:'EPC Budget Estimate Calculator',Company:'',Category:'Project Cost Estimate'};
 XLSX.writeFile(wb,`EPC_Budget_${d.country}_${d.type}_${d.capacity}.xlsx`);
});
function updateSolarDerived(){if($('projectType').value==='solar'){const cap=Number($('capacity').value),wp=Number($('modulePower').value),mps=Number($('modulesPerString').value);if(cap>0&&wp>0&&mps>0){const modules=Math.ceil(cap*1e6/wp);$('solarDerived').style.display='block';$('solarDerived').textContent=`${tr('calculatedModules')}: ${fmt(modules)} | ${tr('estimatedStrings')}: ${fmt(Math.ceil(modules/mps))}`;}else $('solarDerived').style.display='none';}}['capacity','modulePower','modulesPerString'].forEach(id=>$(id).addEventListener('input',updateSolarDerived));
setLanguage();updateCapacityLabel();
// Coverage check: the 70 existing country selector codes are all explicitly represented above.
if(countryCodesInModel.length!==70)console.warn('Country model coverage count:',countryCodesInModel.length);
</script>
