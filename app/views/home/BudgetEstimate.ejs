
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Budget Estimate Calculation</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #f3f6fa;
    font-family: Arial, sans-serif;
    color: #263445;
}

.welcome {
    background: linear-gradient(120deg, #102c46, #176b87);
    color: white;
    padding: 35px 25px;
    text-align: center;
}

.welcome h1 {
    font-size: 30px;
    font-weight: bold;
    margin-bottom: 10px;
}

.welcome p {
    color: #d5e6ef;
    font-size: 15px;
}

.main-container {
    max-width: 1150px;
    margin: 35px auto;
    padding: 0 20px;
}

.panel-custom {
    background: white;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 25px;
    box-shadow: 0 3px 15px rgba(0,0,0,.06);
}

.panel-custom h3 {
    margin-top: 0;
    margin-bottom: 25px;
    font-weight: bold;
    color: #174b68;
    border-bottom: 2px solid #edf1f5;
    padding-bottom: 15px;
}

label {
    font-weight: 600;
    margin-bottom: 8px;
}

.form-control {
    height: 43px;
    border-radius: 6px;
    border: 1px solid #d8e0e8;
    box-shadow: none;
}

.form-control:focus {
    border-color: #1683a5;
    box-shadow: 0 0 5px rgba(22,131,165,.2);
}

.btn-calculate {
    background: #087b9b;
    color: white;
    font-weight: bold;
    border: none;
    padding: 13px 35px;
    border-radius: 6px;
    font-size: 15px;
    margin-top: 15px;
}

.btn-calculate:hover {
    background: #075e78;
    color: white;
}

.result-card {
    background: linear-gradient(120deg, #123d58, #087b9b);
    color: white;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 25px;
}

.result-card h4 {
    color: #d6eaf2;
}

.result-card h2 {
    font-size: 34px;
    font-weight: bold;
    margin-bottom: 5px;
}

.table {
    margin-bottom: 0;
}

.table thead {
    background: #edf3f7;
}

.table th, .table td {
    padding: 13px !important;
    vertical-align: middle !important;
}

.total-row {
    font-weight: bold;
    background: #e8f3f7;
}

.hidden-results {
    display: none;
}

.note {
    color: #758493;
    font-size: 12px;
    margin-top: 12px;
}

footer {
    text-align: center;
    padding: 25px;
    color: #84919e;
}

/* Additional mobile responsiveness */

@media (max-width: 767px) {

    .welcome {
        padding: 25px 15px;
    }

    .welcome h1 {
        font-size: 24px;
    }

    .welcome p {
        font-size: 13px;
    }

    .main-container {
        margin: 20px auto;
        padding: 0 12px;
    }

    .panel-custom {
        padding: 17px;
        margin-bottom: 18px;
    }

    .panel-custom h3 {
        font-size: 19px;
        margin-bottom: 20px;
    }

    .form-control {
        font-size: 16px;
    }

    .btn-calculate {
        width: 100%;
        margin-top: 10px;
        padding: 13px 15px;
    }

    .result-card {
        padding: 20px;
    }

    .result-card h2 {
        font-size: 27px;
        overflow-wrap: anywhere;
    }

    .table-responsive {
        border: none;
        margin-bottom: 5px;
    }

    .table {
        font-size: 12px;
        min-width: 650px;
    }

    .table th,
    .table td {
        padding: 10px !important;
    }

    footer {
        font-size: 12px;
    }
}

@media (max-width: 380px) {

    .welcome h1 {
        font-size: 21px;
    }

    .panel-custom {
        padding: 13px;
    }

    .result-card h2 {
        font-size: 23px;
    }
}

@media print {

    .btn-calculate {
        display: none;
    }

    body {
        background: white;
    }

    .panel-custom {
        box-shadow: none;
        border: 1px solid #ddd;
    }
}
</style>
</head>

<body>

<section id="welcome">
    <div class="welcome">
        <h1>Budget Estimate Calculator</h1>
        <p>Preliminary EPC Project Cost Estimation Tool</p>
    </div>
</section>

<div class="main-container">

    <!-- PROJECT INFORMATION -->

    <div class="panel-custom">

        <h3>Project Information</h3>

        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    <label>Country / Market</label>
                    <select id="country" class="form-control">
                        <option value="">Select Country</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Project Type</label>
                    <select id="projectType" class="form-control"
                        onchange="updateProjectOptions()">
                        <option value="">Select Project</option>
                        <option value="solar">Solar PV Project</option>
                        <option value="bess">BESS</option>
                        <option value="datacenter">Data Center</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label id="capacityLabel">Project Capacity (MW)</label>
                    <input type="number" id="capacity"
                        class="form-control" min="0.01" step="any"
                        placeholder="Enter capacity">
                </div>
            </div>

            <!-- SOLAR OPTIONS -->

            <div class="col-md-6" id="solarOptions" style="display:none;">
                <div class="form-group">
                    <label>PV Module Technology</label>
                    <select id="solarTechnology" class="form-control">
                        <option value="">Select Technology</option>
                        <option value="topcon_mono">N-type TOPCon Monofacial</option>
                        <option value="topcon_bifacial">N-type TOPCon Bifacial</option>
                        <option value="perc">PERC Monofacial</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="modulePowerGroup" style="display:none;">
                <div class="form-group">
                    <label>PV Module Power (Wp)</label>
                    <input type="number" id="modulePower"
                        class="form-control" min="1" step="any"
                        placeholder="Enter module power in Wp">
                </div>
            </div>

            <div class="col-md-6" id="mountingGroup" style="display:none;">
                <div class="form-group">
                    <label>Mounting System</label>
                    <select id="mountingType" class="form-control">
                        <option value="">Select Mounting System</option>
                        <option value="fixed">Fixed Tilt</option>
                        <option value="tracker">Single Axis Tracker</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="invertersGroup" style="display:none;">
                <div class="form-group">
                    <label>Number of String Inverters</label>
                    <input type="number" id="inverterCount"
                        class="form-control" min="1" step="1"
                        placeholder="Enter inverter quantity">
                </div>
            </div>

            <div class="col-md-6" id="substationsGroup" style="display:none;">
                <div class="form-group">
                    <label>Number of MV Substations</label>
                    <input type="number" id="substationCount"
                        class="form-control" min="1" step="1"
                        placeholder="Enter MV substation quantity">
                </div>
            </div>

            <div class="col-md-6" id="modulesPerStringGroup" style="display:none;">
                <div class="form-group">
                    <label>Modules per String</label>
                    <input type="number" id="modulesPerString"
                        class="form-control" min="1" step="1"
                        placeholder="Enter modules per string">
                </div>
            </div>

            <!-- BESS OPTIONS -->

            <div class="col-md-6" id="durationGroup" style="display:none;">
                <div class="form-group">
                    <label>BESS Duration (Hours)</label>
                    <input type="number" id="duration"
                        class="form-control" min="1" step="any"
                        placeholder="Enter duration">
                </div>
            </div>

            <div class="col-md-6" id="chemistryGroup" style="display:none;">
                <div class="form-group">
                    <label>Battery Chemistry</label>
                    <select id="batteryChemistry" class="form-control">
                        <option value="">Select Chemistry</option>
                        <option value="LFP">LFP</option>
                        <option value="NMC">NMC</option>
                    </select>
                </div>
            </div>

            <!-- DATA CENTER OPTIONS -->

            <div class="col-md-6" id="tierGroup" style="display:none;">
                <div class="form-group">
                    <label>Data Center Tier</label>
                    <select id="dataCenterTier" class="form-control">
                        <option value="">Select Tier</option>
                        <option value="Tier II">Tier II</option>
                        <option value="Tier III">Tier III</option>
                        <option value="Tier IV">Tier IV</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="coolingGroup" style="display:none;">
                <div class="form-group">
                    <label>Cooling System</label>
                    <select id="coolingType" class="form-control">
                        <option value="">Select Cooling</option>
                        <option value="Air Cooling">Air Cooling</option>
                        <option value="Liquid Cooling">Liquid Cooling</option>
                    </select>
                </div>
            </div>

        </div>

        <button class="btn btn-calculate" onclick="calculateBudget()">
            Calculate Budget
        </button>

        <button class="btn btn-calculate" onclick="resetCalculator()">
            Reset
        </button>

        <p class="note">
            Preliminary estimates based on indicative procurement and EPC
            assumptions. Material reference values are included in the EPC total.
        </p>

        <div id="errorMessage" style="display:none;color:#b52b27;margin-top:12px;"></div>

    </div>


    <!-- RESULTS -->

    <div id="results" class="hidden-results">

        <div class="result-card">
            <h4>Total Estimated EPC Cost</h4>
            <h2 id="totalBudget">€0</h2>
            <p id="projectSummary"></p>
            <p id="marketSummary"></p>
            <h4 id="costPerMW"></h4>
        </div>


        <!-- EPC COST BREAKDOWN -->

        <div class="panel-custom">

            <h3>EPC Cost Breakdown</h3>

            <div class="table-responsive">
                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th>Work Category</th>
                            <th>Estimated Cost (€)</th>
                            <th>Share (%)</th>
                        </tr>
                    </thead>

                    <tbody id="costTable"></tbody>

                    <tfoot>
                        <tr class="total-row">
                            <td>TOTAL EPC COST</td>
                            <td id="costTotal">€0</td>
                            <td>100%</td>
                        </tr>
                    </tfoot>

                </table>
            </div>

            <p class="note">
                Total EPC Cost includes procurement, materials, engineering,
                civil works, electrical installation, project management,
                commissioning and contingency.
            </p>

        </div>


        <!-- MATERIAL REFERENCE -->

        <div class="panel-custom">

            <h3>Material / Equipment Reference</h3>

            <div class="table-responsive">
                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th>Material / Equipment</th>
                            <th>Estimated Quantity</th>
                            <th>Unit</th>
                            <th>Unit Price (€)</th>
                            <th>Reference Total (€)</th>
                        </tr>
                    </thead>

                    <tbody id="materialTable"></tbody>

                    <tfoot>
                        <tr class="total-row">
                            <td colspan="4">TOTAL MATERIAL REFERENCE VALUE</td>
                            <td id="materialTotal">€0</td>
                        </tr>
                    </tfoot>

                </table>
            </div>

            <p class="note">
                Material reference values are included within the EPC cost
                assumptions. They are displayed separately for cost transparency
                and are NOT added again to the EPC total.
            </p>

        </div>


        <div class="panel-custom">
            <h3>Estimation Assumptions</h3>
            <div id="assumptions"></div>
        </div>


        <button class="btn btn-calculate" onclick="exportExcel()">
            Download Excel
        </button>

        <button class="btn btn-calculate" onclick="window.print()">
            Print / Save as PDF
        </button>

    </div>

</div>

<footer>
    Budget Estimate Calculator | Preliminary EPC Estimation
</footer>


<script>

// =====================================
// 1. COUNTRIES
// =====================================

const countryCodes = `
AD AE AF AG AL AM AO AR AT AU AZ
BA BB BD BE BG BH BR BY CA CH CL CN
CO CR CY CZ DE DK DO DZ EC EE ES
FI FR GB GE GH GR HK HR HU ID IE IL
IN IS IT JP KE KR KW KZ LB LI LT LU
LV MA MC MD ME MK MT MX MY NG NL NO
NZ OM PA PE PH PK PL PT QA RO RS RU
SA SE SG SI SK TH TR TW UA US UY VN ZA
`;

const countrySelect = document.getElementById("country");

const displayNames = new Intl.DisplayNames(["en"], {
    type: "region"
});

countryCodes.trim().split(/\s+/).sort().forEach(code => {
    const option = document.createElement("option");
    option.value = code;
    option.textContent = displayNames.of(code);
    countrySelect.appendChild(option);
});


// =====================================
// 2. COUNTRY MARKET FACTORS
// =====================================

// Indicative relative market factors.
// These are budgetary assumptions, not live quotations.

const countryRates = {
    IE: 1.12,
    DE: 1.08,
    FR: 1.05,
    NL: 1.07,
    BE: 1.06,
    ES: 0.94,
    PT: 0.91,
    IT: 1.00,
    GR: 0.88,
    GB: 1.13,
    US: 1.18,
    CA: 1.15,
    AU: 1.16,
    JP: 1.20,
    KR: 1.10,
    IN: 0.65,
    CN: 0.72,
    BR: 0.83,
    ZA: 0.78,
    SA: 0.96,
    AE: 1.04,
    PL: 0.84,
    RO: 0.76,
    BG: 0.72,
    TR: 0.68,
    SE: 1.12,
    NO: 1.25,
    DK: 1.14,
    FI: 1.08
};

const defaultMarketFactor = 1.00;


// =====================================
// 3. EPC BASE RATES
// =====================================

// EUR per MWp for Solar PV.
// Rates are indicative budgetary allowances.

const solarRates = {
    civil: 42000,
    mechanical: 48000,
    electrical: 45000,
    installation: 38000,
    engineering: 18000,
    scada: 8000,
    other: 12000
};

// BESS rates

const bessRates = {
    civil: 70000,
    mechanical: 120000,
    electrical: 180000,
    installation: 35000,
    engineering: 20000,
    scada: 10000,
    other: 15000,
    batteryPerMWh: 180000
};

// Data centre rates

const dataCenterRates = {
    civil: 1200000,
    mechanical: 2400000,
    electrical: 3800000,
    installation: 700000,
    engineering: 400000,
    scada: 200000,
    other: 300000
};


// =====================================
// 4. MODULE PRICES
// =====================================

// Indicative bulk procurement reference prices in EUR/Wp.

const moduleOptions = {
    topcon_mono: {
        name: "N-type TOPCon Monofacial",
        pricePerWp: 0.105
    },

    topcon_bifacial: {
        name: "N-type TOPCon Bifacial",
        pricePerWp: 0.108
    },

    perc: {
        name: "PERC Monofacial",
        pricePerWp: 0.095
    }
};


// =====================================
// 5. OTHER MATERIAL PRICES
// =====================================

const materialRates = {

    inverter: 18000,

    fixedStructurePerModule: 32,

    trackerStructurePerModule: 48,

    dcCable: 1.40,

    acCable: 8.50,

    mvCable: 35,

    dcConnector: 2.50,

    mvSubstation: 260000,

    accessRoad: 45,

    fencing: 22,

    foundation: 35,

    drainage: 18,

    scadaPerMW: 2500

};


// =====================================
// 6. UPDATE PROJECT OPTIONS
// =====================================

function updateProjectOptions() {

    const type = document.getElementById("projectType").value;

    const groups = [
        "solarOptions",
        "modulePowerGroup",
        "mountingGroup",
        "invertersGroup",
        "substationsGroup",
        "modulesPerStringGroup",
        "durationGroup",
        "chemistryGroup",
        "tierGroup",
        "coolingGroup"
    ];

    groups.forEach(id => {
        document.getElementById(id).style.display = "none";
    });

    const label = document.getElementById("capacityLabel");

    if (type === "solar") {

        label.textContent = "Solar PV Capacity (MWp)";

        [
            "solarOptions",
            "modulePowerGroup",
            "mountingGroup",
            "invertersGroup",
            "substationsGroup",
            "modulesPerStringGroup"
        ].forEach(id => {
            document.getElementById(id).style.display = "block";
        });

    } else if (type === "bess") {

        label.textContent = "BESS Power Capacity (MW)";

        document.getElementById("durationGroup").style.display = "block";
        document.getElementById("chemistryGroup").style.display = "block";

    } else if (type === "datacenter") {

        label.textContent = "IT Load Capacity (MW)";

        document.getElementById("tierGroup").style.display = "block";
        document.getElementById("coolingGroup").style.display = "block";

    } else {

        label.textContent = "Project Capacity (MW)";

    }

}


// =====================================
// 7. FORMAT FUNCTIONS
// =====================================

function formatMoney(value) {

    return new Intl.NumberFormat("en-IE", {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0
    }).format(value);

}

function formatNumber(value, decimals = 2) {

    return new Intl.NumberFormat("en-IE", {
        minimumFractionDigits: 0,
        maximumFractionDigits: decimals
    }).format(value);

}

function showError(message) {

    const error = document.getElementById("errorMessage");

    error.textContent = message;
    error.style.display = "block";

}

function clearError() {

    const error = document.getElementById("errorMessage");

    error.textContent = "";
    error.style.display = "none";

}


// =====================================
// 8. SOLAR MATERIAL CALCULATION
// =====================================

function getSolarMaterials(data) {

    const {
        capacity,
        moduleWp,
        modules,
        strings,
        modulesPerString,
        inverterCount,
        substationCount,
        mountingType,
        factor,
        moduleTechnology
    } = data;

    const modulePrice =
        moduleOptions[moduleTechnology].pricePerWp * moduleWp;

    const mountingPrice =
        mountingType === "tracker"
            ? materialRates.trackerStructurePerModule
            : materialRates.fixedStructurePerModule;

    // Budgetary cable-length allowances.
    // Actual quantities must be confirmed by detailed design.

    const dcCableLength = capacity * 3000;

    const acCableLength = capacity * 600;

    const mvCableLength = capacity * 150;

    const materials = [

        {
            name: "PV Modules - " + moduleOptions[moduleTechnology].name,
            quantity: modules,
            unit: "pcs",
            unitPrice: modulePrice,
            total: modules * modulePrice * factor
        },

        {
            name: "PV Strings",
            quantity: strings,
            unit: "strings",
            unitPrice: 0,
            total: 0
        },

        {
            name: "Modules per String",
            quantity: modulesPerString,
            unit: "modules/string",
            unitPrice: 0,
            total: 0
        },

        {
            name: "String Inverters",
            quantity: inverterCount,
            unit: "units",
            unitPrice: materialRates.inverter * factor,
            total: inverterCount * materialRates.inverter * factor
        },

        {
            name: "Mounting Structures",
            quantity: modules,
            unit: "module positions",
            unitPrice: mountingPrice * factor,
            total: modules * mountingPrice * factor
        },

        {
            name: "DC Cables",
            quantity: dcCableLength,
            unit: "m",
            unitPrice: materialRates.dcCable * factor,
            total: dcCableLength * materialRates.dcCable * factor
        },

        {
            name: "AC LV Cables",
            quantity: acCableLength,
            unit: "m",
            unitPrice: materialRates.acCable * factor,
            total: acCableLength * materialRates.acCable * factor
        },

        {
            name: "MV Cables",
            quantity: mvCableLength,
            unit: "m",
            unitPrice: materialRates.mvCable * factor,
            total: mvCableLength * materialRates.mvCable * factor
        },

        {
            name: "DC Connectors",
            quantity: modules * 2,
            unit: "pcs",
            unitPrice: materialRates.dcConnector * factor,
            total: modules * 2 * materialRates.dcConnector * factor
        },

        {
            name: "MV Substations",
            quantity: substationCount,
            unit: "units",
            unitPrice: materialRates.mvSubstation * factor,
            total: substationCount * materialRates.mvSubstation * factor
        },

        {
            name: "SCADA / Monitoring",
            quantity: capacity,
            unit: "MWp allowance",
            unitPrice: materialRates.scadaPerMW * factor,
            total: capacity * materialRates.scadaPerMW * factor
        },

        {
            name: "Access Roads",
            quantity: capacity * 350,
            unit: "m allowance",
            unitPrice: materialRates.accessRoad * factor,
            total: capacity * 350 * materialRates.accessRoad * factor
        },

        {
            name: "Fencing",
            quantity: capacity * 180,
            unit: "m allowance",
            unitPrice: materialRates.fencing * factor,
            total: capacity * 180 * materialRates.fencing * factor
        },

        {
            name: "Foundations",
            quantity: modules,
            unit: "pcs allowance",
            unitPrice: materialRates.foundation * factor,
            total: modules * materialRates.foundation * factor
        },

        {
            name: "Drainage System",
            quantity: capacity * 250,
            unit: "m allowance",
            unitPrice: materialRates.drainage * factor,
            total: capacity * 250 * materialRates.drainage * factor
        }

    ];

    return materials;

}


// =====================================
// 9. OTHER PROJECT MATERIALS
// =====================================

function getOtherMaterials(type, capacity, duration, factor) {

    if (type === "bess") {

        const energy = capacity * duration;
        const containers = energy / 5;

        return [

            {
                name: "Battery Energy Capacity",
                quantity: energy,
                unit: "MWh",
                unitPrice: 180000 * factor,
                total: energy * 180000 * factor
            },

            {
                name: "Battery Containers",
                quantity: containers,
                unit: "units",
                unitPrice: 450000 * factor,
                total: containers * 450000 * factor
            },

            {
                name: "Power Conversion System",
                quantity: capacity,
                unit: "MW",
                unitPrice: 95000 * factor,
                total: capacity * 95000 * factor
            },

            {
                name: "MV Transformers",
                quantity: capacity / 5,
                unit: "units allowance",
                unitPrice: 65000 * factor,
                total: capacity / 5 * 65000 * factor
            },

            {
                name: "MV Switchgear",
                quantity: capacity / 5,
                unit: "units allowance",
                unitPrice: 28000 * factor,
                total: capacity / 5 * 28000 * factor
            },

            {
                name: "MV Cables",
                quantity: capacity * 250,
                unit: "m allowance",
                unitPrice: 35 * factor,
                total: capacity * 250 * 35 * factor
            },

            {
                name: "EMS / BMS",
                quantity: 1,
                unit: "system",
                unitPrice: 53000 * factor,
                total: 53000 * factor
            },

            {
                name: "Fire Suppression",
                quantity: containers,
                unit: "systems",
                unitPrice: 18000 * factor,
                total: containers * 18000 * factor
            },

            {
                name: "HVAC Systems",
                quantity: containers,
                unit: "systems",
                unitPrice: 14000 * factor,
                total: containers * 14000 * factor
            }

        ];

    }

    if (type === "datacenter") {

        return [

            {
                name: "Server Racks",
                quantity: capacity * 80,
                unit: "units",
                unitPrice: 4500 * factor,
                total: capacity * 80 * 4500 * factor
            },

            {
                name: "UPS Systems",
                quantity: capacity,
                unit: "systems",
                unitPrice: 180000 * factor,
                total: capacity * 180000 * factor
            },

            {
                name: "Generators",
                quantity: capacity / 2,
                unit: "units allowance",
                unitPrice: 350000 * factor,
                total: capacity / 2 * 350000 * factor
            },

            {
                name: "MV Transformers",
                quantity: capacity / 5,
                unit: "units allowance",
                unitPrice: 85000 * factor,
                total: capacity / 5 * 85000 * factor
            },

            {
                name: "MV Switchgear",
                quantity: capacity / 2,
                unit: "units allowance",
                unitPrice: 45000 * factor,
                total: capacity / 2 * 45000 * factor
            },

            {
                name: "Cooling Systems",
                quantity: capacity * 1.2,
                unit: "MW thermal",
                unitPrice: 95000 * factor,
                total: capacity * 1.2 * 95000 * factor
            },

            {
                name: "Power Cables",
                quantity: capacity * 1800,
                unit: "m",
                unitPrice: 12 * factor,
                total: capacity * 1800 * 12 * factor
            },

            {
                name: "Fiber Optic Cables",
                quantity: capacity * 2500,
                unit: "m",
                unitPrice: 2.5 * factor,
                total: capacity * 2500 * 2.5 * factor
            }

        ];

    }

    return [];

}


// =====================================
// 10. MAIN CALCULATION
// =====================================

let lastCalculation = null;

function calculateBudget() {

    clearError();

    const country = document.getElementById("country").value;

    const type = document.getElementById("projectType").value;

    const capacity = Number(
        document.getElementById("capacity").value
    );

    if (!country || !type || !Number.isFinite(capacity) || capacity <= 0) {
        showError("Please select a country, project type and enter a valid capacity.");
        return;
    }

    const factor = countryRates[country] ?? defaultMarketFactor;

    let duration = 0;

    let modules = 0;
    let strings = 0;
    let modulesPerString = 0;
    let moduleWp = 0;
    let inverterCount = 0;
    let substationCount = 0;
    let mountingType = "";
    let moduleTechnology = "";

    let materials = [];
    let actualCapacity = capacity;


    // SOLAR VALIDATION

    if (type === "solar") {

        moduleTechnology =
            document.getElementById("solarTechnology").value;

        moduleWp = Number(
            document.getElementById("modulePower").value
        );

        mountingType =
            document.getElementById("mountingType").value;

        inverterCount = Number(
            document.getElementById("inverterCount").value
        );

        substationCount = Number(
            document.getElementById("substationCount").value
        );

        modulesPerString = Number(
            document.getElementById("modulesPerString").value
        );

        if (
            !moduleTechnology ||
            !moduleWp ||
            !mountingType ||
            !Number.isInteger(inverterCount) ||
            inverterCount <= 0 ||
            !Number.isInteger(substationCount) ||
            substationCount <= 0 ||
            !Number.isInteger(modulesPerString) ||
            modulesPerString <= 0
        ) {
            showError("Please complete all Solar PV configuration fields.");
            return;
        }

        // Calculate module quantity automatically.
        modules = Math.ceil(capacity * 1000000 / moduleWp);

        // Actual installed DC capacity based on whole modules.
        actualCapacity = modules * moduleWp / 1000000;

        // Calculate strings automatically.
        strings = Math.ceil(modules / modulesPerString);

        materials = getSolarMaterials({
            capacity: actualCapacity,
            moduleWp,
            modules,
            strings,
            modulesPerString,
            inverterCount,
            substationCount,
            mountingType,
            factor,
            moduleTechnology
        });

    }


    // BESS VALIDATION

    if (type === "bess") {

        duration = Number(
            document.getElementById("duration").value
        );

        const chemistry =
            document.getElementById("batteryChemistry").value;

        if (!duration || duration <= 0 || !chemistry) {
            showError("Please enter BESS duration and select battery chemistry.");
            return;
        }

        materials = getOtherMaterials(
            type, capacity, duration, factor
        );

    }


    // DATA CENTER VALIDATION

    if (type === "datacenter") {

        const tier =
            document.getElementById("dataCenterTier").value;

        const cooling =
            document.getElementById("coolingType").value;

        if (!tier || !cooling) {
            showError("Please select Data Center Tier and Cooling System.");
            return;
        }

        materials = getOtherMaterials(
            type, capacity, 0, factor
        );

    }


    // BASE EPC COSTS

    let rates;

    if (type === "solar") rates = solarRates;
    if (type === "bess") rates = bessRates;
    if (type === "datacenter") rates = dataCenterRates;

    const baseCosts = {

        "Civil Works": actualCapacity * rates.civil,

        "Mechanical Works": actualCapacity * rates.mechanical,

        "Electrical Works": actualCapacity * rates.electrical,

        "Installation Labour": actualCapacity * rates.installation,

        "Engineering and Project Management": actualCapacity * rates.engineering,

        "SCADA / Monitoring / Commissioning": actualCapacity * rates.scada,

        "Other EPC Costs": actualCapacity * rates.other

    };


    // Additional procurement cost for solar equipment.
    // Material reference breakdown is an allocation of these EPC costs.
    // It is NOT added again to the total.

    if (type === "solar") {

        const moduleCost = materials.find(
            x => x.name.startsWith("PV Modules")
        ).total;

        const inverterCost = materials.find(
            x => x.name === "String Inverters"
        ).total;

        const substationCost = materials.find(
            x => x.name === "MV Substations"
        ).total;

        baseCosts["PV Modules"] = moduleCost;

        baseCosts["String Inverters"] = inverterCost;

        baseCosts["MV Substations"] = substationCost;

    }


    // Direct EPC cost

    const adjustedCosts = {};

    Object.entries(baseCosts).forEach(([name, cost]) => {
        adjustedCosts[name] = cost * factor;
    });

    // Solar module and equipment values are already market-adjusted
    // in the materials table. Avoid applying the factor twice.

    if (type === "solar") {

        adjustedCosts["PV Modules"] =
            baseCosts["PV Modules"];

        adjustedCosts["String Inverters"] =
            baseCosts["String Inverters"];

        adjustedCosts["MV Substations"] =
            baseCosts["MV Substations"];

    }

    const directTotal = Object.values(adjustedCosts).reduce(
        (sum, value) => sum + value,
        0
    );

    const contingency = directTotal * 0.05;

    const totalEPC = directTotal + contingency;

    const costPerMW = totalEPC / actualCapacity;


    // EPC BREAKDOWN TABLE

    const costTable = document.getElementById("costTable");

    costTable.innerHTML = "";

    Object.entries(adjustedCosts).forEach(([name, cost]) => {

        costTable.innerHTML += `
            <tr>
                <td>${name}</td>
                <td>${formatMoney(cost)}</td>
                <td>${formatNumber(cost / totalEPC * 100, 1)}%</td>
            </tr>
        `;

    });

    costTable.innerHTML += `
        <tr>
            <td>Contingency (5%)</td>
            <td>${formatMoney(contingency)}</td>
            <td>${formatNumber(contingency / totalEPC * 100, 1)}%</td>
        </tr>
    `;


    // MATERIAL TABLE

    const materialTable = document.getElementById("materialTable");

    materialTable.innerHTML = "";

    const materialTotal = materials.reduce(
        (sum, item) => sum + item.total,
        0
    );

    materials.forEach(item => {

        materialTable.innerHTML += `
            <tr>
                <td>${item.name}</td>
                <td>${formatNumber(item.quantity, 2)}</td>
                <td>${item.unit}</td>
                <td>${formatMoney(item.unitPrice)}</td>
                <td>${formatMoney(item.total)}</td>
            </tr>
        `;

    });


    // SUMMARY

    document.getElementById("totalBudget").textContent =
        formatMoney(totalEPC);

    document.getElementById("costTotal").textContent =
        formatMoney(totalEPC);

    document.getElementById("materialTotal").textContent =
        formatMoney(materialTotal);

    document.getElementById("projectSummary").textContent =
        type.toUpperCase() + " | " + formatNumber(actualCapacity, 3) +
        (type === "solar" ? " MWp" : " MW");

    document.getElementById("marketSummary").textContent =
        "Country: " + country + " | Market Factor: " + factor;

    document.getElementById("costPerMW").textContent =
        formatMoney(costPerMW) + " / MW";


    // ASSUMPTIONS

    let assumptions = `
        <p><strong>Country:</strong> ${country}</p>
        <p><strong>Market factor:</strong> ${factor}</p>
        <p><strong>Direct EPC cost:</strong> ${formatMoney(directTotal)}</p>
        <p><strong>Contingency:</strong> 5%</p>
        <p><strong>Total EPC cost:</strong> ${formatMoney(totalEPC)}</p>
    `;

    if (type === "solar") {

        assumptions += `
            <p><strong>PV Technology:</strong> ${moduleOptions[moduleTechnology].name}</p>
            <p><strong>Module Power:</strong> ${moduleWp} Wp</p>
            <p><strong>Calculated Module Quantity:</strong> ${formatNumber(modules, 0)}</p>
            <p><strong>Actual DC Capacity:</strong> ${formatNumber(actualCapacity, 3)} MWp</p>
            <p><strong>Modules per String:</strong> ${modulesPerString}</p>
            <p><strong>Calculated Strings:</strong> ${strings}</p>
            <p><strong>Number of Inverters:</strong> ${inverterCount}</p>
            <p><strong>Number of MV Substations:</strong> ${substationCount}</p>
            <p><strong>Mounting:</strong> ${mountingType === "fixed" ? "Fixed Tilt" : "Single Axis Tracker"}</p>
            <p><strong>EPC Cost per Wp:</strong> €${(totalEPC / (actualCapacity * 1000000)).toFixed(3)}</p>
            <p><strong>String configuration:</strong> ${modules} modules distributed across ${strings} strings. Check final string allocation in detailed engineering.</p>
        `;

    }

    if (type === "bess") {

        assumptions += `
            <p><strong>BESS Duration:</strong> ${duration} hours</p>
            <p><strong>Energy Capacity:</strong> ${formatNumber(capacity * duration)} MWh</p>
            <p><strong>Battery Chemistry:</strong> ${document.getElementById("batteryChemistry").value}</p>
        `;

    }

    if (type === "datacenter") {

        assumptions += `
            <p><strong>Data Center Tier:</strong> ${document.getElementById("dataCenterTier").value}</p>
            <p><strong>Cooling System:</strong> ${document.getElementById("coolingType").value}</p>
        `;

    }

    assumptions += `
        <p class="note">
            Material reference values are a separate presentation of selected
            equipment and procurement allowances. They are not added again to
            the EPC cost. Cable lengths and other quantities are preliminary
            allowances and require confirmation through detailed design.
        </p>
    `;

    document.getElementById("assumptions").innerHTML = assumptions;


    // SAVE FOR EXCEL

    lastCalculation = {
        country,
        type,
        capacity,
        actualCapacity,
        factor,
        modules,
        moduleWp,
        strings,
        modulesPerString,
        inverterCount,
        substationCount,
        mountingType,
        adjustedCosts,
        directTotal,
        contingency,
        totalEPC,
        costPerMW,
        materials
    };


    document.getElementById("results").style.display = "block";

    document.getElementById("results").scrollIntoView({
        behavior: "smooth"
    });

}


// =====================================
// 11. EXCEL EXPORT
// =====================================

function exportExcel() {

    if (!lastCalculation) {
        alert("Please calculate the budget first.");
        return;
    }

    if (typeof XLSX === "undefined") {
        alert("Excel library could not be loaded.");
        return;
    }

    const d = lastCalculation;

    const wb = XLSX.utils.book_new();


    // SUMMARY

    const summary = [

        ["BUDGET ESTIMATE CALCULATION"],

        [],

        ["Project Information", "Value"],

        ["Country", d.country],

        ["Project Type", d.type],

        ["Input Capacity", d.capacity],

        ["Actual Capacity", d.actualCapacity],

        ["Market Factor", d.factor],

        ["Module Quantity", d.modules],

        ["Module Power (Wp)", d.moduleWp],

        ["Number of Strings", d.strings],

        ["Modules per String", d.modulesPerString],

        ["Number of Inverters", d.inverterCount],

        ["Number of MV Substations", d.substationCount],

        [],

        ["EPC Cost Summary", "EUR"],

        ["Direct EPC Cost", d.directTotal],

        ["Contingency", d.contingency],

        ["TOTAL EPC COST", d.totalEPC],

        ["EPC Cost per MW", d.costPerMW]

    ];

    const wsSummary = XLSX.utils.aoa_to_sheet(summary);

    wsSummary["!cols"] = [
        { wch: 38 },
        { wch: 25 }
    ];

    XLSX.utils.book_append_sheet(
        wb,
        wsSummary,
        "Project Summary"
    );


    // EPC BREAKDOWN

    const epcData = [
        ["Work Category", "Estimated Cost (€)"]
    ];

    Object.entries(d.adjustedCosts).forEach(([name, cost]) => {
        epcData.push([name, cost]);
    });

    epcData.push(["Contingency", d.contingency]);

    epcData.push(["TOTAL EPC COST", d.totalEPC]);

    const wsEpc = XLSX.utils.aoa_to_sheet(epcData);

    wsEpc["!cols"] = [
        { wch: 42 },
        { wch: 25 }
    ];

    XLSX.utils.book_append_sheet(
        wb,
        wsEpc,
        "EPC Breakdown"
    );


    // MATERIALS

    const materialData = [
        [
            "Material / Equipment",
            "Estimated Quantity",
            "Unit",
            "Unit Price (€)",
            "Reference Total (€)"
        ]
    ];

    d.materials.forEach(item => {

        materialData.push([
            item.name,
            item.quantity,
            item.unit,
            item.unitPrice,
            item.total
        ]);

    });

    const wsMaterials = XLSX.utils.aoa_to_sheet(materialData);

    wsMaterials["!cols"] = [
        { wch: 42 },
        { wch: 22 },
        { wch: 20 },
        { wch: 20 },
        { wch: 25 }
    ];

    XLSX.utils.book_append_sheet(
        wb,
        wsMaterials,
        "Material Reference"
    );


    XLSX.writeFile(
        wb,
        "Budget_Estimate_Calculation.xlsx"
    );

}


// =====================================
// 12. RESET
// =====================================

function resetCalculator() {

    const fields = [
        "country",
        "projectType",
        "capacity",
        "solarTechnology",
        "modulePower",
        "mountingType",
        "inverterCount",
        "substationCount",
        "modulesPerString",
        "duration",
        "batteryChemistry",
        "dataCenterTier",
        "coolingType"
    ];

    fields.forEach(id => {
        document.getElementById(id).value = "";
    });

    updateProjectOptions();

    document.getElementById("results").style.display = "none";

    clearError();

    lastCalculation = null;

}

</script>

