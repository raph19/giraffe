 market:'السوق',estimated:'تقديري',actual:'إدخال المستخدم',assumed:'قيمة مفترضة',
 solarDetails:'تفاصيل الطاقة الشمسية',strings:'سلاسل',modules:'ألواح',
 assumptionMessage:'تم تقدير الحقول الاختيارية الفارغة باستخدام افتراضات النموذج، وتم إدراج الكميات في تكلفة المواد.',
 noAssumptions:'تم إدخال الكميات الاختيارية يدوياً أو أنها غير مطبقة.',
 costPer:'تكلفة EPC التقديرية',perMW:'لكل MW',perMWh:'لكل MWh',
 cableAssumptions:'الكميات التقديرية: DC 1,200 متر/MWp، وAC 120 متر/MW، وMV 180 متر/MW، وHV 100 متر/MW، والألياف 150 متر/MW، والطرق 70 متر/MW.',
 excelError:'يرجى إجراء حساب صحيح أولاً.',excelOffline:'يتطلب تصدير Excel اتصالاً بالإنترنت.'
}

};

function tr(key){
 const lang=$('language').value;
 return (labels[lang] && labels[lang][key]) || labels.en[key] || key;
}

function setLanguage(){
 const lang=$('language').value;
 document.documentElement.lang=lang;
 document.documentElement.dir=lang==='ar'?'rtl':'ltr';

 document.querySelectorAll('[data-i18n]').forEach(el=>{
  el.textContent=tr(el.dataset.i18n);
 });

 refreshCountries();
 updateCapacityLabel();

 if(lastCalculation) calculateBudget(false);
}

/* Dynamic capacity and project fields */

function updateCapacityLabel(){
 const type=$('projectType').value;

 $('capacityLabel').textContent=
  type==='solar'?tr('capacitySolar'):
  type==='bess'?tr('capacityBess'):
  type==='datacenter'?tr('capacityDc'):'Project Capacity (MW)';

 const groups=[
  'solarTechnologyGroup','modulePowerGroup','mountingGroup',
  'invertersGroup','substationsGroup','modulesStringGroup',
  'mvCableGroup','dcCableGroup','acCableGroup','hvCableGroup',
  'fibreCableGroup','roadLengthGroup','durationGroup',
  'chemistryGroup','tierGroup','coolingGroup'
 ];

 groups.forEach(id=>$(id).style.display='none');

 const show=ids=>ids.forEach(id=>$(id).style.display='block');

 if(type==='solar'){
  show([
   'solarTechnologyGroup','modulePowerGroup','mountingGroup',
   'invertersGroup','substationsGroup','modulesStringGroup',
   'mvCableGroup','dcCableGroup','acCableGroup','hvCableGroup',
   'fibreCableGroup','roadLengthGroup'
  ]);
 }

 if(type==='bess')show(['durationGroup','chemistryGroup']);
 if(type==='datacenter')show(['tierGroup','coolingGroup']);

 $('optionalDetails').style.display=type==='solar'?'block':'none';
}

/* Formatting */

function fmt(n){
 return new Intl.NumberFormat(localeMap[$('language').value] || 'en',{maximumFractionDigits:2}).format(n);
}

function money(n){
 return new Intl.NumberFormat(localeMap[$('language').value] || 'en',{
  style:'currency',currency:'EUR',maximumFractionDigits:0
 }).format(n);
}

/*
Optional length resolver.
A manually entered value takes priority.
A blank value uses the relevant assumption.
*/

function resolveLength(id,rate,capacity){
 const raw=$(id).value;

 if(raw!=='' && Number.isFinite(Number(raw)) && Number(raw)>=0){
  return {value:Number(raw),assumed:false};
 }

 return {value:capacity*rate,assumed:true};
}

/* Material and equipment reference */

function getMaterials(type,cap,duration,o,factor){

 let materials=[];

 if(type==='solar'){

  const count=Math.ceil(cap*1e6/o.modulePower);
  const strings=Math.ceil(count/o.modulesPerString);
  const moduleRate=moduleOptions[o.tech].price*o.modulePower;

  materials=[
   ['PV Modules',count,'pcs',moduleRate],
   ['PV Strings',strings,'strings',0],
   ['String Inverters',o.inverters,'units',18000],
   ['Mounting Structure',count,'sets',31],
   ['DC Cables',o.dcLength,'m',1.25],
   ['AC LV Cables',o.acLength,'m',7.5],
   ['MV Cable',o.mvLength,'m',22],
   ['HV / Export Cable',o.hvLength,'m',38],
   ['Fibre Optic / Communication Cable',o.fibreLength,'m',1.8],
   ['Access Roads',o.roadLength,'m',95],
   ['MV Substations',o.substations,'units',95000],
   ['MV Switchgear',o.substations,'sets',28000],
   ['DC Connectors',count*2,'pcs',2.1],
   ['SCADA / Monitoring',cap,'MWp',2400]
  ];

 }else if(type==='bess'){

  const energy=cap*duration;
  const containers=Math.ceil(energy/5);

  materials=[
   ['Battery System / Containers',energy,'MWh',93000],
   ['Power Conversion System (PCS)',cap,'MW',85000],
   ['MV Transformer & Switchgear',cap/5,'sets',95000],
   ['EMS / BMS',1,'system',45000],
   ['Fire Suppression & HVAC',containers,'sets',26000],
   ['Civil Foundations',energy,'MWh',6500],
   ['MV / HV Cabling',cap*250,'m',22]
  ];

 }else{

  materials=[
   ['Server Racks',cap*80,'units',4500],
   ['UPS Systems',cap,'MW',180000],
   ['Generators',cap/2,'units',350000],
   ['MV Transformers',cap/5,'units',85000],
   ['Cooling Systems',cap*1.2,'MWth',95000],
   ['Power Cables',cap*1800,'m',12],
   ['Fire Suppression',cap,'systems',18000]
  ];
 }

 return materials.map(item=>[
  item[0],item[1],item[2],item[3]*factor
 ]);
}

/* Main budget calculation */

function calculateBudget(scroll=false){

 const country=$('country').value;
 const type=$('projectType').value;
 const cap=Number($('capacity').value);

 let error='';

 if(!country || !type || !Number.isFinite(cap) || cap<=0){
  error=tr('invalid');
 }

 let o={};
 let assumptionUsed=false;

 if(type==='solar'){

  o.tech=$('solarTechnology').value;
  o.modulePower=Number($('modulePower').value);
  o.mounting=$('mountingType').value;
  o.inverters=Number($('inverters').value);
  o.substations=Number($('substations').value);
  o.modulesPerString=Number($('modulesPerString').value);

  if(
   !o.tech || !o.modulePower || !o.mounting ||
   !Number.isInteger(o.inverters) || o.inverters<1 ||
   !Number.isInteger(o.substations) || o.substations<1 ||
   !Number.isInteger(o.modulesPerString) || o.modulesPerString<1
  ){
   error=tr('invalidSolar');
  }

  if(!error){

   const dc=resolveLength('dcCableLength',lengthAssumptions.dc,cap);
   const ac=resolveLength('acCableLength',lengthAssumptions.ac,cap);
   const mv=resolveLength('mvCableLength',lengthAssumptions.mv,cap);
   const hv=resolveLength('hvCableLength',lengthAssumptions.hv,cap);
   const fibre=resolveLength('fibreCableLength',lengthAssumptions.fibre,cap);
   const road=resolveLength('roadLength',lengthAssumptions.road,cap);

   o.dcLength=dc.value;
   o.acLength=ac.value;
   o.mvLength=mv.value;
   o.hvLength=hv.value;
   o.fibreLength=fibre.value;
   o.roadLength=road.value;

   o.assumptions={
    dc:dc.assumed,ac:ac.assumed,mv:mv.assumed,
    hv:hv.assumed,fibre:fibre.assumed,road:road.assumed
   };

   assumptionUsed=Object.values(o.assumptions).some(Boolean);
  }
 }

 if(type==='bess'){
  o.duration=Number($('duration').value);
  o.chemistry=$('batteryChemistry').value;

  if(!o.duration || o.duration<=0 || !o.chemistry){
   error=tr('invalidBess');
  }
 }

 if(type==='datacenter'){
  o.tier=$('dataCenterTier').value;
  o.cooling=$('coolingType').value;

  if(!o.tier || !o.cooling){
   error=tr('invalidDc');
  }
 }

 if(error){
  $('validationMessage').textContent=error;
  $('results').style.display='none';
  lastCalculation=null;
  return false;
 }

 $('validationMessage').textContent='';

 const factor=countryRates[country]??1;
 let costs=[];

 /* Solar EPC: original rates retained */

 if(type==='solar'){

  let base=cap*(
   rates.solar.civil+
   rates.solar.mechanical+
   rates.solar.electrical
  );

  if(o.mounting==='tracker')base*=1.08;

  const contingency=base*.06;

  costs=[
   ['Civil Works & Infrastructure',cap*rates.solar.civil],
   ['Mechanical Works & Mounting',cap*rates.solar.mechanical*(o.mounting==='tracker'?1.08:1)],
   ['Electrical Works & Grid Equipment',cap*rates.solar.electrical],
   ['Engineering, PM & Commissioning',base*.07],
   ['Contingency / Unforeseen Costs',contingency]
  ];

 }else if(type==='bess'){

  const energy=cap*o.duration;
  const battery=energy*rates.bess.batteryPerMWh;
  const bop=cap*rates.bess.civil;
  const pre=battery+bop;

  costs=[
   ['Battery System Procurement',battery],
   ['PCS, MV & Electrical Balance of Plant',bop],
   ['Engineering, Integration & Commissioning',pre*.08],
   ['Contingency / Unforeseen Costs',pre*.05]
  ];

 }else{

  const pre=cap*(
   rates.datacenter.civil+
   rates.datacenter.mechanical+
   rates.datacenter.electrical
  );

  costs=[
   ['Civil Works',cap*rates.datacenter.civil],
   ['Mechanical & Cooling',cap*rates.datacenter.mechanical],
   ['Electrical & Power Systems',cap*rates.datacenter.electrical],
   ['Engineering, Integration & Commissioning',pre*.08],
   ['Contingency / Unforeseen Costs',pre*.07]
  ];
 }

 costs=costs.map(item=>[item[0],item[1],item[1]*factor]);

 const total=costs.reduce((sum,item)=>sum+item[2],0);

 const denominator=type==='bess'?cap*o.duration:cap;
 const unitLabel=type==='bess'?tr('perMWh'):tr('perMW');

 $('costTable').innerHTML=costs.map(item=>`
  <tr>
   <td>${item[0]}</td>
   <td>${money(item[1])}</td>
   <td>${factor.toFixed(2)}</td>
   <td>${money(item[2])}</td>
  </tr>
 `).join('');

 $('costTotal').textContent=money(total);
 $('totalBudget').textContent=money(total);

 $('costPerMW').textContent=
  `${tr('costPer')} ${unitLabel}: ${money(total/denominator)}`;

 let detail='';

 if(type==='solar'){
  const modules=Math.ceil(cap*1e6/o.modulePower);
  const strings=Math.ceil(modules/o.modulesPerString);

  detail=
   `${moduleOptions[o.tech].name} · ${o.modulePower} Wp · ${o.mounting} · `+
   `${fmt(modules)} ${tr('modules')} · ${fmt(strings)} ${tr('strings')} · `+
   `${o.inverters} inverters · ${o.substations} MV substations`;
 }else if(type==='bess'){
  detail=`${o.chemistry} · ${fmt(cap*o.duration)} MWh · ${o.duration} hours`;
 }else{
  detail=`${o.tier} · ${o.cooling}`;
 }

 $('projectSummary').textContent=
  `${type.toUpperCase()} | ${fmt(cap)} ${type==='solar'?'MWp':'MW'} | ${detail}`;

 $('marketSummary').textContent=
  `${tr('market')}: ${countryNames.of(country)} | ${tr('factor')}: ${factor.toFixed(2)}`;

 const materials=getMaterials(type,cap,o.duration||0,o,factor);

 $('materialTable').innerHTML=materials.map(item=>{
  const line=item[1]*item[3];
  return `
   <tr>
    <td>${item[0]}</td>
    <td>${fmt(item[1])}</td>
    <td>${item[2]}</td>
    <td>${money(item[3])}</td>
    <td>${money(line)}</td>
   </tr>
  `;
 }).join('');

 const materialTotal=materials.reduce(
  (sum,item)=>sum+item[1]*item[3],0
 );

 $('materialTotal').textContent=money(materialTotal);

 $('assumptionNote').textContent=
  type==='solar'
   ? (assumptionUsed
      ?tr('assumptionMessage')+' '+tr('cableAssumptions')
      :tr('noAssumptions'))
   :'';

 lastCalculation={
  country,
  countryName:countryNames.of(country),
  type,
  capacity:cap,
  options:o,
  factor,
  costs,
  total,
  unitCost:total/denominator,
  materials,
  materialTotal,
  assumptionUsed
 };

 $('results').style.display='block';

 if(scroll){
  $('results').scrollIntoView({behavior:'smooth',block:'start'});
 }

 return true;
}

/* Automatic recalculation */

function scheduleCalculation(){
 clearTimeout(autoTimer);

 autoTimer=setTimeout(()=>{
  if($('country').value && $('projectType').value && $('capacity').value){
   calculateBudget(false);
  }
 },250);
}

/* Form submission */

$('budgetForm').addEventListener('submit',e=>{
 e.preventDefault();
 calculateBudget(true);
});

$('budgetForm').addEventListener('keydown',e=>{
 if(e.key==='Enter' && e.target.matches('input,select')){
  e.preventDefault();
  calculateBudget(true);
 }
});

/* Input listeners */

$('projectType').addEventListener('change',()=>{
 updateCapacityLabel();
 scheduleCalculation();
});

$('language').addEventListener('change',setLanguage);

$('budgetForm').querySelectorAll('input,select').forEach(el=>{
 el.addEventListener('input',()=>{
  scheduleCalculation();
  updateSolarDerived();
 });
 el.addEventListener('change',scheduleCalculation);
});

/* Reset */

$('resetBtn').addEventListener('click',()=>{
 $('budgetForm').reset();
 $('results').style.display='none';
 $('validationMessage').textContent='';
 $('solarDerived').style.display='none';
 $('optionalDetails').open=false;
 lastCalculation=null;
 updateCapacityLabel();
});

/* Solar module and string preview */

function updateSolarDerived(){

 if($('projectType').value!=='solar')return;

 const cap=Number($('capacity').value);
 const wp=Number($('modulePower').value);
 const mps=Number($('modulesPerString').value);

 if(cap>0 && wp>0 && mps>0){
  const modules=Math.ceil(cap*1e6/wp);
  $('solarDerived').style.display='block';
  $('solarDerived').textContent=
   `${tr('modules')}: ${fmt(modules)} | ${tr('strings')}: ${fmt(Math.ceil(modules/mps))}`;
 }else{
  $('solarDerived').style.display='none';
 }
}

/* Excel export */

$('exportBtn').addEventListener('click',()=>{

 if(!lastCalculation){
  alert(tr('excelError'));
  return;
 }

 if(typeof XLSX==='undefined'){
  alert(tr('excelOffline'));
  return;
 }

 const d=lastCalculation;
 const wb=XLSX.utils.book_new();

 const rows=[
  ['EPC BUDGET ESTIMATE'],
  ['Country',d.countryName],
  ['Project Type',d.type],
  ['Capacity (MW / MWp)',d.capacity],
  ['Market Factor',d.factor],
  [],
  ['EPC Breakdown'],
  ['Category','Base Cost (€)','Estimated Cost (€)'],
  ...d.costs.map(x=>[x[0],x[1],x[2]]),
  ['TOTAL EPC COST','',d.total],
  [],
  ['Material Reference'],
  ['Material','Quantity','Unit','Unit Price (€)','Reference Total (€)'],
  ...d.materials.map(x=>[x[0],x[1],x[2],x[3],x[1]*x[3]]),
  ['Material reference total','','','',d.materialTotal],
  [],
  ['Optional cable and road quantities'],
  ...(d.type==='solar'?[
   ['DC Cable (m)',d.options.dcLength,d.options.assumptions.dc?'Assumed':'User input'],
   ['AC LV Cable (m)',d.options.acLength,d.options.assumptions.ac?'Assumed':'User input'],
   ['MV Cable (m)',d.options.mvLength,d.options.assumptions.mv?'Assumed':'User input'],
   ['HV Export Cable (m)',d.options.hvLength,d.options.assumptions.hv?'Assumed':'User input'],
   ['Fibre Cable (m)',d.options.fibreLength,d.options.assumptions.fibre?'Assumed':'User input'],
   ['Access Roads (m)',d.options.roadLength,d.options.assumptions.road?'Assumed':'User input']
  ]:[]),
  [],
  ['Material reference values are informational only and are not added again to EPC total.']
 ];

 XLSX.utils.book_append_sheet(
  wb,
  XLSX.utils.aoa_to_sheet(rows),
  'Budget Estimate'
 );

 XLSX.writeFile(
  wb,
  `EPC_Budget_${d.country}_${d.type}_${d.capacity}.xlsx`
 );
});

/* Initialise */

refreshCountries();
setLanguage();
updateCapacityLabel();

</script>
</body>
</html>
