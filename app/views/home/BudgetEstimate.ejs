
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>EPC Project Budget Estimator</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            background: #f3f6fa;
            color: #26364a;
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
            padding: 25px 12px;
        }

        .container {
            max-width: 1120px;
            width: 100%;
        }

        /* HEADER */

        .header {
            background: linear-gradient(120deg, #142b49, #245b91);
            color: white;
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 22px;
        }

        .header h2 {
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 8px;
        }

        .header p {
            margin: 0;
            color: #dce7f3;
            font-size: 14px;
        }

        /* MAIN CARDS */

        .panel-card {
            background: white;
            border: 1px solid #e1e7ef;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 3px 12px rgba(20,43,73,.04);
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            color: #142b49;
            margin: 0 0 20px;
            padding-bottom: 13px;
            border-bottom: 1px solid #e7ebf0;
        }

        /* INPUTS */

        label {
            font-weight: 600;
            color: #45566c;
            margin-bottom: 7px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-control {
            height: 44px;
            border: 1px solid #d8e0ea;
            border-radius: 7px;
            box-shadow: none;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: #2463a6;
            box-shadow: 0 0 0 2px rgba(36,99,166,.08);
        }

        .help-text {
            color: #7a8796;
            font-size: 12px;
            margin-top: 6px;
        }

        .dynamic-section {
            display: none;
        }

        .sub-title {
            color: #245b91;
            font-size: 16px;
            font-weight: bold;
            margin: 8px 0 18px;
        }

        /* BUTTONS */

        .btn-main {
            background: #2463a6;
            color: white;
            border: none;
            padding: 13px 27px;
            border-radius: 7px;
            font-weight: 700;
        }

        .btn-main:hover {
            background: #194d83;
            color: white;
        }

        .btn-reset {
            background: #edf1f6;
            color: #34465d;
            border: none;
            padding: 13px 23px;
            border-radius: 7px;
            font-weight: 600;
        }

        .btn-reset:hover {
            background: #dfe6ef;
            color: #142b49;
        }

        .btn-excel {
            background: #16865d;
            color: white;
            border: none;
            padding: 13px 23px;
            border-radius: 7px;
            font-weight: 600;
        }

        .btn-excel:hover {
            background: #106b49;
            color: white;
        }

        .action-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* MATERIALS */

        .material-note {
            background: #f3f7fc;
            border-left: 4px solid #2463a6;
            padding: 13px 15px;
            border-radius: 5px;
            color: #53647a;
            font-size: 13px;
            margin-bottom: 18px;
            line-height: 1.5;
        }

        .table-responsive {
            border: none;
            margin-bottom: 0;
        }

        .table {
            margin-bottom: 0;
        }

        .table thead {
            background: #edf2f8;
            color: #142b49;
        }

        .table th {
            font-size: 13px;
            font-weight: 700;
        }

        .table td,
        .table th {
            padding: 12px !important;
            vertical-align: middle !important;
        }

        /* RESULTS */

        .results {
            display: none;
        }

        .total-summary {
            background: linear-gradient(120deg, #142b49, #245b91);
            color: white;
            padding: 25px;
            border-radius: 9px;
            margin-bottom: 18px;
        }

        .total-summary span {
            display: block;
            color: #dce7f3;
            font-size: 13px;
            margin-bottom: 9px;
        }

        .total-summary strong {
            font-size: 30px;
        }

        .result-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .result-card {
            background: #f5f8fc;
            border: 1px solid #e1e7ef;
            border-radius: 8px;
            padding: 18px;
        }

        .result-card span {
            display: block;
            color: #6c7b8e;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .result-card strong {
            color: #142b49;
            font-size: 20px;
        }

        .total-row {
            background: #edf4fa;
            font-weight: bold;
        }

        .footer-note {
            color: #7c8998;
            font-size: 12px;
            line-height: 1.6;
            margin-top: 15px;
        }

        .muted {
            color: #7a8796;
            font-size: 13px;
        }

        /* MOBILE RESPONSIVE */

        @media (max-width: 767px) {
            body {
                padding: 12px 7px;
            }

            .header {
                padding: 23px 18px;
                border-radius: 9px;
            }

            .header h2 {
                font-size: 22px;
            }

            .panel-card {
                padding: 17px 13px;
                border-radius: 9px;
            }

            .section-title {
                font-size: 17px;
            }

            .form-group {
                margin-bottom: 16px;
            }

            .action-row {
                display: flex;
                flex-direction: column;
            }

            .action-row button {
                width: 100%;
            }

            .result-grid {
                grid-template-columns: 1fr;
            }

            .total-summary strong {
                font-size: 25px;
            }

            .result-card {
                padding: 15px;
            }

            .table {
                min-width: 650px;
            }
        }

        /* PRINT */

        @media print {
            body {
                background: white;
                padding: 0;
            }

            .no-print {
                display: none !important;
            }

            .panel-card {
                box-shadow: none;
            }

            .header,
            .total-summary {
                print-color-adjust: exact;
                -webkit-print-color-adjust: exact;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <!-- HEADER -->

    <div class="header">
        <h2>EPC Project Budget Estimator</h2>
        <p>Preliminary cost estimation for renewable energy and infrastructure projects</p>
    </div>

    <!-- PROJECT INFORMATION -->

    <div class="panel-card">

        <h3 class="section-title">Project Information</h3>

        <div class="row">

            <div class="col-sm-6">
                <div class="form-group">
                    <label>Country</label>
                    <select id="country" class="form-control">
                        <option value="">Select country</option>
                    </select>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    <label>Project Type</label>
                    <select id="projectType" class="form-control">
                        <option value="">Select project type</option>
                        <option value="solar">Solar PV</option>
                        <option value="bess">BESS</option>
                        <option value="datacenter">Data Center</option>
                    </select>
                </div>
            </div>

        </div>

        <!-- COMMON FIELDS -->

        <div id="commonFields" class="dynamic-section">

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label id="capacityLabel">Project Capacity (MW)</label>
                        <input type="number"
                               id="capacity"
                               class="form-control"
                               min="0.01"
                               step="any"
                               placeholder="Enter capacity">
                    </div>
                </div>
            </div>

        </div>

        <!-- SOLAR OPTIONS -->

        <div id="solarFields" class="dynamic-section">

            <h4 class="sub-title">Solar PV Configuration</h4>

            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Mounting System</label>
                        <select id="mounting" class="form-control">
                            <option value="">Select mounting system</option>
                            <option value="fixed">Fixed Tilt</option>
                            <option value="tracker">Single Axis Tracker</option>
                        </select>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>PV Module Technology</label>
                        <select id="moduleType" class="form-control">
                            <option value="">Select module technology</option>
                            <option value="topcon">TOPCon</option>
                            <option value="hjt">HJT</option>
                            <option value="perc">PERC</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>

        <!-- BESS OPTIONS -->

        <div id="bessFields" class="dynamic-section">

            <h4 class="sub-title">BESS Configuration</h4>

            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Storage Duration</label>
                        <select id="duration" class="form-control">
                            <option value="">Select duration</option>
                            <option value="2">2 Hours</option>
                            <option value="4">4 Hours</option>
                            <option value="6">6 Hours</option>
                            <option value="8">8 Hours</option>
                        </select>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Battery Chemistry</label>
                        <select id="chemistry" class="form-control">
                            <option value="">Select chemistry</option>
                            <option value="lfp">LFP</option>
                            <option value="nmc">NMC</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>

        <!-- DATA CENTER OPTIONS -->

        <div id="dcFields" class="dynamic-section">

            <h4 class="sub-title">Data Center Configuration</h4>

            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Facility Tier</label>
                        <select id="tier" class="form-control">
                            <option value="">Select tier</option>
                            <option value="III">Tier III</option>
                            <option value="IV">Tier IV</option>
                        </select>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Cooling Technology</label>
                        <select id="cooling" class="form-control">
                            <option value="">Select cooling technology</option>
                            <option value="air">Air Cooling</option>
                            <option value="liquid">Liquid Cooling</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- MATERIAL PRICE REFERENCE -->

    <div class="panel-card">

        <h3 class="section-title">Material Price Reference</h3>

        <div class="material-note">
            Select a project type to view typical materials, estimated quantities
            and indicative unit prices. Material prices are reference values
            and are not added separately to the EPC cost calculation.
        </div>

        <div id="materialPlaceholder" class="muted">
            Please select a project type to view the relevant materials.
        </div>

        <div id="materialTable" style="display:none;">

            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>Material / Equipment</th>
                            <th>Estimated Quantity</th>
                            <th>Unit</th>
                            <th>Unit Price (€)</th>
                            <th>Reference Total (€)</th>
                        </tr>
                    </thead>

                    <tbody id="materialRows"></tbody>

                </table>

            </div>
        </div>

    </div>

    <!-- ACTION BUTTONS -->

    <div class="panel-card no-print">

        <div class="action-row">

            <button class="btn btn-main" onclick="calculateBudget()">
                <span class="glyphicon glyphicon-stats"></span>
                Calculate EPC Budget
            </button>

            <button class="btn btn-reset" onclick="resetCalculator()">
                Reset
            </button>

            <button class="btn btn-excel" onclick="downloadExcel()">
                <span class="glyphicon glyphicon-download-alt"></span>
                Download Excel
            </button>

            <button class="btn btn-reset" onclick="window.print()">
                <span class="glyphicon glyphicon-print"></span>
                Print / Save PDF
            </button>

        </div>

        <p id="errorMessage" class="text-danger" style="margin-top:12px;"></p>

    </div>

    <!-- RESULTS -->

    <div id="results" class="results">

        <div class="panel-card">

            <h3 class="section-title">Estimated EPC Budget</h3>

            <div class="total-summary">
                <span>Total Estimated EPC Cost</span>
                <strong id="totalCost">€0</strong>
            </div>

            <div class="result-grid">

                <div class="result-card">
                    <span>Estimated Cost per MW</span>
                    <strong id="costPerMW">€0</strong>
                </div>

                <div class="result-card">
                    <span>Project Capacity</span>
                    <strong id="capacityResult">0 MW</strong>
                </div>

            </div>

        </div>

        <div class="panel-card">

            <h3 class="section-title">EPC Cost Breakdown</h3>

            <div class="table-responsive">

                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th>Cost Category</th>
                            <th>Estimated Cost (€)</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>Civil Works</td>
                            <td id="civilCost">€0</td>
                        </tr>

                        <tr>
                            <td>Mechanical Works</td>
                            <td id="mechanicalCost">€0</td>
                        </tr>

                        <tr>
                            <td>Electrical Works</td>
                            <td id="electricalCost">€0</td>
                        </tr>

                        <tr>
                            <td>Additional Costs</td>
                            <td id="extraCost">€0</td>
                        </tr>

                        <tr class="total-row">
                            <td>Total EPC Cost</td>
                            <td id="breakdownTotal">€0</td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <p class="footer-note">
                This is a preliminary budget estimate. Final costs should be
                validated against project specifications, BOQs, supplier
                quotations, site conditions, grid connection requirements
                and contractor scope.
            </p>

        </div>

    </div>

</div>

<script>

// ==========================================
// COUNTRY LIST AND COST FACTORS
// ==========================================

const countryFactors = {
    IE:1.12, DE:1.08, FR:1.05, NL:1.07, BE:1.06,
    ES:0.94, PT:0.91, IT:1.00, GR:0.88, GB:1.13,
    US:1.18, CA:1.15, AU:1.16, JP:1.20, KR:1.10,
    IN:0.65, CN:0.72, BR:0.83, ZA:0.78, SA:0.96,
    AE:1.04, PL:0.84, RO:0.76, BG:0.72, TR:0.68,
    SE:1.12, NO:1.25, DK:1.14, FI:1.08
};

// Populate country dropdown

const countryNames = new Intl.DisplayNames(["en"], {
    type: "region"
});

const countries = [
    "IE","GB","DE","FR","NL","BE","ES","PT","IT","GR",
    "US","CA","AU","JP","KR","IN","CN","BR","ZA","SA",
    "AE","PL","RO","BG","TR","SE","NO","DK","FI","CH",
    "AT","CZ","HU","HR","SI","SK","LU","EE","LV","LT",
    "CY","MT","IS","NZ","MX","AR","CL","CO","EG","MA"
];

countries.sort((a,b) =>
    countryNames.of(a).localeCompare(countryNames.of(b))
);

countries.forEach(code => {

    const option = document.createElement("option");

    option.value = code;
    option.textContent = countryNames.of(code);

    document.getElementById("country").appendChild(option);

});


// ==========================================
// EPC COST RATES PER MW
// ==========================================

const projectRates = {

    solar: {
        civil: 110000,
        mechanical: 90000,
        electrical: 160000,
        extra: 0
    },

    bess: {
        civil: 70000,
        mechanical: 120000,
        electrical: 180000,
        extra: 180000
    },

    datacenter: {
        civil: 1200000,
        mechanical: 2400000,
        electrical: 3800000,
        extra: 0
    }

};


// ==========================================
// INDICATIVE MATERIAL PRICE REFERENCES
// Prices in EUR
// ==========================================

const materials = {

    solar: [

        ["PV Modules",1820,"pcs / MW",75],
        ["String Inverter",1,"unit / MW",18000],
        ["Mounting Structure",1820,"sets / MW",32],
        ["DC Cable",3000,"m / MW",1.40],
        ["AC Cable",600,"m / MW",8.50],
        ["DC Connectors",3640,"pcs / MW",2.50],
        ["MV Transformer",0.2,"unit / MW",65000],
        ["MV Switchgear",0.2,"unit / MW",28000],
        ["Monitoring System",1,"system / MW",2500],
        ["Access Roads",350,"m / MW",45],
        ["Fencing",180,"m / MW",22]

    ],

    bess: [

        ["Battery Container (5 MWh)",1,"container / 5 MWh",450000],
        ["Power Conversion System",1,"unit / MW",95000],
        ["MV Transformer",0.2,"unit / MW",65000],
        ["MV Switchgear",0.2,"unit / MW",28000],
        ["Battery Management System",1,"system / project",18000],
        ["Energy Management System",1,"system / project",35000],
        ["Fire Suppression System",1,"system / container",18000],
        ["HVAC System",1,"system / container",14000],
        ["DC Cables",150,"m / MWh",8],
        ["Foundations",12,"m³ / MWh",180]

    ],

    datacenter: [

        ["Server Racks",80,"units / MW",4500],
        ["UPS System",1,"system / MW",180000],
        ["Diesel Generator (2 MW)",0.5,"unit / MW",350000],
        ["MV Transformer",0.2,"unit / MW",85000],
        ["MV Switchgear",0.5,"unit / MW",45000],
        ["LV Switchboards",4,"units / MW",22000],
        ["Cooling System",1.2,"MW cooling / MW IT",95000],
        ["CRAH / CRAC Units",12,"units / MW",14000],
        ["Fire Protection System",2,"systems / MW",18000],
        ["Power Cables",1800,"m / MW",12],
        ["Fibre Optic Cables",2500,"m / MW",2.50],
        ["Concrete",350,"m³ / MW",180]

    ]

};


// ==========================================
// FORMAT CURRENCY
// ==========================================

function euro(value) {

    return new Intl.NumberFormat("en-IE", {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0
    }).format(value);

}


// ==========================================
// SHOW PROJECT-SPECIFIC FIELDS
// ==========================================

document.getElementById("projectType").addEventListener("change", function() {

    const type = this.value;

    const sections = [
        "commonFields",
        "solarFields",
        "bessFields",
        "dcFields"
    ];

    sections.forEach(id => {
        document.getElementById(id).style.display = "none";
    });

    document.getElementById("results").style.display = "none";

    if (type) {
        document.getElementById("commonFields").style.display = "block";
    }

    if (type === "solar") {

        document.getElementById("solarFields").style.display = "block";

        document.getElementById("capacityLabel").textContent =
            "Project Capacity (MW)";

    }

    if (type === "bess") {

        document.getElementById("bessFields").style.display = "block";

        document.getElementById("capacityLabel").textContent =
            "Power Capacity (MW)";

    }

    if (type === "datacenter") {

        document.getElementById("dcFields").style.display = "block";

        document.getElementById("capacityLabel").textContent =
            "IT Capacity (MW)";

    }

    showMaterials(type);

});


// ==========================================
// DISPLAY MATERIAL TABLE
// ==========================================

function showMaterials(type) {

    const placeholder =
        document.getElementById("materialPlaceholder");

    const table =
        document.getElementById("materialTable");

    const rows =
        document.getElementById("materialRows");

    rows.innerHTML = "";

    if (!type) {

        placeholder.style.display = "block";
        table.style.display = "none";

        return;

    }

    placeholder.style.display = "none";
    table.style.display = "block";

    materials[type].forEach(item => {

        const row = document.createElement("tr");

        const values = [
            item[0],
            item[1].toLocaleString("en-IE"),
            item[2],
            euro(item[3]),
            euro(item[1] * item[3])
        ];

        values.forEach(value => {

            const cell = document.createElement("td");
            cell.textContent = value;
            row.appendChild(cell);

        });

        rows.appendChild(row);

    });

}


// ==========================================
// CALCULATE EPC BUDGET
// ==========================================

let lastCalculation = null;

function calculateBudget() {

    const country = document.getElementById("country").value;

    const type = document.getElementById("projectType").value;

    const capacityInput =
        document.getElementById("capacity").value;

    const capacity = Number(capacityInput);

    const error =
        document.getElementById("errorMessage");

    error.textContent = "";

    // Validate general inputs

    if (!country || !type || capacityInput === "" ||
        !Number.isFinite(capacity) || capacity <= 0) {

        error.textContent =
            "Please select a country and project type and enter a valid capacity.";

        return;

    }

    // Validate Solar options

    if (type === "solar" &&
        (!document.getElementById("mounting").value ||
         !document.getElementById("moduleType").value)) {

        error.textContent =
            "Please select the Solar PV mounting system and module technology.";

        return;

    }

    // Validate BESS options

    if (type === "bess" &&
        (!document.getElementById("duration").value ||
         !document.getElementById("chemistry").value)) {

        error.textContent =
            "Please select BESS duration and battery chemistry.";

        return;

    }

    // Validate Data Center options

    if (type === "datacenter" &&
        (!document.getElementById("tier").value ||
         !document.getElementById("cooling").value)) {

        error.textContent =
            "Please select Data Center tier and cooling technology.";

        return;

    }

    // Apply country factor

    const countryFactor = countryFactors[country] || 1;

    const rates = projectRates[type];

    // Calculate cost categories

    const civil =
        capacity * rates.civil * countryFactor;

    const mechanical =
        capacity * rates.mechanical * countryFactor;

    const electrical =
        capacity * rates.electrical * countryFactor;

    const extra =
        capacity * rates.extra * countryFactor;

    const total =
        civil + mechanical + electrical + extra;

    const costPerMW = total / capacity;

    // Display results

    document.getElementById("civilCost").textContent =
        euro(civil);

    document.getElementById("mechanicalCost").textContent =
        euro(mechanical);

    document.getElementById("electricalCost").textContent =
        euro(electrical);

    document.getElementById("extraCost").textContent =
        euro(extra);

    document.getElementById("breakdownTotal").textContent =
        euro(total);

    document.getElementById("totalCost").textContent =
        euro(total);

    document.getElementById("costPerMW").textContent =
        euro(costPerMW);

    document.getElementById("capacityResult").textContent =
        capacity + " MW";

    // Store data for Excel export

    lastCalculation = {

        country: country,
        countryName:
            document.getElementById("country").selectedOptions[0].text,

        project: type,
        projectName:
            document.getElementById("projectType").selectedOptions[0].text,

        capacity: capacity,

        civil: civil,
        mechanical: mechanical,
        electrical: electrical,
        extra: extra,

        total: total,
        costPerMW: costPerMW

    };

    document.getElementById("results").style.display = "block";

    document.getElementById("results").scrollIntoView({
        behavior: "smooth",
        block: "start"
    });

}


// ==========================================
// DOWNLOAD EXCEL FILE
// ==========================================

function downloadExcel() {

    if (!lastCalculation) {

        alert("Please calculate the EPC budget first.");

        return;

    }

    if (typeof XLSX === "undefined") {

        alert("Excel library could not be loaded. Please check your internet connection.");

        return;

    }

    const data = lastCalculation;

    const workbook = XLSX.utils.book_new();

    // SHEET 1: EPC SUMMARY

    const summaryData = [

        ["EPC PROJECT BUDGET ESTIMATE"],

        [],

        ["PROJECT INFORMATION", "VALUE"],

        ["Country", data.countryName],

        ["Project Type", data.projectName],

        ["Project Capacity (MW)", data.capacity],

        [],

        ["EPC COST BREAKDOWN", "ESTIMATED COST (EUR)"],

        ["Civil Works", data.civil],

        ["Mechanical Works", data.mechanical],

        ["Electrical Works", data.electrical],

        ["Additional Costs", data.extra],

        ["TOTAL EPC COST", data.total],

        ["Estimated Cost per MW", data.costPerMW],

        [],

        ["Note", "Preliminary estimate based on indicative EPC rates."]

    ];

    const summarySheet =
        XLSX.utils.aoa_to_sheet(summaryData);

    summarySheet["!cols"] = [
        {wch: 32},
        {wch: 27}
    ];

    XLSX.utils.book_append_sheet(
        workbook,
        summarySheet,
        "EPC Summary"
    );


    // SHEET 2: MATERIAL REFERENCE

    const materialData = [

        [
            "Material / Equipment",
            "Estimated Quantity",
            "Unit",
            "Unit Price (EUR)",
            "Reference Total (EUR)"
        ]

    ];

    materials[data.project].forEach(item => {

        materialData.push([

            item[0],
            item[1],
            item[2],
            item[3],
            item[1] * item[3]

        ]);

    });

    const materialSheet =
        XLSX.utils.aoa_to_sheet(materialData);

    materialSheet["!cols"] = [
        {wch: 32},
        {wch: 20},
        {wch: 25},
        {wch: 20},
        {wch: 25}
    ];

    XLSX.utils.book_append_sheet(
        workbook,
        materialSheet,
        "Material Reference"
    );


    // DOWNLOAD FILE

    const filename =
        "EPC_Budget_" +
        data.project.toUpperCase() +
        "_" +
        data.country +
        "_" +
        data.capacity +
        "MW.xlsx";

    XLSX.writeFile(workbook, filename);

}


// ==========================================
// RESET CALCULATOR
// ==========================================

function resetCalculator() {

    const fields = [

        "country",
        "projectType",
        "capacity",
        "mounting",
        "moduleType",
        "duration",
        "chemistry",
        "tier",
        "cooling"

    ];

    fields.forEach(id => {

        document.getElementById(id).value = "";

    });

    const sections = [

        "commonFields",
        "solarFields",
        "bessFields",
        "dcFields"

    ];

    sections.forEach(id => {

        document.getElementById(id).style.display = "none";

    });

    document.getElementById("results").style.display = "none";

    document.getElementById("errorMessage").textContent = "";

    lastCalculation = null;

    showMaterials("");

}

</script>

</body>
</html>
