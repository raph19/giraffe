<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Solar PV EPC Budget Calculator</title>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
    * { box-sizing: border-box; }

    body {
        margin: 0;
        padding: 25px;
        background: #f3f5f8;
        color: #253247;
        font-family: Arial, Helvetica, sans-serif;
    }

    .container {
        max-width: 1250px;
        margin: auto;
    }

    h1 {
        color: #183153;
        margin-bottom: 8px;
    }

    .subtitle {
        color: #64748b;
        margin-bottom: 25px;
    }

    .panel {
        background: white;
        border-radius: 10px;
        padding: 22px;
        margin-bottom: 22px;
        box-shadow: 0 2px 9px rgba(0,0,0,0.06);
    }

    h2 {
        color: #183153;
        font-size: 19px;
        margin-top: 0;
        margin-bottom: 18px;
        border-bottom: 1px solid #e5eaf0;
        padding-bottom: 12px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 17px;
    }

    .field label {
        display: block;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 7px;
        color: #34445c;
    }

    input, select {
        width: 100%;
        padding: 11px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 14px;
        background: white;
        color: #253247;
    }

    input:focus, select:focus {
        outline: none;
        border-color: #2874c7;
        box-shadow: 0 0 0 2px rgba(40,116,199,0.12);
    }

    .help {
        display: block;
        color: #8491a3;
        font-size: 11px;
        margin-top: 5px;
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
    }

    button {
        border: none;
        border-radius: 6px;
        padding: 12px 20px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
    }

    .calculate {
        background: #1769aa;
        color: white;
    }

    .calculate:hover { background: #12568e; }

    .secondary {
        background: #e8edf3;
        color: #253247;
    }

    .secondary:hover { background: #dce4ed; }

    .result-highlight {
        background: #183153;
        color: white;
        padding: 23px;
        border-radius: 9px;
        margin-bottom: 20px;
    }

    .result-highlight .label {
        font-size: 14px;
        opacity: 0.85;
        margin-bottom: 8px;
    }

    .result-highlight .amount {
        font-size: 34px;
        font-weight: bold;
    }

    .result-highlight .unit {
        font-size: 13px;
        opacity: 0.8;
        margin-top: 8px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: #f4f7fb;
        border: 1px solid #e3eaf2;
        padding: 15px;
        border-radius: 8px;
    }

    .summary-card .name {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 7px;
    }

    .summary-card .value {
        font-size: 19px;
        font-weight: bold;
        color: #183153;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    th, td {
        padding: 12px 10px;
        border-bottom: 1px solid #e8edf2;
        text-align: left;
    }

    th {
        background: #f2f5f9;
        color: #34445c;
        font-weight: 700;
    }

    td.numeric, th.numeric {
        text-align: right;
    }

    .total-row {
        font-weight: bold;
        background: #f0f5fa;
    }

    .note {
        background: #fff8e8;
        border-left: 4px solid #e6a23c;
        padding: 13px 15px;
        font-size: 12px;
        line-height: 1.6;
        color: #695329;
        border-radius: 4px;
        margin-top: 15px;
    }

    .error {
        display: none;
        background: #fff0f0;
        color: #a12626;
        padding: 12px;
        border-radius: 6px;
        margin-top: 15px;
        font-size: 13px;
    }

    .section-description {
        color: #718096;
        font-size: 12px;
        margin-top: -10px;
        margin-bottom: 17px;
        line-height: 1.5;
    }

    .hidden { display: none; }

    @media(max-width: 850px) {
        .grid { grid-template-columns: repeat(2, 1fr); }
        .summary-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media(max-width: 550px) {
        body { padding: 12px; }
        .grid { grid-template-columns: 1fr; }
        .summary-grid { grid-template-columns: 1fr 1fr; }
        .result-highlight .amount { font-size: 26px; }
    }

    @media print {
        body { background: white; padding: 0; }
        .buttons { display: none; }
        .panel { box-shadow: none; border: 1px solid #ddd; }
    }
</style>
</head>

<body>

<div class="container">

    <h1>Solar PV EPC Budget Calculator</h1>
    <div class="subtitle">
        Preliminary utility-scale solar project cost estimation
    </div>

    <!-- PROJECT INPUTS -->

    <div class="panel">
        <h2>1. Project Information</h2>

        <div class="grid">

            <div class="field">
                <label for="country">Project Country</label>
                <select id="country">
                    <option value="">Select country</option>
                    <option value="Ireland">Ireland</option>
                    <option value="United Kingdom">United Kingdom</option>
                    <option value="Germany">Germany</option>
                    <option value="France">France</option>
                    <option value="Netherlands">Netherlands</option>
                    <option value="Belgium">Belgium</option>
                    <option value="Spain">Spain</option>
                    <option value="Portugal">Portugal</option>
                    <option value="Italy">Italy</option>
                    <option value="Greece">Greece</option>
                    <option value="Poland">Poland</option>
                    <option value="Romania">Romania</option>
                    <option value="Bulgaria">Bulgaria</option>
                    <option value="Sweden">Sweden</option>
                    <option value="Norway">Norway</option>
                    <option value="Denmark">Denmark</option>
                    <option value="Finland">Finland</option>
                    <option value="United States">United States</option>
                    <option value="Canada">Canada</option>
                    <option value="Australia">Australia</option>
                    <option value="Japan">Japan</option>
                    <option value="China">China</option>
                    <option value="India">India</option>
                    <option value="Brazil">Brazil</option>
                    <option value="South Africa">South Africa</option>
                    <option value="UAE">UAE</option>
                    <option value="Saudi Arabia">Saudi Arabia</option>
                </select>
            </div>

            <div class="field">
                <label for="capacity">Installed DC Capacity (MWp)</label>
                <input type="number" id="capacity" min="0" step="any"
                       placeholder="Enter MWp">
            </div>

            <div class="field">
                <label for="moduleWp">PV Module Power (Wp)</label>
                <input type="number" id="moduleWp" min="1" step="any"
                       placeholder="Enter module power">
                <span class="help">The total module quantity will be calculated automatically.</span>
            </div>

            <div class="field">
                <label for="technology">PV Module Technology</label>
                <select id="technology">
                    <option value="">Select technology</option>
                    <option value="topcon">TOPCon Monofacial</option>
                    <option value="bifacial">TOPCon Bifacial</option>
                    <option value="perc">PERC Monofacial</option>
                </select>
            </div>

            <div class="field">
                <label for="mounting">Mounting Structure</label>
                <select id="mounting">
                    <option value="">Select mounting type</option>
                    <option value="fixed">Fixed Tilt</option>
                    <option value="tracker">Single Axis Tracker</option>
                </select>
            </div>

            <div class="field">
                <label for="modulesPerString">Modules per String</label>
                <input type="number" id="modulesPerString" min="1" step="1"
                       placeholder="Enter modules per string">
            </div>

            <div class="field">
                <label for="inverters">Number of String Inverters</label>
                <input type="number" id="inverters" min="1" step="1"
                       placeholder="Enter inverter quantity">
            </div>

            <div class="field">
                <label for="substations">Number of MV Substations</label>
                <input type="number" id="substations" min="1" step="1"
                       placeholder="Enter MV substation quantity">
            </div>

        </div>

        <div class="buttons">
            <button class="calculate" onclick="calculateBudget()">
                Calculate EPC Budget
            </button>
            <button class="secondary" onclick="resetCalculator()">
                Reset
            </button>
            <button class="secondary" onclick="exportExcel()">
                Export to Excel
            </button>
            <button class="secondary" onclick="window.print()">
                Print
            </button>
        </div>

        <div id="error" class="error"></div>
    </div>


    <!-- RESULTS -->

    <div id="results" class="hidden">

        <div class="panel">

            <h2>2. EPC Cost Estimate</h2>

            <div class="result-highlight">
                <div class="label">Total Estimated EPC Cost</div>
                <div class="amount" id="totalEpc">€0</div>
                <div class="unit" id="epcPerMwp">€0 / MWp</div>
            </div>

            <div class="summary-grid">

                <div class="summary-card">
                    <div class="name">Calculated Module Quantity</div>
                    <div class="value" id="moduleQuantity">-</div>
                </div>

                <div class="summary-card">
                    <div class="name">Actual DC Capacity</div>
                    <div class="value" id="actualCapacity">-</div>
                </div>

                <div class="summary-card">
                    <div class="name">Calculated Number of Strings</div>
                    <div class="value" id="stringQuantity">-</div>
                </div>

                <div class="summary-card">
                    <div class="name">EPC Cost per Wp</div>
                    <div class="value" id="costPerWp">-</div>
                </div>

            </div>

            <h2>3. EPC Cost Breakdown</h2>

            <p class="section-description">
                All the following cost categories are included in the Total EPC Cost.
                The breakdown is an allocation of the total project budget, not an
                additional cost.
            </p>

            <table id="epcTable">
                <thead>
                    <tr>
                        <th>EPC Cost Category</th>
                        <th class="numeric">Estimated Cost (€)</th>
                        <th class="numeric">Share of EPC (%)</th>
                    </tr>
                </thead>
                <tbody id="epcBreakdown"></tbody>
            </table>

            <div class="note">
                The EPC estimate includes equipment procurement, installation,
                civil works, electrical works, engineering, project management,
                commissioning and the contingency allowance described in the
                assumptions. Actual EPC scope depends on the contract and grid
                connection requirements.
            </div>

        </div>


        <!-- MATERIALS -->

        <div class="panel">

            <h2>4. Materials and Equipment Breakdown</h2>

            <p class="section-description">
                Indicative procurement cost allocation for the main materials and
                equipment. These costs are already included in the EPC breakdown
                above. Do not add this table to the EPC total again.
            </p>

            <table id="materialsTable">
                <thead>
                    <tr>
                        <th>Material / Equipment</th>
                        <th class="numeric">Estimated Quantity</th>
                        <th class="numeric">Unit</th>
                        <th class="numeric">Estimated Cost (€)</th>
                    </tr>
                </thead>
                <tbody id="materialsBreakdown"></tbody>
            </table>

            <div class="note">
                Material quantities and costs are budgetary estimates. Cable lengths,
                cable cross-sections, transformer ratings, inverter models, structure
                design and supplier quotations must be confirmed during detailed
                engineering and procurement.
            </div>

        </div>


        <!-- ASSUMPTIONS -->

        <div class="panel">

            <h2>5. Pricing Assumptions</h2>

            <div id="assumptions"></div>

        </div>

    </div>

</div>


<script>

/*
==========================================================
COUNTRY MARKET DATA
==========================================================

Indicative bulk-procurement and EPC budget assumptions.
These are reference estimates, not live supplier quotations.

The country factor adjusts labour, installation, civil works,
logistics and local project costs.

Module prices are indicative bulk procurement prices in €/Wp.
==========================================================
*/

const countryData = {

    "Ireland": {
        factor: 1.00,
        modulePrice: 0.105
    },

    "United Kingdom": {
        factor: 1.06,
        modulePrice: 0.105
    },

    "Germany": {
        factor: 1.04,
        modulePrice: 0.105
    },

    "France": {
        factor: 1.00,
        modulePrice: 0.105
    },

    "Netherlands": {
        factor: 1.04,
        modulePrice: 0.105
    },

    "Belgium": {
        factor: 1.02,
        modulePrice: 0.105
    },

    "Spain": {
        factor: 0.88,
        modulePrice: 0.102
    },

    "Portugal": {
        factor: 0.86,
        modulePrice: 0.102
    },

    "Italy": {
        factor: 0.96,
        modulePrice: 0.105
    },

    "Greece": {
        factor: 0.84,
        modulePrice: 0.102
    },

    "Poland": {
        factor: 0.82,
        modulePrice: 0.103
    },

    "Romania": {
        factor: 0.74,
        modulePrice: 0.103
    },

    "Bulgaria": {
        factor: 0.72,
        modulePrice: 0.103
    },

    "Sweden": {
        factor: 1.07,
        modulePrice: 0.108
    },

    "Norway": {
        factor: 1.12,
        modulePrice: 0.108
    },

    "Denmark": {
        factor: 1.08,
        modulePrice: 0.108
    },

    "Finland": {
        factor: 1.06,
        modulePrice: 0.108
    },

    "United States": {
        factor: 1.15,
        modulePrice: 0.115
    },

    "Canada": {
        factor: 1.13,
        modulePrice: 0.115
    },

    "Australia": {
        factor: 1.12,
        modulePrice: 0.112
    },

    "Japan": {
        factor: 1.20,
        modulePrice: 0.115
    },

    "China": {
        factor: 0.65,
        modulePrice: 0.090
    },

    "India": {
        factor: 0.60,
        modulePrice: 0.095
    },

    "Brazil": {
        factor: 0.80,
        modulePrice: 0.105
    },

    "South Africa": {
        factor: 0.75,
        modulePrice: 0.105
    },

    "UAE": {
        factor: 0.94,
        modulePrice: 0.105
    },

    "Saudi Arabia": {
        factor: 0.91,
        modulePrice: 0.105
    }

};


/*
==========================================================
BASE COST ASSUMPTIONS
==========================================================

All figures are indicative budgetary rates.

Rates are in EUR and are adjusted by the selected country factor.
==========================================================
*/

const BASE_COSTS = {

    // Fixed-tilt mounting structure per MWp
    fixedMountingPerMWp: 48000,

    // Single-axis tracker structure per MWp
    trackerPerMWp: 72000,

    // Inverter procurement cost per unit
    inverterPerUnit: 18000,

    // MV substation package per unit
    mvSubstationPerUnit: 260000,

    // DC cabling and connectors per MWp
    dcCablingPerMWp: 18000,

    // AC LV cabling per MWp
    acCablingPerMWp: 12000,

    // MV cabling and accessories per MWp
    mvCablingPerMWp: 15000,

    // Civil works per MWp
    civilWorksPerMWp: 42000,

    // Installation labour per MWp
    installationPerMWp: 38000,

    // Engineering and project management per MWp
    engineeringPerMWp: 18000,

    // SCADA, monitoring and commissioning per MWp
    scadaCommissioningPerMWp: 8000,

    // Contingency applied to direct EPC costs
    contingencyPercentage: 5

};


/*
==========================================================
TECHNOLOGY PRICE ADJUSTMENTS
==========================================================
*/

const technologyFactors = {
    topcon: 1.00,
    bifacial: 1.025,
    perc: 0.96
};


/*
==========================================================
HELPER FUNCTIONS
==========================================================
*/

function euro(value) {

    return new Intl.NumberFormat("en-IE", {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0
    }).format(value);

}


function numberFormat(value, decimals = 0) {

    return new Intl.NumberFormat("en-IE", {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
    }).format(value);

}


function showError(message) {

    const error = document.getElementById("error");

    error.textContent = message;
    error.style.display = "block";

}


function clearError() {

    const error = document.getElementById("error");

    error.textContent = "";
    error.style.display = "none";

}


/*
==========================================================
MAIN CALCULATION
==========================================================
*/

let lastCalculation = null;


function calculateBudget() {

    clearError();

    const country = document.getElementById("country").value;

    const capacityMWp = Number(
        document.getElementById("capacity").value
    );

    const moduleWp = Number(
        document.getElementById("moduleWp").value
    );

    const technology = document.getElementById("technology").value;

    const mounting = document.getElementById("mounting").value;

    const modulesPerString = Number(
        document.getElementById("modulesPerString").value
    );

    const inverterCount = Number(
        document.getElementById("inverters").value
    );

    const substationCount = Number(
        document.getElementById("substations").value
    );


    // Validate required inputs

    if (!country) {
        showError("Please select the project country.");
        return;
    }

    if (!capacityMWp || capacityMWp <= 0) {
        showError("Please enter a valid installed DC capacity in MWp.");
        return;
    }

    if (!moduleWp || moduleWp <= 0) {
        showError("Please enter a valid PV module power in Wp.");
        return;
    }

    if (!technology) {
        showError("Please select the PV module technology.");
        return;
    }

    if (!mounting) {
        showError("Please select the mounting structure.");
        return;
    }

    if (!modulesPerString || modulesPerString <= 0 ||
        !Number.isInteger(modulesPerString)) {
        showError("Please enter a valid whole number of modules per string.");
        return;
    }

    if (!inverterCount || inverterCount <= 0 ||
        !Number.isInteger(inverterCount)) {
        showError("Please enter a valid number of inverters.");
        return;
    }

    if (!substationCount || substationCount <= 0 ||
        !Number.isInteger(substationCount)) {
        showError("Please enter a valid number of MV substations.");
        return;
    }


    const countryInfo = countryData[country];

    const countryFactor = countryInfo.factor;

    const technologyFactor = technologyFactors[technology];


    /*
    ------------------------------------------------------
    MODULE QUANTITY AND ACTUAL DC CAPACITY
    ------------------------------------------------------

    Module quantity is automatically calculated.

    Example formula:
    Number of modules = MWp × 1,000,000 / module Wp

    The calculator rounds up to the next whole module.
    ------------------------------------------------------
    */

    const calculatedModules = Math.ceil(
        (capacityMWp * 1000000) / moduleWp
    );

    const actualCapacityMWp =
        (calculatedModules * moduleWp) / 1000000;


    /*
    ------------------------------------------------------
    STRING CALCULATION
    ------------------------------------------------------
    */

    const stringCount = Math.ceil(
        calculatedModules / modulesPerString
    );

    const completeStrings = Math.floor(
        calculatedModules / modulesPerString
    );

    const remainingModules =
        calculatedModules % modulesPerString;


    /*
    ------------------------------------------------------
    MATERIAL COSTS
    ------------------------------------------------------
    */

    const modulePricePerWp =
        countryInfo.modulePrice * technologyFactor;

    const moduleCost =
        calculatedModules * moduleWp * modulePricePerWp;


    const mountingRate =
        mounting === "tracker"
            ? BASE_COSTS.trackerPerMWp
            : BASE_COSTS.fixedMountingPerMWp;

    const mountingCost =
        actualCapacityMWp * mountingRate * countryFactor;


    const inverterCost =
        inverterCount *
        BASE_COSTS.inverterPerUnit *
        countryFactor;


    const mvSubstationCost =
        substationCount *
        BASE_COSTS.mvSubstationPerUnit *
        countryFactor;


    const dcCablingCost =
        actualCapacityMWp *
        BASE_COSTS.dcCablingPerMWp *
        countryFactor;


    const acCablingCost =
        actualCapacityMWp *
        BASE_COSTS.acCablingPerMWp *
        countryFactor;


    const mvCablingCost =
        actualCapacityMWp *
        BASE_COSTS.mvCablingPerMWp *
        countryFactor;


    /*
    ------------------------------------------------------
    OTHER EPC COSTS
    ------------------------------------------------------
    */

    const civilWorksCost =
        actualCapacityMWp *
        BASE_COSTS.civilWorksPerMWp *
        countryFactor;


    const installationCost =
        actualCapacityMWp *
        BASE_COSTS.installationPerMWp *
        countryFactor;


    const engineeringCost =
        actualCapacityMWp *
        BASE_COSTS.engineeringPerMWp *
        countryFactor;


    const scadaCommissioningCost =
        actualCapacityMWp *
        BASE_COSTS.scadaCommissioningPerMWp *
        countryFactor;


    /*
    ------------------------------------------------------
    EPC DIRECT COST
    ------------------------------------------------------
    */

    const directCosts = {

        "PV Modules": moduleCost,

        "Mounting Structure": mountingCost,

        "String Inverters": inverterCost,

        "MV Substations": mvSubstationCost,

        "DC Cables and Connectors": dcCablingCost,

        "AC LV Cables": acCablingCost,

        "MV Cables and Accessories": mvCablingCost,

        "Civil Works": civilWorksCost,

        "Installation Labour": installationCost,

        "Engineering and Project Management": engineeringCost,

        "SCADA, Monitoring and Commissioning":
            scadaCommissioningCost

    };


    const directTotal = Object.values(directCosts).reduce(
        (sum, value) => sum + value,
        0
    );


    /*
    ------------------------------------------------------
    CONTINGENCY
    ------------------------------------------------------
    */

    const contingency =
        directTotal *
        BASE_COSTS.contingencyPercentage / 100;


    /*
    ------------------------------------------------------
    TOTAL EPC COST
    ------------------------------------------------------
    */

    const totalEPC = directTotal + contingency;

    const costPerMWp = totalEPC / actualCapacityMWp;

    const costPerWp = totalEPC / (actualCapacityMWp * 1000000);


    /*
    ------------------------------------------------------
    EPC BREAKDOWN TABLE
    ------------------------------------------------------
    */

    const epcBreakdown = document.getElementById("epcBreakdown");

    epcBreakdown.innerHTML = "";


    Object.entries(directCosts).forEach(([name, cost]) => {

        const percentage = (cost / totalEPC) * 100;

        epcBreakdown.innerHTML += `
            <tr>
                <td>${name}</td>
                <td class="numeric">${euro(cost)}</td>
                <td class="numeric">${numberFormat(percentage, 1)}%</td>
            </tr>
        `;

    });


    epcBreakdown.innerHTML += `
        <tr>
            <td>Contingency (${BASE_COSTS.contingencyPercentage}%)</td>
            <td class="numeric">${euro(contingency)}</td>
            <td class="numeric">${numberFormat(
                (contingency / totalEPC) * 100, 1
            )}%</td>
        </tr>

        <tr class="total-row">
            <td>TOTAL EPC COST</td>
            <td class="numeric">${euro(totalEPC)}</td>
            <td class="numeric">100.0%</td>
        </tr>
    `;


    /*
    ------------------------------------------------------
    MATERIALS TABLE
    ------------------------------------------------------

    This table is a more detailed view of material costs
    already included in the EPC breakdown.

    It is NOT added again to the total EPC cost.
    ------------------------------------------------------
    */

    const materials = [

        {
            name: "PV Modules",
            quantity: calculatedModules,
            unit: "Modules",
            cost: moduleCost
        },

        {
            name: "Mounting Structure",
            quantity: calculatedModules,
            unit: "Module positions",
            cost: mountingCost
        },

        {
            name: "String Inverters",
            quantity: inverterCount,
            unit: "Units",
            cost: inverterCost
        },

        {
            name: "MV Substations",
            quantity: substationCount,
            unit: "Units",
            cost: mvSubstationCost
        },

        {
            name: "DC Cables and Connectors",
            quantity: actualCapacityMWp,
            unit: "MWp allowance",
            cost: dcCablingCost
        },

        {
            name: "AC LV Cables",
            quantity: actualCapacityMWp,
            unit: "MWp allowance",
            cost: acCablingCost
        },

        {
            name: "MV Cables and Accessories",
            quantity: actualCapacityMWp,
            unit: "MWp allowance",
            cost: mvCablingCost
        },

        {
            name: "Civil Works",
            quantity: actualCapacityMWp,
            unit: "MWp allowance",
            cost: civilWorksCost
        },

        {
            name: "Installation Labour",
            quantity: actualCapacityMWp,
            unit: "MWp allowance",
            cost: installationCost
        },

        {
            name: "Engineering and Project Management",
            quantity: actualCapacityMWp,
            unit: "MWp allowance",
            cost: engineeringCost
        },

        {
            name: "SCADA and Commissioning",
            quantity: actualCapacityMWp,
            unit: "MWp allowance",
            cost: scadaCommissioningCost
        }

    ];


    const materialsBody =
        document.getElementById("materialsBreakdown");

    materialsBody.innerHTML = "";


    materials.forEach(item => {

        materialsBody.innerHTML += `
            <tr>
                <td>${item.name}</td>
                <td class="numeric">${numberFormat(item.quantity, 2)}</td>
                <td class="numeric">${item.unit}</td>
                <td class="numeric">${euro(item.cost)}</td>
            </tr>
        `;

    });


    materialsBody.innerHTML += `
        <tr class="total-row">
            <td colspan="3">Total Materials, Equipment and Direct EPC Costs</td>
            <td class="numeric">${euro(directTotal)}</td>
        </tr>
    `;


    /*
    ------------------------------------------------------
    UPDATE SUMMARY
    ------------------------------------------------------
    */

    document.getElementById("totalEpc").textContent =
        euro(totalEPC);

    document.getElementById("epcPerMwp").textContent =
        euro(costPerMWp) + " / MWp";

    document.getElementById("moduleQuantity").textContent =
        numberFormat(calculatedModules);

    document.getElementById("actualCapacity").textContent =
        numberFormat(actualCapacityMWp, 3) + " MWp";

    document.getElementById("stringQuantity").textContent =
        numberFormat(stringCount);

    document.getElementById("costPerWp").textContent =
        "€" + costPerWp.toFixed(3);


    /*
    ------------------------------------------------------
    ASSUMPTIONS
    ------------------------------------------------------
    */

    document.getElementById("assumptions").innerHTML = `

        <table>
            <tr>
                <td>Selected Country</td>
                <td class="numeric">${country}</td>
            </tr>

            <tr>
                <td>Country Cost Adjustment Factor</td>
                <td class="numeric">${countryFactor.toFixed(2)}</td>
            </tr>

            <tr>
                <td>PV Module Procurement Price</td>
                <td class="numeric">€${modulePricePerWp.toFixed(3)} / Wp</td>
            </tr>

            <tr>
                <td>Module Quantity Calculation</td>
                <td class="numeric">${numberFormat(calculatedModules)} modules</td>
            </tr>

            <tr>
                <td>String Configuration</td>
                <td class="numeric">
                    ${numberFormat(completeStrings)} complete strings
                    ${remainingModules > 0
                        ? " + " + remainingModules + " remaining modules"
                        : ""}
                </td>
            </tr>

            <tr>
                <td>Mounting Type</td>
                <td class="numeric">
                    ${mounting === "fixed" ? "Fixed Tilt" : "Single Axis Tracker"}
                </td>
            </tr>

            <tr>
                <td>Contingency Allowance</td>
                <td class="numeric">${BASE_COSTS.contingencyPercentage}%</td>
            </tr>

            <tr>
                <td>Actual DC Capacity</td>
                <td class="numeric">${numberFormat(actualCapacityMWp, 3)} MWp</td>
            </tr>

        </table>

        <div class="note">
            Country adjustment factors and unit rates are indicative planning
            assumptions for utility-scale projects. They are not live market
            quotations. Final prices depend on project size, technical
            specifications, procurement strategy, supplier negotiations,
            logistics, site conditions, grid connection scope and contract terms.
        </div>
    `;


    /*
    ------------------------------------------------------
    SAVE RESULTS FOR EXCEL EXPORT
    ------------------------------------------------------
    */

    lastCalculation = {

        country,
        capacityMWp,
        actualCapacityMWp,
        moduleWp,
        calculatedModules,
        modulesPerString,
        stringCount,
        completeStrings,
        remainingModules,
        inverterCount,
        substationCount,
        mounting,
        technology,
        countryFactor,
        modulePricePerWp,
        directCosts,
        directTotal,
        contingency,
        totalEPC,
        costPerMWp,
        costPerWp,
        materials

    };


    document.getElementById("results").classList.remove("hidden");

    document.getElementById("results").scrollIntoView({
        behavior: "smooth",
        block: "start"
    });

}


/*
==========================================================
EXCEL EXPORT
==========================================================
*/

function exportExcel() {

    if (!lastCalculation) {
        alert("Please calculate the EPC budget first.");
        return;
    }

    if (typeof XLSX === "undefined") {
        alert("Excel export library could not be loaded. Check your internet connection.");
        return;
    }

    const d = lastCalculation;

    const wb = XLSX.utils.book_new();


    // Project summary

    const summaryData = [

        ["SOLAR PV EPC BUDGET ESTIMATE"],

        [],

        ["Project Information", "Value"],

        ["Country", d.country],

        ["Input DC Capacity (MWp)", d.capacityMWp],

        ["Actual DC Capacity (MWp)", d.actualCapacityMWp],

        ["Module Power (Wp)", d.moduleWp],

        ["Calculated Module Quantity", d.calculatedModules],

        ["Modules per String", d.modulesPerString],

        ["Calculated Number of Strings", d.stringCount],

        ["Complete Strings", d.completeStrings],

        ["Remaining Modules", d.remainingModules],

        ["Number of Inverters", d.inverterCount],

        ["Number of MV Substations", d.substationCount],

        ["Mounting Type", d.mounting],

        ["PV Technology", d.technology],

        [],

        ["EPC Cost Summary", "EUR"],

        ["Direct EPC Costs", d.directTotal],

        ["Contingency", d.contingency],

        ["TOTAL EPC COST", d.totalEPC],

        ["EPC Cost per MWp", d.costPerMWp],

        ["EPC Cost per Wp", d.costPerWp]

    ];


    const wsSummary = XLSX.utils.aoa_to_sheet(summaryData);

    wsSummary["!cols"] = [
        { wch: 38 },
        { wch: 25 }
    ];

    XLSX.utils.book_append_sheet(
        wb,
        wsSummary,
        "Project Summary"
    );


    // EPC breakdown

    const epcData = [
        ["EPC Cost Category", "Estimated Cost (EUR)", "Share of EPC (%)"]
    ];


    Object.entries(d.directCosts).forEach(([name, cost]) => {

        epcData.push([
            name,
            cost,
            (cost / d.totalEPC) * 100
        ]);

    });


    epcData.push([
        "Contingency",
        d.contingency,
        (d.contingency / d.totalEPC) * 100
    ]);


    epcData.push([
        "TOTAL EPC COST",
        d.totalEPC,
        100
    ]);


    const wsEpc = XLSX.utils.aoa_to_sheet(epcData);

    wsEpc["!cols"] = [
        { wch: 42 },
        { wch: 24 },
        { wch: 20 }
    ];

    XLSX.utils.book_append_sheet(
        wb,
        wsEpc,
        "EPC Breakdown"
    );


    // Materials breakdown

    const materialData = [
        [
            "Material / Equipment",
            "Estimated Quantity",
            "Unit",
            "Estimated Cost (EUR)"
        ]
    ];


    d.materials.forEach(item => {

        materialData.push([
            item.name,
            item.quantity,
            item.unit,
            item.cost
        ]);

    });


    materialData.push([
        "Total Direct EPC Costs",
        "",
        "",
        d.directTotal
    ]);


    const wsMaterials = XLSX.utils.aoa_to_sheet(materialData);

    wsMaterials["!cols"] = [
        { wch: 42 },
        { wch: 22 },
        { wch: 20 },
        { wch: 25 }
    ];

    XLSX.utils.book_append_sheet(
        wb,
        wsMaterials,
        "Materials Breakdown"
    );


    XLSX.writeFile(
        wb,
        "Solar_PV_EPC_Budget_Estimate.xlsx"
    );

}


/*
==========================================================
RESET
==========================================================
*/

function resetCalculator() {

    document.getElementById("country").value = "";

    document.getElementById("capacity").value = "";

    document.getElementById("moduleWp").value = "";

    document.getElementById("technology").value = "";

    document.getElementById("mounting").value = "";

    document.getElementById("modulesPerString").value = "";

    document.getElementById("inverters").value = "";

    document.getElementById("substations").value = "";

    document.getElementById("results").classList.add("hidden");

    clearError();

    lastCalculation = null;

}

</script>

</body>
</html>
