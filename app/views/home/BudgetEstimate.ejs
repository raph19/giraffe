
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Budget Estimate Calculation</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #f3f6fa;
    font-family: Arial, sans-serif;
    color: #263445;
}

.welcome {
    background: linear-gradient(120deg, #102c46, #176b87);
    color: white;
    padding: 35px 25px;
    text-align: center;
}

.welcome h1 {
    font-size: 30px;
    font-weight: bold;
    margin-bottom: 10px;
}

.welcome p {
    color: #d5e6ef;
    font-size: 15px;
}

.main-container {
    max-width: 1150px;
    margin: 35px auto;
    padding: 0 20px;
}

.panel-custom {
    background: white;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 25px;
    box-shadow: 0 3px 15px rgba(0,0,0,.06);
}

.panel-custom h3 {
    margin-top: 0;
    margin-bottom: 25px;
    font-weight: bold;
    color: #174b68;
    border-bottom: 2px solid #edf1f5;
    padding-bottom: 15px;
}

label {
    font-weight: 600;
    margin-bottom: 8px;
}

.form-control {
    height: 43px;
    border-radius: 6px;
    border: 1px solid #d8e0e8;
    box-shadow: none;
}

.form-control:focus {
    border-color: #1683a5;
    box-shadow: 0 0 5px rgba(22,131,165,.2);
}

.btn-calculate {
    background: #087b9b;
    color: white;
    font-weight: bold;
    border: none;
    padding: 13px 35px;
    border-radius: 6px;
    font-size: 15px;
    margin-top: 15px;
}

.btn-calculate:hover {
    background: #075e78;
    color: white;
}

.result-card {
    background: linear-gradient(120deg, #123d58, #087b9b);
    color: white;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 25px;
}

.result-card h4 {
    color: #d6eaf2;
}

.result-card h2 {
    font-size: 34px;
    font-weight: bold;
    margin-bottom: 5px;
}

.table {
    margin-bottom: 0;
}

.table thead {
    background: #edf3f7;
}

.table th, .table td {
    padding: 13px !important;
    vertical-align: middle !important;
}

.total-row {
    font-weight: bold;
    background: #e8f3f7;
}

.hidden-results {
    display: none;
}

.note {
    color: #758493;
    font-size: 12px;
    margin-top: 12px;
}

footer {
    text-align: center;
    padding: 25px;
    color: #84919e;
}
</style>
</head>

<body>

<section id="welcome">
    <div class="welcome">
        <h1>Budget Estimate Calculator</h1>
        <p>Preliminary EPC Project Cost Estimation Tool</p>
    </div>
</section>

<div class="main-container">

    <!-- PROJECT INFORMATION -->

    <div class="panel-custom">

        <h3>Project Information</h3>

        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    <label>Country / Market</label>
                    <select id="country" class="form-control">
                        <option value="">Select Country</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Project Type</label>
                    <select id="projectType" class="form-control"
                        onchange="updateProjectOptions()">
                        <option value="">Select Project</option>
                        <option value="solar">Solar PV Project</option>
                        <option value="bess">BESS</option>
                        <option value="datacenter">Data Center</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label id="capacityLabel">Project Capacity (MW)</label>
                    <input type="number" id="capacity"
                        class="form-control" min="0.01" step="any"
                        placeholder="Enter capacity">
                </div>
            </div>

            <!-- SOLAR OPTIONS -->

            <div class="col-md-6" id="solarOptions" style="display:none;">
                <div class="form-group">
                    <label>PV Module Technology</label>
                    <select id="solarTechnology" class="form-control">
                        <option value="">Select Technology</option>
                        <option value="topcon_mono">N-type TOPCon Monofacial</option>
                        <option value="topcon_bifacial">N-type TOPCon Bifacial</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="modulePowerGroup" style="display:none;">
                <div class="form-group">
                    <label>PV Module Power (Wp)</label>
                    <select id="modulePower" class="form-control">
                        <option value="">Select Module Power</option>
                        <option value="450">450 Wp</option>
                        <option value="500">500 Wp</option>
                        <option value="550">550 Wp</option>
                        <option value="575">575 Wp</option>
                        <option value="600">600 Wp</option>
                        <option value="610">610 Wp</option>
                        <option value="620">620 Wp</option>
                        <option value="630">630 Wp</option>
                        <option value="650">650 Wp</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="mountingGroup" style="display:none;">
                <div class="form-group">
                    <label>Mounting System</label>
                    <select id="mountingType" class="form-control">
                        <option value="">Select Mounting System</option>
                        <option value="Fixed Tilt">Fixed Tilt</option>
                        <option value="Single Axis Tracker">Single Axis Tracker</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="stringsGroup" style="display:none;">
                <div class="form-group">
                    <label>Number of PV Strings</label>
                    <input type="number" id="stringCount"
                        class="form-control" min="1" step="1"
                        placeholder="Enter number of strings">
                </div>
            </div>

            <!-- BESS OPTIONS -->

            <div class="col-md-6" id="durationGroup" style="display:none;">
                <div class="form-group">
                    <label>BESS Duration (Hours)</label>
                    <input type="number" id="duration"
                        class="form-control" min="1" step="any"
                        placeholder="Enter duration">
                </div>
            </div>

            <div class="col-md-6" id="chemistryGroup" style="display:none;">
                <div class="form-group">
                    <label>Battery Chemistry</label>
                    <select id="batteryChemistry" class="form-control">
                        <option value="">Select Chemistry</option>
                        <option value="LFP">LFP</option>
                        <option value="NMC">NMC</option>
                    </select>
                </div>
            </div>

            <!-- DATA CENTER OPTIONS -->

            <div class="col-md-6" id="tierGroup" style="display:none;">
                <div class="form-group">
                    <label>Data Center Tier</label>
                    <select id="dataCenterTier" class="form-control">
                        <option value="">Select Tier</option>
                        <option value="Tier II">Tier II</option>
                        <option value="Tier III">Tier III</option>
                        <option value="Tier IV">Tier IV</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="coolingGroup" style="display:none;">
                <div class="form-group">
                    <label>Cooling System</label>
                    <select id="coolingType" class="form-control">
                        <option value="">Select Cooling</option>
                        <option value="Air Cooling">Air Cooling</option>
                        <option value="Liquid Cooling">Liquid Cooling</option>
                    </select>
                </div>
            </div>

        </div>

        <button class="btn btn-calculate" onclick="calculateBudget()">
            Calculate Budget
        </button>

        <button class="btn btn-calculate" onclick="resetCalculator()">
            Reset
        </button>

        <p class="note">
            Preliminary estimates based on indicative reference assumptions.
            EPC costs include equipment procurement, materials and installation.
        </p>

    </div>


    <!-- RESULTS -->

    <div id="results" class="hidden-results">

        <div class="result-card">
            <h4>Total Estimated EPC Cost</h4>
            <h2 id="totalBudget">€0</h2>
            <p id="projectSummary"></p>
            <p id="marketSummary"></p>
            <h4 id="costPerMW"></h4>
        </div>


        <!-- EPC COST BREAKDOWN -->

        <div class="panel-custom">

            <h3>EPC Cost Breakdown</h3>

            <div class="table-responsive">
                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th>Work Category</th>
                            <th>Base Cost (€)</th>
                            <th>Market Factor</th>
                            <th>Estimated Cost (€)</th>
                        </tr>
                    </thead>

                    <tbody id="costTable"></tbody>

                    <tfoot>
                        <tr class="total-row">
                            <td colspan="3">TOTAL EPC COST</td>
                            <td id="costTotal">€0</td>
                        </tr>
                    </tfoot>

                </table>
            </div>

            <p class="note">
                EPC cost includes engineering, equipment procurement,
                construction, installation and commissioning under the
                assumed turnkey project scope.
            </p>

        </div>


        <!-- MATERIAL REFERENCE -->

        <div class="panel-custom">

            <h3>Material / Equipment Reference</h3>

            <div class="table-responsive">
                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th>Material / Equipment</th>
                            <th>Estimated Quantity</th>
                            <th>Unit</th>
                            <th>Indicative Unit Price (€)</th>
                            <th>Reference Total (€)</th>
                        </tr>
                    </thead>

                    <tbody id="materialTable"></tbody>

                    <tfoot>
                        <tr class="total-row">
                            <td colspan="4">TOTAL MATERIAL REFERENCE VALUE</td>
                            <td id="materialTotal">€0</td>
                        </tr>
                    </tfoot>

                </table>
            </div>

            <p class="note">
                Material reference values are displayed separately.
                They are already represented within the EPC cost assumptions
                and are NOT added again to the EPC total.
            </p>

        </div>


        <button class="btn btn-calculate" onclick="exportExcel()">
            Download Excel
        </button>

        <button class="btn btn-calculate" onclick="window.print()">
            Print / Save as PDF
        </button>

    </div>

</div>

<footer>
    Budget Estimate Calculator | Preliminary EPC Estimation
</footer>


<script>

// =====================================
// 1. COUNTRIES
// =====================================

const countryCodes = `
AD AE AF AG AL AM AO AR AT AU AZ
BA BB BD BE BG BH BR BY CA CH CL CN
CO CR CY CZ DE DK DO DZ EC EE ES
FI FR GB GE GH GR HK HR HU ID IE IL
IN IS IT JP KE KR KW KZ LB LI LT LU
LV MA MC MD ME MK MT MX MY NG NL NO
NZ OM PA PE PH PK PL PT QA RO RS RU
SA SE SG SI SK TH TR TW UA US UY VN ZA
`;

const countrySelect = document.getElementById("country");

const displayNames = new Intl.DisplayNames(["en"], {
    type: "region"
});

countryCodes.trim().split(/\s+/).sort().forEach(code => {
    const option = document.createElement("option");
    option.value = code;
    option.textContent = displayNames.of(code);
    countrySelect.appendChild(option);
});


// =====================================
// 2. COUNTRY MARKET FACTORS
// =====================================

const countryRates = {
    IE: 1.12,
    DE: 1.08,
    FR: 1.05,
    NL: 1.07,
    BE: 1.06,
    ES: 0.94,
    PT: 0.91,
    IT: 1.00,
    GR: 0.88,
    GB: 1.13,
    US: 1.18,
    CA: 1.15,
    AU: 1.16,
    JP: 1.20,
    KR: 1.10,
    IN: 0.65,
    CN: 0.72,
    BR: 0.83,
    ZA: 0.78,
    SA: 0.96,
    AE: 1.04,
    PL: 0.84,
    RO: 0.76,
    BG: 0.72,
    TR: 0.68,
    SE: 1.12,
    NO: 1.25,
    DK: 1.14,
    FI: 1.08
};

const defaultMarketFactor = 1.00;


// =====================================
// 3. EPC RATES
// =====================================

// Illustrative base costs in EUR per MW.
// Procurement is included in these EPC assumptions.

const projectRates = {

    solar: {
        civil: 110000,
        mechanical: 90000,
        electrical: 160000
    },

    bess: {
        civil: 70000,
        mechanical: 120000,
        electrical: 180000,
        batteryPerMWh: 180000
    },

    datacenter: {
        civil: 1200000,
        mechanical: 2400000,
        electrical: 3800000
    }

};


// =====================================
// 4. PV MODULE PRICING
// =====================================

// Indicative reference prices in EUR/Wp.
// These are editable assumptions, not supplier quotations.

const moduleOptions = {

    topcon_mono: {
        name: "N-type TOPCon Monofacial",
        pricePerWp: 0.120
    },

    topcon_bifacial: {
        name: "N-type TOPCon Bifacial",
        pricePerWp: 0.114
    }

};


// =====================================
// 5. UPDATE PROJECT OPTIONS
// =====================================

function updateProjectOptions() {

    const type = document.getElementById("projectType").value;

    const groups = [
        "solarOptions",
        "modulePowerGroup",
        "mountingGroup",
        "stringsGroup",
        "durationGroup",
        "chemistryGroup",
        "tierGroup",
        "coolingGroup"
    ];

    groups.forEach(id => {
        document.getElementById(id).style.display = "none";
    });

    const label = document.getElementById("capacityLabel");

    if (type === "solar") {

        label.textContent = "Solar PV Capacity (MWp)";

        document.getElementById("solarOptions").style.display = "block";
        document.getElementById("modulePowerGroup").style.display = "block";
        document.getElementById("mountingGroup").style.display = "block";
        document.getElementById("stringsGroup").style.display = "block";

    }

    else if (type === "bess") {

        label.textContent = "BESS Power Capacity (MW)";

        document.getElementById("durationGroup").style.display = "block";
        document.getElementById("chemistryGroup").style.display = "block";

    }

    else if (type === "datacenter") {

        label.textContent = "IT Load Capacity (MW)";

        document.getElementById("tierGroup").style.display = "block";
        document.getElementById("coolingGroup").style.display = "block";

    }

    else {

        label.textContent = "Project Capacity (MW)";

    }

}


// =====================================
// 6. FORMATTING
// =====================================

function formatNumber(value) {

    return new Intl.NumberFormat("en-IE", {
        maximumFractionDigits: 2
    }).format(value);

}

function formatMoney(value) {

    return new Intl.NumberFormat("en-IE", {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0
    }).format(value);

}


// =====================================
// 7. MATERIAL REFERENCE DATA
// =====================================

function getMaterials(type, capacity, duration, options = {}) {

    let materials = [];

    if (type === "solar") {

        const moduleOption = moduleOptions[options.moduleTechnology];

        const modulePower = options.modulePower;

        // Number of modules required for the selected MWp capacity.
        // Rounded up to the next complete module.

        const totalModules = Math.ceil(
            capacity * 1000000 / modulePower
        );

        const strings = options.stringCount;

        const modulesPerString = totalModules / strings;

        // Price per module = module Wp x indicative EUR/Wp.

        const modulePrice =
            moduleOption.pricePerWp * modulePower;

        materials = [

            [
                "PV Modules - " + moduleOption.name + " (" + modulePower + " Wp)",
                totalModules,
                "pcs",
                modulePrice
            ],

            [
                "PV Strings",
                strings,
                "strings",
                0
            ],

            [
                "Average Modules per String",
                modulesPerString,
                "modules/string",
                0
            ],

            [
                "String Inverters",
                capacity,
                "units (approx.)",
                18000
            ],

            [
                "Mounting Structures",
                totalModules,
                "sets",
                32
            ],

            [
                "DC Cables",
                capacity * 3000,
                "m",
                1.40
            ],

            [
                "AC Cables",
                capacity * 600,
                "m",
                8.50
            ],

            [
                "DC Connectors",
                totalModules * 2,
                "pcs",
                2.50
            ],

            [
                "MV Transformers",
                capacity / 5,
                "units",
                65000
            ],

            [
                "MV Switchgear",
                capacity / 5,
                "units",
                28000
            ],

            [
                "Monitoring System",
                capacity,
                "MW",
                2500
            ],

            [
                "Access Roads",
                capacity * 350,
                "m",
                45
            ],

            [
                "Fencing",
                capacity * 180,
                "m",
                22
            ],

            [
                "Foundations",
                totalModules,
                "pcs",
                35
            ],

            [
                "Drainage System",
                capacity * 250,
                "m",
                18
            ]

        ];

    }


    else if (type === "bess") {

        const energy = capacity * duration;

        const containers = energy / 5;

        materials = [

            ["Battery Energy Capacity", energy, "MWh", 0],

            ["Battery Containers (5 MWh)", containers, "units", 450000],

            ["Battery Racks (approx.)", energy * 40, "units", 3500],

            ["Battery Modules (approx.)", energy * 800, "units", 450],

            ["Power Conversion System", capacity, "MW", 95000],

            ["PCS Units (2.5 MW)", capacity / 2.5, "units", 95000],

            ["MV Transformers", capacity / 5, "units", 65000],

            ["MV Switchgear", capacity / 5, "units", 28000],

            ["HV Cables", capacity * 250, "m", 25],

            ["DC Cables", energy * 150, "m", 8],

            ["EMS System", 1, "system", 35000],

            ["Battery Management System", 1, "system", 18000],

            ["Fire Suppression System", containers, "systems", 18000],

            ["HVAC Systems", containers, "systems", 14000],

            ["Concrete Foundations", energy * 12, "m³", 180],

            ["Access Roads", capacity * 100, "m", 45],

            ["Drainage System", capacity * 80, "m", 18]

        ];

    }


    else if (type === "datacenter") {

        materials = [

            ["Server Racks", capacity * 80, "units", 4500],

            ["UPS Systems", capacity, "systems", 180000],

            ["UPS Modules (1 MW)", capacity, "units", 85000],

            ["Generators (2 MW)", capacity / 2, "units", 350000],

            ["MV Transformers (5 MW)", capacity / 5, "units", 85000],

            ["MV Switchgear", capacity / 2, "units", 45000],

            ["LV Switchboards", capacity * 4, "units", 22000],

            ["Cooling Capacity", capacity * 1.2, "MW thermal", 95000],

            ["CRAH / CRAC Units", capacity * 12, "units", 14000],

            ["Cooling Pumps", capacity * 4, "units", 12000],

            ["Chillers", capacity * 1.2 / 3, "units", 65000],

            ["Fire Suppression Systems", capacity * 2, "systems", 18000],

            ["Power Cables", capacity * 1800, "m", 12],

            ["Fiber Optic Cables", capacity * 2500, "m", 2.50],

            ["Cable Trays", capacity * 900, "m", 18],

            ["Concrete", capacity * 350, "m³", 180],

            ["Steel Structure", capacity * 120, "tonnes", 1800],

            ["Raised Floor", capacity * 250, "m²", 65]

        ];

    }

    return materials;

}


// =====================================
// 8. MAIN CALCULATION
// =====================================

let lastCalculation = null;

function calculateBudget() {

    const country = document.getElementById("country").value;

    const type = document.getElementById("projectType").value;

    const capacity = Number(
        document.getElementById("capacity").value
    );

    const duration = Number(
        document.getElementById("duration").value
    );

    if (
        !country ||
        !type ||
        !Number.isFinite(capacity) ||
        capacity <= 0
    ) {

        alert("Please select a country, project type and valid capacity.");
        return;

    }


    // SOLAR INPUTS

    let moduleTechnology = "";
    let modulePower = 0;
    let stringCount = 0;
    let mountingType = "";

    if (type === "solar") {

        moduleTechnology =
            document.getElementById("solarTechnology").value;

        modulePower = Number(
            document.getElementById("modulePower").value
        );

        mountingType =
            document.getElementById("mountingType").value;

        stringCount = Number(
            document.getElementById("stringCount").value
        );

        if (
            !moduleTechnology ||
            !modulePower ||
            !mountingType ||
            !Number.isInteger(stringCount) ||
            stringCount <= 0
        ) {

            alert("Please select module technology, module power, mounting system and enter a valid number of strings.");
            return;

        }

    }


    // BESS VALIDATION

    if (type === "bess") {

        if (
            !Number.isFinite(duration) ||
            duration <= 0 ||
            !document.getElementById("batteryChemistry").value
        ) {

            alert("Please enter BESS duration and select battery chemistry.");
            return;

        }

    }


    // DATA CENTER VALIDATION

    if (type === "datacenter") {

        if (
            !document.getElementById("dataCenterTier").value ||
            !document.getElementById("coolingType").value
        ) {

            alert("Please select Data Center Tier and Cooling System.");
            return;

        }

    }


    // MARKET FACTOR

    const factor = countryRates[country] ?? defaultMarketFactor;

    const rates = projectRates[type];


    // BASE EPC COSTS

    const baseCivil = capacity * rates.civil;

    const baseMechanical = capacity * rates.mechanical;

    const baseElectrical = capacity * rates.electrical;


    // BESS BATTERY EQUIPMENT PROCUREMENT

    const batteryEquipment = type === "bess"
        ? capacity * duration * rates.batteryPerMWh
        : 0;


    // TOTAL EPC COST
    // Procurement is included in the EPC assumptions.

    const total =
        (baseCivil + baseMechanical + baseElectrical + batteryEquipment)
        * factor;

    const costPerMW = total / capacity;


    // =====================================
    // COST BREAKDOWN
    // =====================================

    const costs = [

        ["Civil Works & Infrastructure", baseCivil],

        ["Mechanical Works & Equipment Procurement", baseMechanical],

        ["Electrical Works & Equipment Procurement", baseElectrical]

    ];

    if (type === "bess") {

        costs.push([
            "Battery Equipment Procurement",
            batteryEquipment
        ]);

    }


    const costTable = document.getElementById("costTable");

    costTable.innerHTML = "";

    costs.forEach(item => {

        const finalCost = item[1] * factor;

        costTable.innerHTML += `
            <tr>
                <td>${item[0]}</td>
                <td>${formatMoney(item[1])}</td>
                <td>${factor.toFixed(2)}</td>
                <td>${formatMoney(finalCost)}</td>
            </tr>
        `;

    });


    document.getElementById("costTotal").textContent =
        formatMoney(total);

    document.getElementById("totalBudget").textContent =
        formatMoney(total);

    document.getElementById("costPerMW").textContent =
        "Estimated EPC Cost per MW: " + formatMoney(costPerMW);


    // =====================================
    // PROJECT SUMMARY
    // =====================================

    const projectNames = {

        solar: "Solar PV Project",

        bess: "Battery Energy Storage System",

        datacenter: "Data Center"

    };

    let projectDetails = projectNames[type];

    if (type === "solar") {

        projectDetails +=
            " | " + moduleOptions[moduleTechnology].name +
            " | " + modulePower + " Wp modules" +
            " | " + mountingType +
            " | " + formatNumber(stringCount) + " strings";

    }

    if (type === "bess") {

        projectDetails +=
            " | " +
            document.getElementById("batteryChemistry").value;

    }

    if (type === "datacenter") {

        projectDetails +=
            " | " +
            document.getElementById("dataCenterTier").value +
            " | " +
            document.getElementById("coolingType").value;

    }


    document.getElementById("projectSummary").textContent =
        projectDetails + " | " + formatNumber(capacity) + " MW";

    document.getElementById("marketSummary").textContent =
        "Market: " + displayNames.of(country) +
        " | Market Factor: " + factor.toFixed(2) +
        (type === "bess"
            ? " | Duration: " + duration + " hours"
            : "");


    // =====================================
    // MATERIAL REFERENCE
    // =====================================

    const materials = getMaterials(
        type,
        capacity,
        duration,
        {
            moduleTechnology,
            modulePower,
            stringCount
        }
    );

    const materialTable = document.getElementById("materialTable");

    materialTable.innerHTML = "";

    let materialTotal = 0;

    materials.forEach(item => {

        const referenceTotal = item[1] * item[3];

        materialTotal += referenceTotal;

        materialTable.innerHTML += `
            <tr>
                <td>${item[0]}</td>
                <td>${formatNumber(item[1])}</td>
                <td>${item[2]}</td>
                <td>${formatMoney(item[3])}</td>
                <td>${formatMoney(referenceTotal)}</td>
            </tr>
        `;

    });


    document.getElementById("materialTotal").textContent =
        formatMoney(materialTotal);


    // =====================================
    // SAVE CALCULATION FOR EXCEL
    // =====================================

    lastCalculation = {

        country,
        countryName: displayNames.of(country),
        type,
        projectDetails,
        capacity,
        duration: type === "bess" ? duration : "",
        modulePower: type === "solar" ? modulePower : "",
        moduleTechnology: type === "solar"
            ? moduleOptions[moduleTechnology].name
            : "",
        stringCount: type === "solar" ? stringCount : "",
        mountingType: type === "solar" ? mountingType : "",
        factor,
        costs,
        total,
        costPerMW,
        materials,
        materialTotal

    };


    document.getElementById("results").style.display = "block";

    document.getElementById("results").scrollIntoView({
        behavior: "smooth"
    });

}


// =====================================
// 9. EXCEL EXPORT
// =====================================

function exportExcel() {

    if (!lastCalculation) {

        alert("Please calculate the project budget first.");
        return;

    }

    if (typeof XLSX === "undefined") {

        alert("Excel export requires an internet connection.");
        return;

    }

    const data = lastCalculation;


    // EPC SUMMARY SHEET

    const summaryRows = [

        ["EPC BUDGET ESTIMATE"],

        [],

        ["Project Information", "Value"],

        ["Country", data.countryName],

        ["Project Type", data.projectDetails],

        ["Capacity (MW)", data.capacity],

        ["PV Module Technology", data.moduleTechnology],

        ["PV Module Power (Wp)", data.modulePower],

        ["Number of PV Strings", data.stringCount],

        ["Mounting System", data.mountingType],

        ["BESS Duration (Hours)", data.duration],

        ["Market Factor", data.factor],

        [],

        ["EPC Cost Breakdown"],

        ["Work Category", "Base Cost (€)", "Market Factor", "Estimated Cost (€)"]

    ];


    data.costs.forEach(item => {

        summaryRows.push([

            item[0],

            item[1],

            data.factor,

            item[1] * data.factor

        ]);

    });


    summaryRows.push([]);

    summaryRows.push([

        "TOTAL EPC COST",

        "",

        "",

        data.total

    ]);

    summaryRows.push([

        "EPC COST PER MW",

        data.costPerMW

    ]);

    summaryRows.push([]);

    summaryRows.push([

        "Procurement is included in the EPC cost assumptions."

    ]);

    summaryRows.push([

        "Material reference values are displayed separately and are not added again."

    ]);


    const summarySheet = XLSX.utils.aoa_to_sheet(summaryRows);


    // MATERIAL REFERENCE SHEET

    const materialRows = [

        [

            "Material / Equipment",

            "Estimated Quantity",

            "Unit",

            "Indicative Unit Price (€)",

            "Reference Total (€)"

        ]

    ];


    data.materials.forEach(item => {

        materialRows.push([

            item[0],

            item[1],

            item[2],

            item[3],

            item[1] * item[3]

        ]);

    });


    materialRows.push([]);

    materialRows.push([

        "TOTAL MATERIAL REFERENCE VALUE",

        "",

        "",

        "",

        data.materialTotal

    ]);


    const materialSheet = XLSX.utils.aoa_to_sheet(materialRows);


    // CREATE WORKBOOK

    const workbook = XLSX.utils.book_new();

    XLSX.utils.book_append_sheet(
        workbook,
        summarySheet,
        "EPC Summary"
    );

    XLSX.utils.book_append_sheet(
        workbook,
        materialSheet,
        "Material Reference"
    );


    const filename =
        "EPC_Budget_" +
        data.country +
        "_" +
        data.type +
        "_" +
        data.capacity +
        "MW.xlsx";

    XLSX.writeFile(workbook, filename);

}


// =====================================
// 10. RESET
// =====================================

function resetCalculator() {

    document.getElementById("country").value = "";

    document.getElementById("projectType").value = "";

    document.getElementById("capacity").value = "";

    document.getElementById("duration").value = "";

    document.getElementById("stringCount").value = "";

    document.getElementById("solarTechnology").value = "";

    document.getElementById("modulePower").value = "";

    document.getElementById("mountingType").value = "";

    document.getElementById("batteryChemistry").value = "";

    document.getElementById("dataCenterTier").value = "";

    document.getElementById("coolingType").value = "";

    document.getElementById("results").style.display = "none";

    document.getElementById("capacityLabel").textContent =
        "Project Capacity (MW)";

    updateProjectOptions();

    lastCalculation = null;

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

}

</script>

