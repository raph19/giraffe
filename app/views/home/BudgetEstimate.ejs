
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Budget Estimate Calculator</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet"
          href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">

    <style>
        body {
            background: #f4f6f9;
            font-family: Arial, sans-serif;
            color: #333;
        }

        .welcome {
            background: linear-gradient(120deg, #174b70, #278c91);
            color: white;
            padding: 35px 15px;
            text-align: center;
            margin-bottom: 30px;
        }

        .welcome h2 {
            margin: 0 0 10px;
            font-weight: bold;
        }

        .main-container {
            max-width: 1100px;
            margin: auto;
            padding: 0 15px 40px;
        }

        .panel-box {
            background: white;
            padding: 25px;
            margin-bottom: 25px;
            border-radius: 6px;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
        }

        .panel-box h3 {
            color: #174b70;
            margin-top: 0;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .form-control {
            height: 40px;
        }

        .btn-calculate {
            background: #174b70;
            color: white;
            border: none;
            padding: 12px 35px;
            font-size: 16px;
            border-radius: 4px;
        }

        .btn-calculate:hover {
            background: #236b91;
            color: white;
        }

        .results {
            display: none;
        }

        .summary {
            background: #eaf3f7;
            padding: 20px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .summary h2 {
            color: #174b70;
            font-weight: bold;
            margin: 5px 0;
        }

        .summary-item {
            padding: 12px;
            background: white;
            border-radius: 4px;
            margin-bottom: 10px;
            text-align: center;
        }

        .summary-item strong {
            display: block;
            color: #174b70;
            font-size: 18px;
            margin-top: 7px;
        }

        .table th {
            background: #174b70;
            color: white;
        }

        .table td, .table th {
            vertical-align: middle !important;
        }

        .total-row {
            background: #eaf3f7;
            font-weight: bold;
        }

        .note {
            color: #777;
            font-size: 12px;
            margin-top: 12px;
        }

        .hidden-option {
            display: none;
        }

        @media print {
            .btn-calculate, #calculateButton, .no-print {
                display: none !important;
            }

            body {
                background: white;
            }

            .panel-box {
                box-shadow: none;
                border: 1px solid #ddd;
            }

            .results {
                display: block !important;
            }
        }
    </style>
</head>

<body>

<section class="welcome">
    <h2>Budget Estimate Calculator</h2>
    <p>Preliminary EPC cost estimation for Solar PV, BESS and Data Center projects</p>
</section>

<div class="main-container">

    <div class="panel-box">
        <h3>Project Information</h3>

        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    <label>Country</label>
                    <select id="country" class="form-control"></select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Project Type</label>
                    <select id="projectType" class="form-control">
                        <option value="solar">Solar PV</option>
                        <option value="bess">BESS</option>
                        <option value="datacenter">Data Center</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Project Capacity (MW)</label>
                    <input type="number" id="capacity" class="form-control"
                           min="0.1" step="0.1" value="10">
                </div>
            </div>

            <div class="col-md-6 hidden-option" id="durationGroup">
                <div class="form-group">
                    <label>BESS Duration (Hours)</label>
                    <select id="duration" class="form-control">
                        <option value="2">2 Hours</option>
                        <option value="4" selected>4 Hours</option>
                        <option value="6">6 Hours</option>
                        <option value="8">8 Hours</option>
                    </select>
                </div>
            </div>

        </div>

        <hr>

        <h3>Technology Selection</h3>

        <!-- Solar options -->
        <div id="solarOptions">
            <div class="row">

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Inverter Type</label>
                        <select id="inverterType" class="form-control">
                            <option value="string">String Inverter</option>
                            <option value="central">Central Inverter</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Mounting Structure</label>
                        <select id="structureType" class="form-control">
                            <option value="fixed">Fixed Structure</option>
                            <option value="tracker">Single Axis Tracker</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Combiner Boxes</label>
                        <select id="combinerBoxes" class="form-control">
                            <option value="yes">Yes</option>
                            <option value="no">No</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>

        <!-- BESS options -->
        <div id="bessOptions" class="hidden-option">
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Battery Chemistry</label>
                        <select id="batteryType" class="form-control">
                            <option value="lfp">LFP</option>
                            <option value="nmc">NMC</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Cooling System</label>
                        <select id="coolingType" class="form-control">
                            <option value="liquid">Liquid Cooling</option>
                            <option value="air">Air Cooling</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>

        <!-- Data Center options -->
        <div id="dcOptions" class="hidden-option">
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Data Center Tier</label>
                        <select id="tierType" class="form-control">
                            <option value="3">Tier III</option>
                            <option value="4">Tier IV</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Cooling Technology</label>
                        <select id="dcCooling" class="form-control">
                            <option value="air">Air Cooling</option>
                            <option value="liquid">Liquid Cooling</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>

        <br>

        <button id="calculateButton" class="btn btn-calculate"
                onclick="calculateBudget()">
            Calculate Budget
        </button>

    </div>

    <!-- RESULTS -->
    <div id="results" class="results">

        <div class="panel-box">
            <h3>Project Cost Summary</h3>

            <div class="summary">
                <div class="row">

                    <div class="col-md-4">
                        <div class="summary-item">
                            Civil Works
                            <strong id="civilTotal">€0</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            Mechanical Works
                            <strong id="mechanicalTotal">€0</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            Electrical Works
                            <strong id="electricalTotal">€0</strong>
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">
                        <div class="summary-item">
                            Material & Equipment
                            <strong id="materialTotal">€0</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="summary-item">
                            Combined Indicative Budget
                            <strong id="grandTotal">€0</strong>
                        </div>
                    </div>

                </div>
            </div>

            <p id="projectDescription"></p>
        </div>

        <div class="panel-box">
            <h3>Material & Equipment Breakdown</h3>

            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Material / Equipment</th>
                            <th>Quantity</th>
                            <th>Unit</th>
                            <th>Unit Rate (€)</th>
                            <th>Total Cost (€)</th>
                        </tr>
                    </thead>

                    <tbody id="materialTable"></tbody>

                    <tfoot>
                        <tr class="total-row">
                            <td colspan="4" class="text-right">
                                Total Material & Equipment Cost
                            </td>
                            <td id="tableTotal">€0</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <p class="note">
                Material rates are indicative starting assumptions and can be
                edited in the JavaScript section of this calculator.
            </p>
        </div>

        <div class="panel-box">
            <h3>Cost Estimation Assumptions</h3>

            <p>
                Civil, Mechanical and Electrical figures represent separate
                indicative works allowances. Material and equipment costs are
                added separately to calculate the combined budget.
            </p>

            <p>
                The country factors are broad market adjustment assumptions.
                They are not supplier quotations or verified country-specific
                market prices.
            </p>

            <p class="note">
                This calculator is intended for preliminary budgeting only.
                A project-specific BOQ, technical design, supplier quotations,
                grid requirements, taxes, land, development costs and
                contingency should be reviewed before approving an EPC budget.
            </p>

            <button class="btn btn-default no-print" onclick="window.print()">
                Print Estimate
            </button>
        </div>

    </div>

</div>

<script>

// --------------------------------------------------
// COUNTRY LIST
// --------------------------------------------------

const countryCodes = `
AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ
BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT
BV BW BY BZ CA CC CD CF CG CH CI CK CL CM CN CO CR
CU CV CW CX CY CZ DE DJ DK DM DO DZ EC EE EG EH ER
ES ET FI FJ FK FM FO FR GA GB GD GE GF GG GH GI GL
GM GN GP GQ GR GS GT GU GW GY HK HM HN HR HT HU
ID IE IL IM IN IO IQ IR IS IT JE JM JO JP KE KG KH
KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU
LV LY MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR
MS MT MU MV MW MX MY MZ NA NC NE NF NG NI NL NO NP
NR NU NZ OM PA PE PF PG PH PK PL PM PN PR PS PT PW
PY QA RE RO RS RU RW SA SB SC SD SE SG SH SI SJ SK
SL SM SN SO SR SS ST SV SX SY SZ TC TD TF TG TH TJ
TK TL TM TN TO TR TT TV TW TZ UA UG UM US UY UZ VA
VC VE VG VI VN VU WF WS YE YT ZA ZM ZW
`.trim().split(/\s+/);

const countryNames = new Intl.DisplayNames(['en'], {
    type: 'region'
});

const countrySelect = document.getElementById('country');

countryCodes
    .map(code => ({
        code,
        name: countryNames.of(code)
    }))
    .filter(country => country.name && country.name !== country.code)
    .sort((a, b) => a.name.localeCompare(b.name))
    .forEach(country => {
        const option = document.createElement('option');
        option.value = country.code;
        option.textContent = country.name;
        countrySelect.appendChild(option);
    });

countrySelect.value = 'IE';


// --------------------------------------------------
// COUNTRY MARKET FACTORS
// --------------------------------------------------

const countryFactors = {
    IE: { civil: 1.12, mechanical: 1.12, electrical: 1.12 },
    GB: { civil: 1.13, mechanical: 1.13, electrical: 1.13 },
    DE: { civil: 1.08, mechanical: 1.08, electrical: 1.08 },
    FR: { civil: 1.05, mechanical: 1.05, electrical: 1.05 },
    NL: { civil: 1.07, mechanical: 1.07, electrical: 1.07 },
    BE: { civil: 1.06, mechanical: 1.06, electrical: 1.06 },
    ES: { civil: 0.94, mechanical: 0.94, electrical: 0.94 },
    PT: { civil: 0.91, mechanical: 0.91, electrical: 0.91 },
    IT: { civil: 1.00, mechanical: 1.00, electrical: 1.00 },
    GR: { civil: 0.88, mechanical: 0.88, electrical: 0.88 },
    PL: { civil: 0.84, mechanical: 0.84, electrical: 0.84 },
    RO: { civil: 0.76, mechanical: 0.76, electrical: 0.76 },
    BG: { civil: 0.72, mechanical: 0.72, electrical: 0.72 },
    SE: { civil: 1.12, mechanical: 1.12, electrical: 1.12 },
    NO: { civil: 1.25, mechanical: 1.25, electrical: 1.25 },
    DK: { civil: 1.14, mechanical: 1.14, electrical: 1.14 },
    FI: { civil: 1.08, mechanical: 1.08, electrical: 1.08 },
    US: { civil: 1.18, mechanical: 1.18, electrical: 1.18 },
    CA: { civil: 1.15, mechanical: 1.15, electrical: 1.15 },
    AU: { civil: 1.16, mechanical: 1.16, electrical: 1.16 },
    JP: { civil: 1.20, mechanical: 1.20, electrical: 1.20 },
    IN: { civil: 0.65, mechanical: 0.65, electrical: 0.65 },
    CN: { civil: 0.72, mechanical: 0.72, electrical: 0.72 },
    BR: { civil: 0.83, mechanical: 0.83, electrical: 0.83 },
    ZA: { civil: 0.78, mechanical: 0.78, electrical: 0.78 },
    SA: { civil: 0.96, mechanical: 0.96, electrical: 0.96 },
    AE: { civil: 1.04, mechanical: 1.04, electrical: 1.04 },
    TR: { civil: 0.68, mechanical: 0.68, electrical: 0.68 }
};

function getCountryFactors() {
    return countryFactors[countrySelect.value] || {
        civil: 1,
        mechanical: 1,
        electrical: 1
    };
}


// --------------------------------------------------
// BASE WORK RATES (€ PER MW)
// --------------------------------------------------

const projectRates = {
    solar: {
        civil: 110000,
        mechanical: 90000,
        electrical: 160000
    },

    bess: {
        civil: 70000,
        mechanical: 120000,
        electrical: 180000
    },

    datacenter: {
        civil: 1200000,
        mechanical: 2400000,
        electrical: 3800000
    }
};


// --------------------------------------------------
// HELPER FUNCTIONS
// --------------------------------------------------

function money(value) {
    return new Intl.NumberFormat('en-IE', {
        style: 'currency',
        currency: 'EUR',
        maximumFractionDigits: 0
    }).format(value);
}

function addMaterial(list, name, quantity, unit, rate) {
    if (quantity <= 0) return;

    list.push({
        name: name,
        quantity: quantity,
        unit: unit,
        rate: rate,
        total: quantity * rate
    });
}

function displayMaterials(materials) {
    const tbody = document.getElementById('materialTable');
    tbody.innerHTML = '';

    let total = 0;

    materials.forEach(item => {
        total += item.total;

        const row = document.createElement('tr');

        [
            item.name,
            item.quantity.toLocaleString('en-IE', {
                maximumFractionDigits: 2
            }),
            item.unit,
            money(item.rate),
            money(item.total)
        ].forEach(value => {
            const cell = document.createElement('td');
            cell.textContent = value;
            row.appendChild(cell);
        });

        tbody.appendChild(row);
    });

    document.getElementById('tableTotal').textContent = money(total);

    return total;
}


// --------------------------------------------------
// SHOW / HIDE TECHNOLOGY OPTIONS
// --------------------------------------------------

document.getElementById('projectType').addEventListener('change', function() {

    const type = this.value;

    document.getElementById('solarOptions').style.display =
        type === 'solar' ? 'block' : 'none';

    document.getElementById('bessOptions').style.display =
        type === 'bess' ? 'block' : 'none';

    document.getElementById('dcOptions').style.display =
        type === 'datacenter' ? 'block' : 'none';

    document.getElementById('durationGroup').style.display =
        type === 'bess' ? 'block' : 'none';

});


// --------------------------------------------------
// MAIN CALCULATION
// --------------------------------------------------

function calculateBudget() {

    const capacity = parseFloat(document.getElementById('capacity').value);
    const type = document.getElementById('projectType').value;

    if (!capacity || capacity <= 0) {
        alert('Please enter a valid project capacity.');
        return;
    }

    const factors = getCountryFactors();
    const rates = projectRates[type];

    // Works estimates
    const civilCost =
        capacity * rates.civil * factors.civil;

    const mechanicalCost =
        capacity * rates.mechanical * factors.mechanical;

    const electricalCost =
        capacity * rates.electrical * factors.electrical;

    // Material market factor
    const materialFactor =
        (factors.civil + factors.mechanical + factors.electrical) / 3;

    const materials = [];

    // --------------------------------------------------
    // SOLAR PV
    // --------------------------------------------------

    if (type === 'solar') {

        const inverterType =
            document.getElementById('inverterType').value;

        const structureType =
            document.getElementById('structureType').value;

        const combinerBoxes =
            document.getElementById('combinerBoxes').value;

        const modules = capacity * 1820;

        addMaterial(
            materials,
            'PV Modules',
            modules,
            'pcs',
            90 * materialFactor
        );

        addMaterial(
            materials,
            inverterType === 'string'
                ? 'String Inverters'
                : 'Central Inverters',
            capacity,
            'MW',
            (inverterType === 'string' ? 55000 : 35000) * materialFactor
        );

        addMaterial(
            materials,
            structureType === 'fixed'
                ? 'Fixed Mounting Structure'
                : 'Single Axis Tracker',
            modules,
            'module positions',
            (structureType === 'fixed' ? 35 : 65) * materialFactor
        );

        if (combinerBoxes === 'yes') {
            addMaterial(
                materials,
                'DC Combiner Boxes',
                capacity * 10,
                'units',
                1200 * materialFactor
            );
        }

        addMaterial(materials, 'DC Cables', capacity * 3000,
            'm', 2.5 * materialFactor);

        addMaterial(materials, 'AC Cables', capacity * 600,
            'm', 8 * materialFactor);

        addMaterial(materials, 'DC Connectors', capacity * 3640,
            'pcs', 2 * materialFactor);

        addMaterial(materials, 'MV Transformers', capacity / 5,
            'units', 45000 * materialFactor);

        addMaterial(materials, 'MV Switchgear', capacity / 5,
            'units', 18000 * materialFactor);

        addMaterial(materials, 'Monitoring System', capacity,
            'MW', 15000 * materialFactor);

        addMaterial(materials, 'Access Roads', capacity * 350,
            'm', 35 * materialFactor);

        addMaterial(materials, 'Fencing', capacity * 180,
            'm', 25 * materialFactor);

        addMaterial(materials, 'Foundations', modules,
            'pcs', 12 * materialFactor);

        addMaterial(materials, 'Drainage', capacity * 250,
            'm', 30 * materialFactor);
    }


    // --------------------------------------------------
    // BESS
    // --------------------------------------------------

    if (type === 'bess') {

        const duration =
            parseFloat(document.getElementById('duration').value);

        const batteryType =
            document.getElementById('batteryType').value;

        const coolingType =
            document.getElementById('coolingType').value;

        const energy = capacity * duration;

        const batteryRate =
            batteryType === 'lfp' ? 110000 : 125000;

        addMaterial(
            materials,
            batteryType.toUpperCase() + ' Battery Containers (5 MWh)',
            energy / 5,
            'units',
            batteryRate * materialFactor
        );

        addMaterial(materials, 'Battery Racks',
            energy * 40, 'units', 450 * materialFactor);

        addMaterial(materials, 'Battery Modules',
            energy * 800, 'pcs', 100 * materialFactor);

        addMaterial(materials, 'Power Conversion System (PCS)',
            capacity, 'MW', 70000 * materialFactor);

        addMaterial(materials, 'PCS Units (2.5 MW)',
            capacity / 2.5, 'units', 25000 * materialFactor);

        addMaterial(materials, 'MV Transformers',
            capacity / 5, 'units', 45000 * materialFactor);

        addMaterial(materials, 'MV Switchgear',
            capacity / 5, 'units', 18000 * materialFactor);

        addMaterial(materials, 'HV Cables',
            capacity * 250, 'm', 12 * materialFactor);

        addMaterial(materials, 'DC Cables',
            energy * 150, 'm', 3 * materialFactor);

        addMaterial(materials, 'Energy Management System (EMS)',
            1, 'system', 35000 * materialFactor);

        addMaterial(materials, 'Fire Suppression Systems',
            energy / 5, 'systems', 18000 * materialFactor);

        addMaterial(materials, coolingType === 'liquid'
            ? 'Liquid Cooling Systems'
            : 'Air Cooling Systems',
            energy / 5, 'systems',
            (coolingType === 'liquid' ? 22000 : 14000) * materialFactor
        );

        addMaterial(materials, 'Foundations',
            energy * 12, 'm³', 120 * materialFactor);

        addMaterial(materials, 'Access Roads',
            capacity * 100, 'm', 35 * materialFactor);

        addMaterial(materials, 'Drainage',
            capacity * 80, 'm', 30 * materialFactor);
    }


    // --------------------------------------------------
    // DATA CENTER
    // --------------------------------------------------

    if (type === 'datacenter') {

        const tier =
            document.getElementById('tierType').value;

        const cooling =
            document.getElementById('dcCooling').value;

        const tierFactor = tier === '4' ? 1.25 : 1;

        addMaterial(materials, 'Server Racks',
            capacity * 80, 'units', 15000 * materialFactor);

        addMaterial(materials, 'UPS Systems',
            capacity, 'MW', 100000 * materialFactor * tierFactor);

        addMaterial(materials, 'UPS Modules (1 MW)',
            capacity, 'units', 45000 * materialFactor);

        addMaterial(materials, 'Backup Generators (2 MW)',
            capacity / 2, 'units', 180000 * materialFactor);

        addMaterial(materials, 'MV Transformers',
            capacity / 5, 'units', 90000 * materialFactor);

        addMaterial(materials, 'MV Switchgear',
            capacity / 2, 'units', 35000 * materialFactor);

        addMaterial(materials, 'LV Switchboards',
            capacity * 4, 'units', 18000 * materialFactor);

        addMaterial(materials, 'Cooling Capacity',
            capacity * 1.2, 'MW thermal',
            180000 * materialFactor *
            (cooling === 'liquid' ? 1.2 : 1)
        );

        addMaterial(materials, 'CRAH / CRAC Units',
            capacity * 12, 'units', 12000 * materialFactor);

        addMaterial(materials, 'Cooling Pumps',
            capacity * 4, 'units', 8000 * materialFactor);

        addMaterial(materials, 'Chillers',
            capacity * 1.2 / 3, 'units', 75000 * materialFactor);

        addMaterial(materials, 'Fire Protection Systems',
            capacity * 2, 'systems', 12000 * materialFactor);

        addMaterial(materials, 'Power Cables',
            capacity * 1800, 'm', 12 * materialFactor);

        addMaterial(materials, 'Fibre Optic Cables',
            capacity * 2500, 'm', 2 * materialFactor);

        addMaterial(materials, 'Cable Trays',
            capacity * 900, 'm', 15 * materialFactor);

        addMaterial(materials, 'Concrete',
            capacity * 350, 'm³', 180 * materialFactor);

        addMaterial(materials, 'Structural Steel',
            capacity * 120, 'tonnes', 2200 * materialFactor);

        addMaterial(materials, 'Raised Floor',
            capacity * 250, 'm²', 90 * materialFactor);
    }


    // --------------------------------------------------
    // DISPLAY RESULTS
    // --------------------------------------------------

    const materialCost = displayMaterials(materials);

    const grandTotal =
        civilCost + mechanicalCost + electricalCost + materialCost;

    document.getElementById('civilTotal').textContent =
        money(civilCost);

    document.getElementById('mechanicalTotal').textContent =
        money(mechanicalCost);

    document.getElementById('electricalTotal').textContent =
        money(electricalCost);

    document.getElementById('materialTotal').textContent =
        money(materialCost);

    document.getElementById('grandTotal').textContent =
        money(grandTotal);

    const countryName =
        countryNames.of(countrySelect.value);

    document.getElementById('projectDescription').textContent =
        countryName + ' | ' +
        capacity + ' MW | ' +
        (type === 'solar' ? 'Solar PV' :
         type === 'bess' ? 'BESS' : 'Data Center');

    document.getElementById('results').style.display = 'block';

    document.getElementById('results').scrollIntoView({
        behavior: 'smooth'
    });
}

</script>

</body>
</html>
