<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Budget Estimate Calculator</title>

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #f3f6fa;
    font-family: Arial, sans-serif;
    color: #263445;
}

.welcome {
    position: relative;
    background: linear-gradient(120deg, #102c46, #176b87);
    color: white;
    padding: 55px 25px 35px;
    text-align: center;
}

.welcome h1 {
    font-size: 30px;
    font-weight: bold;
    margin-bottom: 10px;
}

.welcome p {
    color: #d5e6ef;
    font-size: 15px;
}

.language-selector {
    position: absolute;
    top: 18px;
    right: 25px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,.13);
    padding: 7px 12px;
    border-radius: 7px;
}

.language-selector span {
    font-size: 20px;
}

.language-selector select {
    background: transparent;
    color: white;
    border: none;
    outline: none;
    font-size: 13px;
    cursor: pointer;
}

.language-selector option {
    background: white;
    color: #263445;
}

.main-container {
    max-width: 1150px;
    margin: 35px auto;
    padding: 0 20px;
}

.panel-custom {
    background: white;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 25px;
    box-shadow: 0 3px 15px rgba(0,0,0,.06);
}

.panel-custom h3 {
    margin-top: 0;
    margin-bottom: 25px;
    font-weight: bold;
    color: #174b68;
    border-bottom: 2px solid #edf1f5;
    padding-bottom: 15px;
}

label {
    font-weight: 600;
    margin-bottom: 8px;
}

.form-control {
    height: 43px;
    border-radius: 6px;
    border: 1px solid #d8e0e8;
    box-shadow: none;
}

.form-control:focus {
    border-color: #1683a5;
    box-shadow: 0 0 5px rgba(22,131,165,.2);
}

.btn-calculate {
    background: #087b9b;
    color: white;
    font-weight: bold;
    border: none;
    padding: 13px 35px;
    border-radius: 6px;
    font-size: 15px;
    margin-top: 15px;
}

.btn-calculate:hover,
.btn-calculate:focus {
    background: #075e78;
    color: white;
}

.result-card {
    background: linear-gradient(120deg, #123d58, #087b9b);
    color: white;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 25px;
}

.result-card h4 {
    color: #d6eaf2;
}

.result-card h2 {
    font-size: 34px;
    font-weight: bold;
    margin-bottom: 5px;
}

.table {
    margin-bottom: 0;
}

.table thead {
    background: #edf3f7;
}

.table th,
.table td {
    padding: 13px !important;
    vertical-align: middle !important;
}

.total-row {
    font-weight: bold;
    background: #e8f3f7;
}

.hidden-results {
    display: none;
}

.note {
    color: #758493;
    font-size: 12px;
    margin-top: 12px;
    line-height: 1.6;
}

footer {
    text-align: center;
    padding: 25px;
    color: #84919e;
}

/* ASSUMPTIONS */

.assumptions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
}

.assumption-card {
    background: #f5f8fb;
    border: 1px solid #e4ebf1;
    border-left: 4px solid #087b9b;
    border-radius: 8px;
    padding: 15px 17px;
    min-width: 0;
}

.assumption-card.full-width {
    grid-column: 1 / -1;
}

.assumption-label {
    color: #758493;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .4px;
    margin-bottom: 7px;
}

.assumption-value {
    color: #174b68;
    font-size: 18px;
    font-weight: bold;
    overflow-wrap: anywhere;
}

.assumption-description {
    color: #84919e;
    font-size: 12px;
    margin-top: 5px;
    line-height: 1.5;
}

/* MOBILE */

@media (max-width: 767px) {
    .welcome {
        padding: 70px 15px 25px;
    }

    .welcome h1 {
        font-size: 24px;
    }

    .welcome p {
        font-size: 13px;
    }

    .language-selector {
        top: 12px;
        right: 12px;
        padding: 5px 8px;
    }

    .language-selector span {
        font-size: 17px;
    }

    .language-selector select {
        font-size: 12px;
    }

    .main-container {
        margin: 20px auto;
        padding: 0 12px;
    }

    .panel-custom {
        padding: 17px;
        margin-bottom: 18px;
    }

    .panel-custom h3 {
        font-size: 19px;
        margin-bottom: 20px;
    }

    .form-control {
        font-size: 16px;
    }

    .btn-calculate {
        width: 100%;
        margin-top: 10px;
        padding: 13px 15px;
    }

    .result-card {
        padding: 20px;
    }

    .result-card h2 {
        font-size: 27px;
        overflow-wrap: anywhere;
    }

    .table-responsive {
        border: none;
        margin-bottom: 5px;
    }

    .table {
        font-size: 12px;
        min-width: 650px;
    }

    .assumptions-grid {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .assumption-card.full-width {
        grid-column: auto;
    }

    .assumption-card {
        padding: 13px;
    }

    footer {
        font-size: 12px;
    }
}

@media (max-width: 380px) {
    .welcome h1 {
        font-size: 21px;
    }

    .panel-custom {
        padding: 13px;
    }

    .result-card h2 {
        font-size: 23px;
    }
}

/* RTL */

html[dir="rtl"] body {
    direction: rtl;
    text-align: right;
}

html[dir="rtl"] .language-selector {
    right: auto;
    left: 25px;
}

html[dir="rtl"] .assumption-card {
    border-left: 1px solid #e4ebf1;
    border-right: 4px solid #087b9b;
}

html[dir="rtl"] .table th,
html[dir="rtl"] .table td {
    text-align: right;
}

@media (max-width: 767px) {
    html[dir="rtl"] .language-selector {
        left: 12px;
        right: auto;
    }
}

@media print {
    .btn-calculate,
    .language-selector {
        display: none !important;
    }

    body {
        background: white;
    }

    .panel-custom {
        box-shadow: none;
        border: 1px solid #ddd;
    }
}
</style>
</head>

<body>

<section>
    <div class="welcome">

        <div class="language-selector">
            <span>🌐</span>
            <select id="languageSelect" onchange="changeLanguage(this.value)">
                <option value="en">English</option>
                <option value="el">Ελληνικά</option>
                <option value="ar">العربية</option>
                <option value="de">Deutsch</option>
                <option value="fr">Français</option>
            </select>
        </div>

        <h1 data-i18n="title">Budget Estimate Calculator</h1>
        <p data-i18n="subtitle">Preliminary EPC Project Cost Estimation Tool</p>
    </div>
</section>

<div class="main-container">

    <!-- PROJECT INFORMATION -->

    <div class="panel-custom">

        <h3 data-i18n="projectInfo">Project Information</h3>

        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    <label data-i18n="country">Country / Market</label>
                    <select id="country" class="form-control">
                        <option value="" data-i18n="selectCountry">Select Country</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label data-i18n="projectType">Project Type</label>
                    <select id="projectType" class="form-control"
                            onchange="updateProjectOptions()">
                        <option value="" data-i18n="selectProject">Select Project</option>
                        <option value="solar" data-i18n="solar">Solar PV Project</option>
                        <option value="bess">BESS</option>
                        <option value="datacenter" data-i18n="datacenter">Data Center</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label id="capacityLabel" data-i18n="capacity">Project Capacity (MW)</label>
                    <input type="number" id="capacity" class="form-control"
                           min="0.01" step="any" placeholder="Enter capacity">
                </div>
            </div>

            <!-- SOLAR -->

            <div class="col-md-6" id="solarOptions" style="display:none;">
                <div class="form-group">
                    <label data-i18n="technology">PV Module Technology</label>
                    <select id="solarTechnology" class="form-control">
                        <option value="" data-i18n="selectTechnology">Select Technology</option>
                        <option value="topcon_mono">N-type TOPCon Monofacial</option>
                        <option value="topcon_bifacial">N-type TOPCon Bifacial</option>
                        <option value="perc">PERC Monofacial</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="modulePowerGroup" style="display:none;">
                <div class="form-group">
                    <label data-i18n="modulePower">PV Module Power (Wp)</label>
                    <input type="number" id="modulePower" class="form-control"
                           min="1" step="any" placeholder="Enter module power">
                </div>
            </div>

            <div class="col-md-6" id="mountingGroup" style="display:none;">
                <div class="form-group">
                    <label data-i18n="mounting">Mounting System</label>
                    <select id="mountingType" class="form-control">
                        <option value="" data-i18n="selectMounting">Select Mounting System</option>
                        <option value="fixed" data-i18n="fixed">Fixed Tilt</option>
                        <option value="tracker" data-i18n="tracker">Single Axis Tracker</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="invertersGroup" style="display:none;">
                <div class="form-group">
                    <label data-i18n="inverters">Number of String Inverters</label>
                    <input type="number" id="inverterCount" class="form-control"
                           min="1" step="1" placeholder="Enter inverter quantity">
                </div>
            </div>

            <div class="col-md-6" id="substationsGroup" style="display:none;">
                <div class="form-group">
                    <label data-i18n="substations">Number of MV Substations</label>
                    <input type="number" id="substationCount" class="form-control"
                           min="1" step="1" placeholder="Enter MV substation quantity">
                </div>
            </div>

            <div class="col-md-6" id="modulesPerStringGroup" style="display:none;">
                <div class="form-group">
                    <label data-i18n="modulesPerString">Modules per String</label>
                    <input type="number" id="modulesPerString" class="form-control"
                           min="1" step="1" placeholder="Enter modules per string">
                </div>
            </div>

            <!-- BESS -->

            <div class="col-md-6" id="durationGroup" style="display:none;">
                <div class="form-group">
                    <label data-i18n="duration">BESS Duration (Hours)</label>
                    <input type="number" id="duration" class="form-control"
                           min="1" step="any" placeholder="Enter duration">
                </div>
            </div>

            <div class="col-md-6" id="chemistryGroup" style="display:none;">
                <div class="form-group">
                    <label data-i18n="chemistry">Battery Chemistry</label>
                    <select id="batteryChemistry" class="form-control">
                        <option value="" data-i18n="selectChemistry">Select Chemistry</option>
                        <option value="LFP">LFP</option>
                        <option value="NMC">NMC</option>
                    </select>
                </div>
            </div>

            <!-- DATA CENTER -->

            <div class="col-md-6" id="tierGroup" style="display:none;">
                <div class="form-group">
                    <label data-i18n="tier">Data Center Tier</label>
                    <select id="dataCenterTier" class="form-control">
                        <option value="" data-i18n="selectTier">Select Tier</option>
                        <option value="Tier II">Tier II</option>
                        <option value="Tier III">Tier III</option>
                        <option value="Tier IV">Tier IV</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6" id="coolingGroup" style="display:none;">
                <div class="form-group">
                    <label data-i18n="cooling">Cooling System</label>
                    <select id="coolingType" class="form-control">
                        <option value="" data-i18n="selectCooling">Select Cooling</option>
                        <option value="air" data-i18n="airCooling">Air Cooling</option>
                        <option value="liquid" data-i18n="liquidCooling">Liquid Cooling</option>
                    </select>
                </div>
            </div>

        </div>

        <button class="btn btn-calculate" onclick="calculateBudget()" data-i18n="calculate">
            Calculate Budget
        </button>

        <button class="btn btn-calculate" onclick="resetCalculator()" data-i18n="reset">
            Reset
        </button>

        <p class="note" data-i18n="introNote">
            Preliminary estimates based on indicative procurement and EPC assumptions.
        </p>

        <div id="errorMessage" style="display:none;color:#b52b27;margin-top:12px;"></div>

    </div>


    <!-- RESULTS -->

    <div id="results" class="hidden-results">

        <div class="result-card">
            <h4 data-i18n="totalEpc">Total Estimated EPC Cost</h4>
            <h2 id="totalBudget">€0</h2>
            <p id="projectSummary"></p>
            <p id="marketSummary"></p>
            <h4 id="costPerMW"></h4>
        </div>


        <!-- EPC BREAKDOWN -->

        <div class="panel-custom">

            <h3 data-i18n="epcBreakdown">EPC Cost Breakdown</h3>

            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th data-i18n="workCategory">Work Category</th>
                            <th data-i18n="estimatedCost">Estimated Cost (€)</th>
                            <th data-i18n="share">Share (%)</th>
                        </tr>
                    </thead>
                    <tbody id="costTable"></tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td data-i18n="totalEpcCost">TOTAL EPC COST</td>
                            <td id="costTotal">€0</td>
                            <td>100%</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <p class="note" data-i18n="epcNote">
                The EPC total includes procurement, materials, engineering, civil works,
                electrical installation, project management, commissioning and contingency.
            </p>

        </div>


        <!-- MATERIALS -->

        <div class="panel-custom">

            <h3 data-i18n="materialReference">Material / Equipment Reference</h3>

            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th data-i18n="material">Material / Equipment</th>
                            <th data-i18n="quantity">Estimated Quantity</th>
                            <th data-i18n="unit">Unit</th>
                            <th data-i18n="unitPrice">Unit Price (€)</th>
                            <th data-i18n="referenceTotal">Reference Total (€)</th>
                        </tr>
                    </thead>
                    <tbody id="materialTable"></tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td colspan="4" data-i18n="totalMaterial">
                                TOTAL MATERIAL REFERENCE VALUE
                            </td>
                            <td id="materialTotal">€0</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <p class="note" data-i18n="materialNote">
                Material reference values are included within the EPC cost assumptions.
                They are not added again to the EPC total.
            </p>

        </div>


        <!-- ASSUMPTIONS -->

        <div class="panel-custom assumptions-panel">
            <h3 data-i18n="assumptions">Project Assumptions & Cost Parameters</h3>
            <div id="assumptions" class="assumptions-grid"></div>
        </div>


        <button class="btn btn-calculate" onclick="exportExcel()" data-i18n="excel">
            Download Excel
        </button>

        <button class="btn btn-calculate" onclick="window.print()" data-i18n="print">
            Print / Save as PDF
        </button>

    </div>

</div>

<footer data-i18n="footer">
    Budget Estimate Calculator | Preliminary EPC Estimation
</footer>


