// =============================================
// MAIN CALCULATION
// =============================================

let lastCalculation = null;

function calculateBudget() {

    clearError();

    const country = document.getElementById("country").value;
    const type = document.getElementById("projectType").value;
    const capacityInput = Number(document.getElementById("capacity").value);

    if (!country || !type || !Number.isFinite(capacityInput) || capacityInput <= 0) {
        showError(t("selectCountryError"));
        return;
    }

    const factor = countryRates[country] ?? defaultMarketFactor;

    let actualCapacity = capacityInput;
    let duration = 0;
    let modules = 0;
    let strings = 0;
    let modulesPerString = 0;
    let moduleWp = 0;
    let inverterCount = 0;
    let substationCount = 0;
    let mountingType = "";
    let moduleTechnology = "";
    let materials = [];
    let directCosts = {};


    // SOLAR

    if (type === "solar") {

        moduleTechnology = document.getElementById("solarTechnology").value;
        moduleWp = Number(document.getElementById("modulePower").value);
        mountingType = document.getElementById("mountingType").value;
        inverterCount = Number(document.getElementById("inverterCount").value);
        substationCount = Number(document.getElementById("substationCount").value);
        modulesPerString = Number(document.getElementById("modulesPerString").value);

        if (
            !moduleTechnology ||
            !Number.isFinite(moduleWp) || moduleWp <= 0 ||
            !mountingType ||
            !Number.isInteger(inverterCount) || inverterCount <= 0 ||
            !Number.isInteger(substationCount) || substationCount <= 0 ||
            !Number.isInteger(modulesPerString) || modulesPerString <= 0
        ) {
            showError(t("solarError"));
            return;
        }

        // Module quantity is calculated automatically from MWp and Wp.

        modules = Math.ceil(capacityInput * 1000000 / moduleWp);

        actualCapacity = modules * moduleWp / 1000000;

        strings = Math.ceil(modules / modulesPerString);

        materials = getSolarMaterials({
            capacity: actualCapacity,
            moduleWp,
            modules,
            strings,
            modulesPerString,
            inverterCount,
            substationCount,
            mountingType,
            factor,
            moduleTechnology
        });

        // Total EPC based on the capacity and country market factor.
        // The material list is for reference only and is not added again.

        let baseTotal = actualCapacity * solarBaseRate * factor;

        // Tracker system allowance.
        if (mountingType === "tracker") {
            baseTotal *= 1.06;
        }

        directCosts = {
            [t("civil")]: baseTotal * solarShares.civil,
            [t("mechanical")]: baseTotal * solarShares.mechanical,
            [t("electrical")]: baseTotal * solarShares.electrical,
            [t("pvModulesCost")]: baseTotal * solarShares.modules,
            [t("inverterEquipment")]: baseTotal * solarShares.inverters,
            [t("mvSubstations")]: baseTotal * solarShares.substations,
            [t("engineering")]: baseTotal * solarShares.engineering,
            [t("scadaCommissioning")]: baseTotal * solarShares.commissioning
        };

    }


    // BESS

    if (type === "bess") {

        duration = Number(document.getElementById("duration").value);

        const chemistry = document.getElementById("batteryChemistry").value;

        if (!Number.isFinite(duration) || duration <= 0 || !chemistry) {
            showError(t("bessError"));
            return;
        }

        materials = getBessMaterials(capacityInput, duration, factor);

        const baseTotal = (
            capacityInput * bessPowerRate +
            capacityInput * duration * bessEnergyRate
        ) * factor;

        directCosts = {
            [t("civil")]: baseTotal * 0.12,
            [t("mechanical")]: baseTotal * 0.15,
            [t("electrical")]: baseTotal * 0.22,
            [t("installation")]: baseTotal * 0.12,
            [t("engineering")]: baseTotal * 0.08,
            [t("scadaCommissioning")]: baseTotal * 0.08,
            ["Battery and PCS Procurement"]: baseTotal * 0.18,
            [t("other")]: baseTotal * 0.05
        };
    }


    // DATA CENTER

    if (type === "datacenter") {

        const tier = document.getElementById("dataCenterTier").value;
        const cooling = document.getElementById("coolingType").value;

        if (!tier || !cooling) {
            showError(t("dcError"));
            return;
        }

        materials = getDataCenterMaterials(capacityInput, factor);

        let tierFactor = 1;

        if (tier === "Tier III") tierFactor = 1.15;
        if (tier === "Tier IV") tierFactor = 1.35;

        let coolingFactor = cooling === "liquid" ? 1.12 : 1;

        const baseTotal =
            capacityInput * dataCenterBaseRate * factor *
            tierFactor * coolingFactor;

        directCosts = {
            [t("civil")]: baseTotal * 0.15,
            [t("mechanical")]: baseTotal * 0.25,
            [t("electrical")]: baseTotal * 0.30,
            [t("installation")]: baseTotal * 0.10,
            [t("engineering")]: baseTotal * 0.08,
            [t("scadaCommissioning")]: baseTotal * 0.07,
            [t("other")]: baseTotal * 0.05
        };
    }


    // EPC TOTAL

    const directTotal = Object.values(directCosts).reduce(
        (sum, value) => sum + value, 0
    );

    const contingency = directTotal * contingencyRate;

    const totalEPC = directTotal + contingency;

    const costPerMW = totalEPC / actualCapacity;

    const calculation = {
        country,
        type,
        capacity: capacityInput,
        actualCapacity,
        factor,
        modules,
        moduleWp,
        strings,
        modulesPerString,
        inverterCount,
        substationCount,
        mountingType,
        moduleTechnology,
        duration,
        directCosts,
        directTotal,
        contingency,
        totalEPC,
        costPerMW,
        materials
    };

    lastCalculation = calculation;

    renderResults(calculation);
}


// =============================================
// RENDER RESULTS
// =============================================

function renderResults(d) {

    const costTable = document.getElementById("costTable");
    costTable.innerHTML = "";

    Object.entries(d.directCosts).forEach(([name, cost]) => {
        costTable.innerHTML += `
            <tr>
                <td>${name}</td>
                <td>${formatMoney(cost)}</td>
                <td>${formatNumber(cost / d.totalEPC * 100, 1)}%</td>
            </tr>
        `;
    });

    costTable.innerHTML += `
        <tr>
            <td>${t("contingencyRow")}</td>
            <td>${formatMoney(d.contingency)}</td>
            <td>${formatNumber(d.contingency / d.totalEPC * 100, 1)}%</td>
        </tr>
    `;

    const materialTable = document.getElementById("materialTable");
    materialTable.innerHTML = "";

    const materialTotal = d.materials.reduce(
        (sum, item) => sum + item.total, 0
    );

    d.materials.forEach(item => {
        materialTable.innerHTML += `
            <tr>
                <td>${item.name}</td>
                <td>${formatNumber(item.quantity, 2)}</td>
                <td>${item.unit}</td>
                <td>${formatMoney(item.unitPrice)}</td>
                <td>${formatMoney(item.total)}</td>
            </tr>
        `;
    });

    document.getElementById("totalBudget").textContent =
        formatMoney(d.totalEPC);

    document.getElementById("costTotal").textContent =
        formatMoney(d.totalEPC);

    document.getElementById("materialTotal").textContent =
        formatMoney(materialTotal);

    const capacityUnit = d.type === "solar" ? "MWp" : "MW";

    document.getElementById("projectSummary").textContent =
        d.type.toUpperCase() + " | " +
        formatNumber(d.actualCapacity, 3) + " " + capacityUnit;

    document.getElementById("marketSummary").textContent =
        t("country") + ": " + d.country +
        " | " + t("marketFactor") + ": " + d.factor;

    document.getElementById("costPerMW").textContent =
        formatMoney(d.costPerMW) + " / " + capacityUnit;


    // ASSUMPTIONS CARDS

    let assumptions = `
        <div class="assumption-card">
            <div class="assumption-label">${t("country")}</div>
            <div class="assumption-value">${d.country}</div>
            <div class="assumption-description">${t("countrySelected")}</div>
        </div>

        <div class="assumption-card">
            <div class="assumption-label">${t("marketFactor")}</div>
            <div class="assumption-value">${d.factor}</div>
            <div class="assumption-description">${t("marketNote")}</div>
        </div>

        <div class="assumption-card">
            <div class="assumption-label">${t("directCost")}</div>
            <div class="assumption-value">${formatMoney(d.directTotal)}</div>
            <div class="assumption-description">${t("beforeContingency")}</div>
        </div>

        <div class="assumption-card">
            <div class="assumption-label">${t("contingency")}</div>
            <div class="assumption-value">${formatMoney(d.contingency)}</div>
            <div class="assumption-description">${t("contingencyDesc")}</div>
        </div>

        <div class="assumption-card full-width">
            <div class="assumption-label">${t("totalBudget")}</div>
            <div class="assumption-value">${formatMoney(d.totalEPC)}</div>
            <div class="assumption-description">${t("totalBudgetDesc")}</div>
        </div>
    `;

    if (d.type === "solar") {

        const technologyName = moduleOptions[d.moduleTechnology].name;

        assumptions += `
            <div class="assumption-card">
                <div class="assumption-label">${t("technologyLabel")}</div>
                <div class="assumption-value">${technologyName}</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("modulePower")}</div>
                <div class="assumption-value">${formatNumber(d.moduleWp, 0)} Wp</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("moduleQuantity")}</div>
                <div class="assumption-value">${formatNumber(d.modules, 0)}</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("actualCapacity")}</div>
                <div class="assumption-value">${formatNumber(d.actualCapacity, 3)} MWp</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("modulesPerString")}</div>
                <div class="assumption-value">${d.modulesPerString}</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("numberStrings")}</div>
                <div class="assumption-value">${formatNumber(d.strings, 0)}</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("numberInverters")}</div>
                <div class="assumption-value">${d.inverterCount}</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("numberSubstations")}</div>
                <div class="assumption-value">${d.substationCount}</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("mountingType")}</div>
                <div class="assumption-value">${d.mountingType === "fixed" ? t("fixed") : t("tracker")}</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("costPerWp")}</div>
                <div class="assumption-value">€${(d.totalEPC / (d.actualCapacity * 1000000)).toFixed(3)}</div>
            </div>

            <div class="assumption-card full-width">
                <div class="assumption-description">${t("stringsNote")}</div>
                <div class="assumption-description">${t("riskNote")}</div>
            </div>
        `;
    }

    if (d.type === "bess") {

        assumptions += `
            <div class="assumption-card">
                <div class="assumption-label">${t("durationLabel")}</div>
                <div class="assumption-value">${d.duration} h</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("energyCapacity")}</div>
                <div class="assumption-value">${formatNumber(d.capacity * d.duration)} MWh</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("batteryChemistry")}</div>
                <div class="assumption-value">${document.getElementById("batteryChemistry").value}</div>
            </div>
        `;
    }

    if (d.type === "datacenter") {

        assumptions += `
            <div class="assumption-card">
                <div class="assumption-label">${t("dataTier")}</div>
                <div class="assumption-value">${document.getElementById("dataCenterTier").value}</div>
            </div>

            <div class="assumption-card">
                <div class="assumption-label">${t("coolingSystem")}</div>
                <div class="assumption-value">${document.getElementById("coolingType").value === "air" ? t("airCooling") : t("liquidCooling")}</div>
            </div>
        `;
    }

    document.getElementById("assumptions").innerHTML = assumptions;

    document.getElementById("results").style.display = "block";
}


// =============================================
// EXCEL EXPORT
// =============================================

function exportExcel() {

    if (!lastCalculation) {
        alert("Please calculate the budget first.");
        return;
    }

    if (typeof XLSX === "undefined") {
        alert("Excel library could not be loaded.");
        return;
    }

    const d = lastCalculation;
    const wb = XLSX.utils.book_new();

    const summary = [
        ["BUDGET ESTIMATE CALCULATION"],
        [],
        ["Country", d.country],
        ["Project Type", d.type],
        ["Input Capacity", d.capacity],
        ["Actual Capacity", d.actualCapacity],
        ["Market Factor", d.factor],
        ["Module Quantity", d.modules],
        ["Module Power (Wp)", d.moduleWp],
        ["Number of Strings", d.strings],
        ["Modules per String", d.modulesPerString],
        ["Number of Inverters", d.inverterCount],
        ["Number of MV Substations", d.substationCount],
        [],
        ["Direct EPC Cost (€)", d.directTotal],
        ["Contingency (€)", d.contingency],
        ["TOTAL EPC COST (€)", d.totalEPC],
        ["EPC Cost per MW (€)", d.costPerMW]
    ];

    const wsSummary = XLSX.utils.aoa_to_sheet(summary);
    wsSummary["!cols"] = [{ wch: 38 }, { wch: 25 }];

    XLSX.utils.book_append_sheet(wb, wsSummary, "Project Summary");


    const epcData = [
        ["Work Category", "Estimated Cost (€)", "Share (%)"]
    ];

    Object.entries(d.directCosts).forEach(([name, cost]) => {
        epcData.push([
            name,
            cost,
            cost / d.totalEPC * 100
        ]);
    });

    epcData.push([
        "Contingency",
        d.contingency,
        d.contingency / d.totalEPC * 100
    ]);

    epcData.push(["TOTAL EPC COST", d.totalEPC, 100]);

    const wsEpc = XLSX.utils.aoa_to_sheet(epcData);
    wsEpc["!cols"] = [
        { wch: 42 },
        { wch: 25 },
        { wch: 18 }
    ];

    XLSX.utils.book_append_sheet(wb, wsEpc, "EPC Breakdown");


    const materialData = [
        [
            "Material / Equipment",
            "Estimated Quantity",
            "Unit",
            "Unit Price (€)",
            "Reference Total (€)"
        ]
    ];

    d.materials.forEach(item => {
        materialData.push([
            item.name,
            item.quantity,
            item.unit,
            item.unitPrice,
            item.total
        ]);
    });

    const wsMaterials = XLSX.utils.aoa_to_sheet(materialData);

    wsMaterials["!cols"] = [
        { wch: 42 },
        { wch: 22 },
        { wch: 20 },
        { wch: 20 },
        { wch: 25 }
    ];

    XLSX.utils.book_append_sheet(wb, wsMaterials, "Material Reference");

    XLSX.writeFile(wb, "Budget_Estimate_Calculation.xlsx");
}


// =============================================
// RESET
// =============================================

function resetCalculator() {

    const fields = [
        "country",
        "projectType",
        "capacity",
        "solarTechnology",
        "modulePower",
        "mountingType",
        "inverterCount",
        "substationCount",
        "modulesPerString",
        "duration",
        "batteryChemistry",
        "dataCenterTier",
        "coolingType"
    ];

    fields.forEach(id => {
        document.getElementById(id).value = "";
    });

    updateProjectOptions();

    document.getElementById("results").style.display = "none";

    clearError();

    lastCalculation = null;
}


// =============================================
// INITIALIZATION
// =============================================

changeLanguage("en");

</script>

