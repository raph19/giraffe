
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Utility-Scale EPC Budget Estimator</title>

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
*{box-sizing:border-box}
body{margin:0;background:#f3f6fa;font-family:Arial,sans-serif;color:#263445}
.welcome{background:linear-gradient(120deg,#102c46,#176b87);color:white;padding:35px 20px;text-align:center}
.welcome h1{font-size:30px;font-weight:bold;margin:0 0 10px}
.welcome p{color:#d5e6ef}
.main-container{max-width:1200px;margin:35px auto;padding:0 20px}
.panel-custom{background:white;padding:25px;border-radius:10px;margin-bottom:25px;box-shadow:0 3px 15px rgba(0,0,0,.06)}
.panel-custom h3{margin-top:0;margin-bottom:25px;font-weight:bold;color:#174b68;border-bottom:2px solid #edf1f5;padding-bottom:15px}
label{font-weight:600;margin-bottom:8px}
.form-control{height:43px;border-radius:6px;border:1px solid #d8e0e8;box-shadow:none}
.form-control:focus{border-color:#1683a5;box-shadow:0 0 5px rgba(22,131,165,.2)}
.btn-calculate{background:#087b9b;color:white;font-weight:bold;border:none;padding:13px 30px;border-radius:6px;font-size:15px;margin:10px 8px 0 0}
.btn-calculate:hover{background:#075e78;color:white}
.result-card{background:linear-gradient(120deg,#123d58,#087b9b);color:white;padding:25px;border-radius:10px;margin-bottom:25px}
.result-card h4{color:#d6eaf2}
.result-card h2{font-size:34px;font-weight:bold}
.table{margin-bottom:0}
.table thead{background:#edf3f7}
.table th,.table td{padding:12px!important;vertical-align:middle!important}
.total-row{font-weight:bold;background:#e8f3f7}
.hidden-results{display:none}
.note{color:#758493;font-size:12px;margin-top:12px;line-height:1.5}
.section-note{background:#f1f7fa;border-left:4px solid #1683a5;padding:12px;margin:15px 0;font-size:13px;color:#506475}
footer{text-align:center;padding:25px;color:#84919e}
@media print{
.btn-calculate,#welcome{display:none!important}
body{background:white}
.panel-custom,.result-card{box-shadow:none;break-inside:avoid}
}
</style>
</head>

<body>

<section class="welcome">
<h1>Utility-Scale EPC Budget Estimator</h1>
<p>Preliminary EPC Project Cost Estimation Tool</p>
</section>

<div class="main-container">

<!-- PROJECT INFORMATION -->

<div class="panel-custom">

<h3>1. Project Information</h3>

<div class="row">

<div class="col-md-6 form-group">
<label>Country / Market</label>
<select id="country" class="form-control">
<option value="">Select Country</option>
</select>
</div>

<div class="col-md-6 form-group">
<label>Project Type</label>
<select id="projectType" class="form-control" onchange="updateProjectOptions()">
<option value="">Select Project</option>
<option value="solar">Solar PV Project</option>
<option value="bess">BESS</option>
<option value="datacenter">Data Centre</option>
</select>
</div>

<div class="col-md-6 form-group">
<label id="capacityLabel">Project Capacity</label>
<input type="number" id="capacity" class="form-control" min="0.01" step="any" placeholder="Enter capacity">
</div>

<!-- SOLAR -->

<div class="col-md-6 form-group" id="solarTechnologyGroup" style="display:none">
<label>PV Module Technology</label>
<select id="solarTechnology" class="form-control">
<option value="">Select Technology</option>
<option value="topcon_mono">N-type TOPCon Monofacial</option>
<option value="topcon_bifacial">N-type TOPCon Bifacial</option>
<option value="hjt">HJT Bifacial</option>
</select>
</div>

<div class="col-md-6 form-group" id="modulePowerGroup" style="display:none">
<label>PV Module Power (Wp)</label>
<select id="modulePower" class="form-control">
<option value="">Select Module Power</option>
<option value="550">550 Wp</option>
<option value="575">575 Wp</option>
<option value="600">600 Wp</option>
<option value="610">610 Wp</option>
<option value="620">620 Wp</option>
<option value="630">630 Wp</option>
<option value="640">640 Wp</option>
<option value="650">650 Wp</option>
<option value="660">660 Wp</option>
<option value="700">700 Wp</option>
</select>
</div>

<div class="col-md-6 form-group" id="moduleCountGroup" style="display:none">
<label>Number of PV Modules</label>
<input type="number" id="moduleCount" class="form-control" min="1" step="1" placeholder="Optional - auto calculated">
</div>

<div class="col-md-6 form-group" id="modulesPerStringGroup" style="display:none">
<label>Modules per String</label>
<input type="number" id="modulesPerString" class="form-control" min="1" step="1" value="28">
</div>

<div class="col-md-6 form-group" id="inverterGroup" style="display:none">
<label>Number of String Inverters</label>
<input type="number" id="inverterCount" class="form-control" min="1" step="1" placeholder="e.g. 168">
</div>

<div class="col-md-6 form-group" id="inverterRatingGroup" style="display:none">
<label>String Inverter Rating (kW AC)</label>
<input type="number" id="inverterRating" class="form-control" min="1" value="350">
</div>

<div class="col-md-6 form-group" id="mvGroup" style="display:none">
<label>Number of MV Substations</label>
<input type="number" id="mvCount" class="form-control" min="1" step="1" placeholder="e.g. 9">
</div>

<div class="col-md-6 form-group" id="mountingGroup" style="display:none">
<label>Mounting System</label>
<select id="mountingType" class="form-control">
<option value="">Select Mounting System</option>
<option value="fixed">Fixed Tilt</option>
<option value="tracker">Single Axis Tracker</option>
</select>
</div>

<div class="col-md-6 form-group" id="dcCableGroup" style="display:none">
<label>DC Cable Length (m)</label>
<input type="number" id="dcCableLength" class="form-control" min="0" placeholder="Automatic allowance if blank">
</div>

<div class="col-md-6 form-group" id="acCableGroup" style="display:none">
<label>LV AC Cable Length (m)</label>
<input type="number" id="acCableLength" class="form-control" min="0" placeholder="Automatic allowance if blank">
</div>

<div class="col-md-6 form-group" id="mvCableGroup" style="display:none">
<label>MV Cable Route Length (m)</label>
<input type="number" id="mvCableLength" class="form-control" min="0" placeholder="Automatic allowance if blank">
</div>

<!-- BESS -->

<div class="col-md-6 form-group" id="durationGroup" style="display:none">
<label>BESS Duration (Hours)</label>
<input type="number" id="duration" class="form-control" min="1">
</div>

<div class="col-md-6 form-group" id="chemistryGroup" style="display:none">
<label>Battery Chemistry</label>
<select id="batteryChemistry" class="form-control">
<option value="">Select Chemistry</option>
<option value="LFP">LFP</option>
<option value="NMC">NMC</option>
</select>
</div>

<!-- DATA CENTRE -->

<div class="col-md-6 form-group" id="tierGroup" style="display:none">
<label>Data Centre Tier</label>
<select id="dataCenterTier" class="form-control">
<option value="">Select Tier</option>
<option value="Tier II">Tier II</option>
<option value="Tier III">Tier III</option>
<option value="Tier IV">Tier IV</option>
</select>
</div>

<div class="col-md-6 form-group" id="coolingGroup" style="display:none">
<label>Cooling System</label>
<select id="coolingType" class="form-control">
<option value="">Select Cooling</option>
<option value="Air Cooling">Air Cooling</option>
<option value="Liquid Cooling">Liquid Cooling</option>
</select>
</div>

</div>

<div class="section-note" id="solarLiveInfo" style="display:none">
Solar configuration: Module quantity, total DC capacity and string quantity are calculated automatically. You can enter a specific module quantity if the project design is already defined.
</div>

<button class="btn btn-calculate" onclick="calculateBudget()">Calculate Budget</button>
<button class="btn btn-calculate" onclick="resetCalculator()">Reset</button>

<p class="note">
Indicative budgetary EPC estimation based on bulk procurement assumptions.
Prices are not supplier quotations. Final costs depend on technical specifications,
project scope, logistics, taxes, grid connection, labour and site conditions.
</p>

</div>


<!-- RESULTS -->

<div id="results" class="hidden-results">

<div class="result-card">

<h4>Total Estimated EPC Cost</h4>
<h2 id="totalBudget">€0</h2>

<p id="projectSummary"></p>
<p id="marketSummary"></p>

<h4 id="costPerMW"></h4>
<p id="benchmarkMessage"></p>

</div>


<!-- EPC BREAKDOWN -->

<div class="panel-custom">

<h3>2. EPC Cost Breakdown</h3>

<div class="table-responsive">
<table class="table table-bordered">

<thead>
<tr>
<th>Work Category</th>
<th>Base Cost (€)</th>
<th>Market Factor</th>
<th>Estimated Cost (€)</th>
</tr>
</thead>

<tbody id="costTable"></tbody>

<tfoot>
<tr class="total-row">
<td colspan="3">TOTAL EPC COST</td>
<td id="costTotal"></td>
</tr>
</tfoot>

</table>
</div>

<p class="note">
EPC breakdown includes equipment procurement, construction, installation,
engineering, project management and commissioning. Material reference
values below are NOT added again to the EPC total.
</p>

</div>


<!-- MATERIALS -->

<div class="panel-custom">

<h3>3. Material / Equipment Reference</h3>

<div class="table-responsive">
<table class="table table-bordered">

<thead>
<tr>
<th>Material / Equipment</th>
<th>Estimated Quantity</th>
<th>Unit</th>
<th>Indicative Unit Price (€)</th>
<th>Reference Total (€)</th>
</tr>
</thead>

<tbody id="materialTable"></tbody>

<tfoot>
<tr class="total-row">
<td colspan="4">TOTAL MATERIAL REFERENCE VALUE</td>
<td id="materialTotal"></td>
</tr>
</tfoot>

</table>
</div>

<p class="note">
Material prices are indicative bulk procurement planning allowances.
Some equipment may be included in packaged MV substations or other EPC
packages, so avoid double counting when preparing actual procurement budgets.
</p>

</div>

<button class="btn btn-calculate" onclick="exportExcel()">Download Excel</button>
<button class="btn btn-calculate" onclick="window.print()">Print / Save as PDF</button>

</div>
</div>

<footer>
Utility-Scale EPC Budget Estimator | Preliminary EPC Estimation
</footer>


<script>

// ========================================
// 1. COUNTRY DATA
// ========================================

const countryNames = {

IE:"Ireland",GB:"United Kingdom",DE:"Germany",FR:"France",
NL:"Netherlands",BE:"Belgium",LU:"Luxembourg",AT:"Austria",
CH:"Switzerland",ES:"Spain",PT:"Portugal",IT:"Italy",
GR:"Greece",CY:"Cyprus",MT:"Malta",PL:"Poland",
CZ:"Czechia",SK:"Slovakia",HU:"Hungary",RO:"Romania",
BG:"Bulgaria",HR:"Croatia",SI:"Slovenia",RS:"Serbia",
BA:"Bosnia and Herzegovina",ME:"Montenegro",MK:"North Macedonia",
AL:"Albania",EE:"Estonia",LV:"Latvia",LT:"Lithuania",
SE:"Sweden",NO:"Norway",DK:"Denmark",FI:"Finland",
IS:"Iceland",US:"United States",CA:"Canada",MX:"Mexico",
BR:"Brazil",CL:"Chile",CO:"Colombia",PE:"Peru",
AR:"Argentina",UY:"Uruguay",CN:"China",IN:"India",
JP:"Japan",KR:"South Korea",AU:"Australia",NZ:"New Zealand",
SG:"Singapore",MY:"Malaysia",TH:"Thailand",VN:"Vietnam",
ID:"Indonesia",PH:"Philippines",BD:"Bangladesh",PK:"Pakistan",
ZA:"South Africa",NG:"Nigeria",KE:"Kenya",GH:"Ghana",
MA:"Morocco",DZ:"Algeria",EG:"Egypt",SA:"Saudi Arabia",
AE:"United Arab Emirates",QA:"Qatar",KW:"Kuwait",
BH:"Bahrain",OM:"Oman",TR:"Türkiye",GE:"Georgia",
AZ:"Azerbaijan",KZ:"Kazakhstan",UZ:"Uzbekistan",
IL:"Israel",JO:"Jordan",LB:"Lebanon",RU:"Russia",
UA:"Ukraine",BY:"Belarus",HK:"Hong Kong",TW:"Taiwan",
CR:"Costa Rica",DO:"Dominican Republic",PA:"Panama",
EC:"Ecuador",BO:"Bolivia",PY:"Paraguay",VE:"Venezuela",
AO:"Angola",MZ:"Mozambique",ET:"Ethiopia",TZ:"Tanzania",
UG:"Uganda",SN:"Senegal",CI:"Côte d’Ivoire",CM:"Cameroon"

};


// ========================================
// 2. COUNTRY MARKET FACTORS
// ========================================

// Relative market factors for preliminary estimation.
// Ireland = 1.00 (calibration reference).

const countryFactors = {

IE:1.00, GB:1.02, DE:1.00, FR:0.98,
NL:0.99, BE:0.98, LU:1.02, AT:1.00,
CH:1.18, ES:0.88, PT:0.86, IT:0.94,
GR:0.84, CY:0.90, MT:0.96, PL:0.83,
CZ:0.88, SK:0.85, HU:0.82, RO:0.78,
BG:0.74, HR:0.83, SI:0.88, RS:0.75,
BA:0.72, ME:0.75, MK:0.72, AL:0.70,
EE:0.91, LV:0.89, LT:0.87, SE:1.02,
NO:1.12, DK:1.03, FI:0.98, IS:1.15,

US:1.12, CA:1.10, MX:0.82, BR:0.84,
CL:0.82, CO:0.82, PE:0.78, AR:0.80,
UY:0.88, CN:0.67, IN:0.62, JP:1.22,
KR:1.08, AU:1.08, NZ:1.05, SG:1.16,
MY:0.76, TH:0.73, VN:0.70, ID:0.78,
PH:0.79, BD:0.66, PK:0.64, ZA:0.78,
NG:0.75, KE:0.78, GH:0.79, MA:0.79,
DZ:0.80, EG:0.72, SA:0.88, AE:0.96,
QA:0.98, KW:0.94, BH:0.93, OM:0.90,
TR:0.75, GE:0.72, AZ:0.78, KZ:0.82,
UZ:0.70, IL:1.08, JO:0.83, LB:0.92,
RU:0.88, UA:0.78, BY:0.82, HK:1.20,
TW:0.98, CR:0.87, DO:0.86, PA:0.89,
EC:0.78, BO:0.73, PY:0.75, VE:0.90,
AO:0.82, MZ:0.78, ET:0.70, TZ:0.73,
UG:0.72, SN:0.77, CI:0.77, CM:0.79

};

const countrySelect = document.getElementById("country");

Object.keys(countryNames)
.sort((a,b)=>countryNames[a].localeCompare(countryNames[b]))
.forEach(code => {

const option = document.createElement("option");
option.value = code;
option.textContent = countryNames[code];

countrySelect.appendChild(option);

});


// ========================================
// 3. EPC BENCHMARK
// ========================================

// Ireland fixed-tilt EPC calibration:
// 101,709 modules x 640 Wp = 65.09376 MWp
// €27,000,000 / 65.09376 MWp = approximately €414,800/MWp.

const SOLAR_BASE_EUR_PER_MWP = 414800;


// ========================================
// 4. MODULE PROCUREMENT PRICES
// ========================================

// Indicative large-volume EUR/Wp assumptions.

const moduleOptions = {

topcon_mono:{
name:"N-type TOPCon Monofacial",
bulkEURperWp:0.105,
techFactor:1.00
},

topcon_bifacial:{
name:"N-type TOPCon Bifacial",
bulkEURperWp:0.108,
techFactor:1.015
},

hjt:{
name:"HJT Bifacial",
bulkEURperWp:0.135,
techFactor:1.07
}

};


// ========================================
// 5. MATERIAL PRICES
// ========================================

const materialPrice = {

inverter:52000,

mvStation:285000,

fixedStructure:31,

tracker:58,

dcCable:1.65,

acCable:12.50,

mvCable:42,

mvTermination:850,

earthing:2.80,

scada:3200,

mvSwitchgear:22000,

fencing:22,

roads:38,

drainage:17,

weatherStation:6500,

foundation:12

};


// ========================================
// 6. PROJECT OPTION VISIBILITY
// ========================================

function show(id, visible) {

document.getElementById(id).style.display =
visible ? "block" : "none";

}


function updateProjectOptions() {

const type = document.getElementById("projectType").value;

const solar = type === "solar";
const bess = type === "bess";
const dc = type === "datacenter";

[

"solarTechnologyGroup",
"modulePowerGroup",
"moduleCountGroup",
"modulesPerStringGroup",
"inverterGroup",
"inverterRatingGroup",
"mvGroup",
"mountingGroup",
"dcCableGroup",
"acCableGroup",
"mvCableGroup"

].forEach(id => show(id,solar));


["durationGroup","chemistryGroup"].forEach(id=>show(id,bess));

["tierGroup","coolingGroup"].forEach(id=>show(id,dc));

show("solarLiveInfo",solar);

document.getElementById("capacityLabel").textContent =
solar ? "Solar PV DC Capacity (MWp)" :
bess ? "BESS Power Capacity (MW)" :
dc ? "IT Load Capacity (MW)" :
"Project Capacity (MW)";

}


// ========================================
// 7. FORMATTING AND VALIDATION
// ========================================

function money(value) {

return new Intl.NumberFormat("en-IE",{

style:"currency",
currency:"EUR",
maximumFractionDigits:0

}).format(value || 0);

}


function formatNumber(value, decimals=2) {

return new Intl.NumberFormat("en-IE",{

maximumFractionDigits:decimals

}).format(value || 0);

}


function inputValue(id) {

return document.getElementById(id).value;

}


function positive(id,label,integer=false,allowZero=false) {

const value = Number(inputValue(id));

if(

!Number.isFinite(value) ||
(allowZero ? value < 0 : value <= 0) ||
(integer && !Number.isInteger(value))

) {

throw new Error("Please enter a valid "+label+".");

}

return value;

}


// ========================================
// 8. SOLAR CONFIGURATION
// ========================================

function getSolarInputs(capacity) {

const technology = inputValue("solarTechnology");

const power = Number(inputValue("modulePower"));

const mounting = inputValue("mountingType");

if(!moduleOptions[technology]) {

throw new Error("Please select PV module technology.");

}

if(!power || !mounting) {

throw new Error("Please select module power and mounting system.");

}


// Module quantity:
// If not manually entered, calculate from MWp and module Wp.

const enteredModules = inputValue("moduleCount").trim();

const modules = enteredModules
? positive("moduleCount","number of modules",true)
: Math.ceil(capacity*1000000/power);


// Actual DC capacity based on the selected module quantity.

const actualMWp = modules*power/1000000;


// String configuration.

const modulesPerString = positive(
"modulesPerString",
"modules per string",
true
);

const strings = Math.ceil(modules/modulesPerString);


// Inverters.

const inverters = positive(
"inverterCount",
"number of inverters",
true
);

const inverterRating = positive(
"inverterRating",
"inverter rating"
);


// MV substations.

const mvSubstations = positive(
"mvCount",
"number of MV substations",
true
);


// Cable quantities.
// Blank values trigger indicative planning allowances.

const dcLength = inputValue("dcCableLength")===""
? actualMWp*3000
: positive("dcCableLength","DC cable length",false,true);

const acLength = inputValue("acCableLength")===""
? actualMWp*650
: positive("acCableLength","LV AC cable length",false,true);

const mvLength = inputValue("mvCableLength")===""
? actualMWp*150
: positive("mvCableLength","MV cable route length",false,true);


return {

technology,
power,
mounting,
modules,
actualMWp,
modulesPerString,
strings,
inverters,
inverterRating,
mvSubstations,
dcLength,
acLength,
mvLength

};

}


// ========================================
// 9. SOLAR MATERIAL REFERENCE
// ========================================

function getSolarMaterials(s) {

const module = moduleOptions[s.technology];

const modulePrice = module.bulkEURperWp*s.power;

const structurePrice = s.mounting==="fixed"
? materialPrice.fixedStructure
: materialPrice.tracker;

return [

[

"PV Modules - "+module.name+" ("+s.power+" Wp)",

s.modules,

"pcs",

modulePrice

],

[

"PV Strings (calculated)",

s.strings,

"strings",

0

],

[

"Modules per String",

s.modulesPerString,

"modules/string",

0

],

[

"String Inverters",

s.inverters,

"units",

materialPrice.inverter

],

[

"MV Substations / Skids",

s.mvSubstations,

"units",

materialPrice.mvStation

],

[

s.mounting==="fixed"
? "Fixed-Tilt Mounting Structures"
: "Single-Axis Tracker Structures",

s.modules,

"module positions",

structurePrice

],

[

"DC Solar Cables",

s.dcLength,

"m",

materialPrice.dcCable

],

[

"LV AC Cables",

s.acLength,

"m",

materialPrice.acCable

],

[

"MV Cables - Supply",

s.mvLength,

"route m",

materialPrice.mvCable

],

[

"MV Cable Terminations / Joints",

s.mvSubstations*6,

"sets",

materialPrice.mvTermination

],

[

"Earthing / Grounding Conductor",

s.actualMWp*1800,

"m",

materialPrice.earthing

],

[

"SCADA / PPC / Monitoring System",

s.actualMWp,

"MWp",

materialPrice.scada

],

[

"MV Switchgear (if separately supplied)",

s.mvSubstations,

"sets",

materialPrice.mvSwitchgear

],

[

"Fencing",

s.actualMWp*180,

"m",

materialPrice.fencing

],

[

"Access Roads",

s.actualMWp*300,

"m",

materialPrice.roads

],

[

"Drainage System",

s.actualMWp*220,

"m",

materialPrice.drainage

],

[

"Weather Stations",

Math.max(1,Math.ceil(s.actualMWp/20)),

"units",

materialPrice.weatherStation

],

[

"Foundations / Pile Positions",

s.modules,

"positions",

materialPrice.foundation

]

];

}


// ========================================
// 10. BESS MATERIALS
// ========================================

function getBessMaterials(capacity,duration) {

const energy = capacity*duration;

const containers = Math.ceil(energy/5);

return [

["Battery Energy Capacity",energy,"MWh",0],

["Battery Containers (approx. 5 MWh)",containers,"units",470000],

["Power Conversion System",capacity,"MW",105000],

["MV Transformers",Math.ceil(capacity/5),"units",78000],

["MV Switchgear",Math.ceil(capacity/5),"sets",32000],

["EMS / PPC",1,"system",55000],

["Battery Management System",1,"system",25000],

["Fire Suppression Systems",containers,"systems",22000],

["HVAC Systems",containers,"systems",18000],

["DC Cables",energy*150,"m",8],

["MV Cables",capacity*180,"m",42],

["Concrete Foundations",energy*12,"m3",190]

];

}


// ========================================
// 11. DATA CENTRE MATERIALS
// ========================================

function getDataCenterMaterials(capacity) {

return [

["Server Racks",capacity*80,"units",4600],

["UPS Systems",capacity,"MW",190000],

["Generators",Math.ceil(capacity/2),"units",375000],

["MV Transformers",Math.ceil(capacity/5),"units",92000],

["MV Switchgear",Math.ceil(capacity/2),"sets",48000],

["LV Switchboards",capacity*4,"sets",24000],

["Cooling Capacity",capacity*1.2,"MW thermal",105000],

["CRAH / CRAC Units",capacity*12,"units",15000],

["Chillers",Math.ceil(capacity*0.4),"units",72000],

["Fire Suppression",capacity*2,"systems",19500],

["Power Cables",capacity*1800,"m",13],

["Fibre Optic Cables",capacity*2500,"m",2.80],

["Cable Trays",capacity*900,"m",19]

];

}


// ========================================
// 12. MAIN CALCULATION
// ========================================

let lastCalculation = null;


function calculateBudget() {

try {

const country = inputValue("country");

const type = inputValue("projectType");

const capacity = positive("capacity","project capacity");

if(!country || !type) {

throw new Error("Please select country and project type.");

}

const marketFactor = countryFactors[country] ?? 1.0;

let costs = [];

let materials = [];

let details = "";

let actualCapacity = capacity;

let duration = 0;


// ====================================
// SOLAR PV
// ====================================

if(type==="solar") {

const s = getSolarInputs(capacity);

actualCapacity = s.actualMWp;

const module = moduleOptions[s.technology];

const base = SOLAR_BASE_EUR_PER_MWP*actualCapacity;

const mountingFactor =
s.mounting==="tracker" ? 1.105 : 1.0;

const technologyFactor = module.techFactor;


// EPC cost distribution.
// Shares total 100%.

const shares = [

["PV Modules & Inverter Procurement",0.395],

["Balance of System Hardware",0.245],

["Civil Works & Site Infrastructure",0.105],

["Mechanical Installation",0.075],

["Electrical Installation & Cabling",0.085],

["Engineering, Development & Permitting",0.045],

["Project Management, HSE & Quality",0.025],

["Testing, Commissioning & Grid Compliance",0.025]

];


costs = shares.map(([name,share])=>{

let adjustment = 1;

if(name.includes("PV Modules")) {

adjustment *= technologyFactor;

}

if(name.includes("Mechanical")) {

adjustment *= mountingFactor;

}

return [name,base*share*adjustment];

});


// Additional tracker allowance.

if(s.mounting==="tracker") {

costs[1][1] += base*0.045;

}


// Material reference schedule.

materials = getSolarMaterials(s);


// Project summary.

details =

"Solar PV | "+module.name+
" | "+s.power+" Wp"+
" | "+(s.mounting==="fixed"?"Fixed Tilt":"Single Axis Tracker")+
" | "+formatNumber(s.modules,0)+" modules"+
" | "+formatNumber(s.strings,0)+" strings"+
" | "+s.modulesPerString+" modules/string"+
" | "+s.inverters+" inverters"+
" | "+s.mvSubstations+" MV substations";

}


// ====================================
// BESS
// ====================================

else if(type==="bess") {

duration = positive("duration","BESS duration");

const chemistry = inputValue("batteryChemistry");

if(!chemistry) {

throw new Error("Please select battery chemistry.");

}

const energy = capacity*duration;

const batteryPrice = chemistry==="LFP"
? 205000
: 230000;

const base = capacity*370000 + energy*batteryPrice;


costs = [

["Civil Works & Foundations",base*0.10],

["Battery System Procurement",base*0.48],

["PCS & MV Electrical Equipment",base*0.20],

["Mechanical, HVAC & Fire Protection",base*0.09],

["Installation, Integration & Commissioning",base*0.08],

["Engineering, HSE & Project Management",base*0.05]

];


materials = getBessMaterials(capacity,duration);

details =

"BESS | "+chemistry+
" | "+capacity+" MW"+
" / "+energy+" MWh"+
" | "+duration+" hours";

}


// ====================================
// DATA CENTRE
// ====================================

else if(type==="datacenter") {

const tier = inputValue("dataCenterTier");

const cooling = inputValue("coolingType");

if(!tier || !cooling) {

throw new Error("Please select Data Centre Tier and Cooling System.");

}

const tierFactor =

tier==="Tier II" ? 1.00 :
tier==="Tier III" ? 1.22 :
1.55;

const coolingFactor = cooling==="Liquid Cooling"
? 1.12
: 1.00;

const base = capacity*7800000*tierFactor*coolingFactor;


costs = [

["Civil & Structural Works",base*0.16],

["Electrical Infrastructure & UPS",base*0.30],

["Mechanical & Cooling Systems",base*0.27],

["Generators & Fuel Systems",base*0.09],

["Fire, Security & BMS",base*0.06],

["Installation, Testing & Commissioning",base*0.07],

["Engineering & Project Management",base*0.05]

];


materials = getDataCenterMaterials(capacity);

details =

"Data Centre | "+tier+
" | "+cooling+
" | "+capacity+" MW IT load";

}

else {

throw new Error("Please select a valid project type.");

}


// ====================================
// TOTAL EPC COST
// ====================================

const baseTotal = costs.reduce((sum,item)=>sum+item[1],0);

const total = baseTotal*marketFactor;

const costPerMW = total/(type==="solar"?actualCapacity:capacity);


// ====================================
// EPC TABLE
// ====================================

const adjustedCosts = costs.map(item=>{

return [

item[0],

item[1],

marketFactor,

item[1]*marketFactor

];

});


document.getElementById("costTable").innerHTML =

adjustedCosts.map(item=>`

<tr>

<td>${item[0]}</td>

<td>${money(item[1])}</td>

<td>${item[2].toFixed(2)}</td>

<td>${money(item[3])}</td>

</tr>

`).join("");


// ====================================
// MATERIAL TABLE
// ====================================

let materialTotal = 0;

document.getElementById("materialTable").innerHTML =

materials.map(item=>{

const referenceTotal = item[1]*item[3];

materialTotal += referenceTotal;

return `

<tr>

<td>${item[0]}</td>

<td>${formatNumber(item[1])}</td>

<td>${item[2]}</td>

<td>${money(item[3])}</td>

<td>${money(referenceTotal)}</td>

</tr>

`;

}).join("");


// ====================================
// DISPLAY RESULTS
// ====================================

document.getElementById("totalBudget").textContent =
money(total);

document.getElementById("costTotal").textContent =
money(total);

document.getElementById("materialTotal").textContent =
money(materialTotal);

document.getElementById("projectSummary").textContent =
details;

document.getElementById("marketSummary").textContent =

"Market: "+countryNames[country]+
" | Market Factor: "+marketFactor.toFixed(2);

document.getElementById("costPerMW").textContent =

"Estimated EPC Cost per MW: "+money(costPerMW);

document.getElementById("benchmarkMessage").textContent =

type==="solar"
? "Ireland fixed-tilt reference: €414,800/MWp, calibrated to the supplied 65.09 MWp / €27m example."
: "Indicative preliminary planning estimate. Validate against project-specific scope and supplier quotations.";


// ====================================
// SAVE FOR EXCEL
// ====================================

lastCalculation = {

country,
countryName:countryNames[country],

type,
capacity,
actualCapacity,

details,

marketFactor,

costs:adjustedCosts,

total,
costPerMW,

materials,
materialTotal,

duration

};


document.getElementById("results").style.display = "block";

document.getElementById("results").scrollIntoView({

behavior:"smooth"

});

}

catch(error) {

alert(error.message);

}

}


// ========================================
// 13. EXCEL EXPORT
// ========================================

function exportExcel() {

if(!lastCalculation) {

alert("Please calculate the project budget first.");

return;

}

if(typeof XLSX==="undefined") {

alert("Excel export requires an internet connection.");

return;

}

const data = lastCalculation;


// EPC SUMMARY SHEET

const summaryRows = [

["EPC BUDGET ESTIMATE"],

[],

["PROJECT INFORMATION","VALUE"],

["Country",data.countryName],

["Project Type",data.type],

["Project Details",data.details],

["Capacity Entered (MW / MWp)",data.capacity],

["Calculated DC Capacity (MWp)",data.actualCapacity],

["Market Factor",data.marketFactor],

[],

["EPC COST BREAKDOWN"],

["Work Category","Base Cost (€)","Market Factor","Estimated Cost (€)"]

];


data.costs.forEach(item=>{

summaryRows.push(item);

});


summaryRows.push([]);

summaryRows.push([

"TOTAL EPC COST",

"",

"",

data.total

]);

summaryRows.push([

"EPC COST PER MW",

data.costPerMW

]);

summaryRows.push([]);

summaryRows.push([

"Material reference values are NOT added again to EPC total."

]);


// MATERIAL SHEET

const materialRows = [

[

"Material / Equipment",

"Estimated Quantity",

"Unit",

"Indicative Unit Price (€)",

"Reference Total (€)"

]

];


data.materials.forEach(item=>{

materialRows.push([

item[0],

item[1],

item[2],

item[3],

item[1]*item[3]

]);

});


materialRows.push([]);

materialRows.push([

"TOTAL MATERIAL REFERENCE VALUE",

"",

"",

"",

data.materialTotal

]);


// WORKBOOK

const workbook = XLSX.utils.book_new();

const summarySheet = XLSX.utils.aoa_to_sheet(summaryRows);

const materialSheet = XLSX.utils.aoa_to_sheet(materialRows);


XLSX.utils.book_append_sheet(
workbook,
summarySheet,
"EPC Summary"
);

XLSX.utils.book_append_sheet(
workbook,
materialSheet,
"Material Reference"
);


const filename =

"EPC_Budget_"+
data.country+
"_"+
data.type+
"_"+
data.capacity+
"MW.xlsx";


XLSX.writeFile(workbook,filename);

}


// ========================================
// 14. RESET
// ========================================

function resetCalculator() {

document.querySelectorAll("input").forEach(input=>{

input.value="";

});


[

"country",
"projectType",
"solarTechnology",
"modulePower",
"mountingType",
"batteryChemistry",
"dataCenterTier",
"coolingType"

].forEach(id=>{

document.getElementById(id).value="";

});


document.getElementById("modulesPerString").value=28;

document.getElementById("inverterRating").value=350;

document.getElementById("results").style.display="none";

lastCalculation=null;

updateProjectOptions();

window.scrollTo({

top:0,
behavior:"smooth"

});

}


updateProjectOptions();

</script>

</body>
</html>
