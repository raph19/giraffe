
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Budget Estimate Calculator</title>

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
*{box-sizing:border-box}
body{margin:0;background:#f3f6fa;font-family:Arial,sans-serif;color:#263445}
.welcome{background:linear-gradient(120deg,#102c46,#176b87);color:#fff;padding:38px 20px;text-align:center;position:relative}
.welcome h1{font-size:30px;font-weight:bold;margin:0 0 10px}
.welcome p{color:#d5e6ef;font-size:15px;margin:0}
.language{position:absolute;right:22px;top:17px;display:flex;align-items:center;gap:5px;background:rgba(255,255,255,.12);padding:5px 8px;border-radius:9px}
.language span{font-size:20px;line-height:1}
.language select{background:#fff;color:#263445;border:0;border-radius:6px;padding:8px 10px;font-size:13px;outline:none;max-width:145px}
.main-container{max-width:1180px;margin:32px auto;padding:0 20px}
.panel-custom{background:#fff;padding:25px;border-radius:12px;margin-bottom:24px;box-shadow:0 3px 15px rgba(0,0,0,.06)}
.panel-custom h3{margin:0 0 24px;font-weight:bold;color:#174b68;border-bottom:2px solid #edf1f5;padding-bottom:14px}
.form-group{margin-bottom:19px}
label{font-weight:600;margin-bottom:8px}
.form-control{height:43px;border-radius:7px;border:1px solid #d8e0e8;box-shadow:none}
.form-control:focus{border-color:#1683a5;box-shadow:0 0 5px rgba(22,131,165,.2)}
.btn-calculate{background:#087b9b;color:white;font-weight:bold;border:0;padding:13px 25px;border-radius:7px;font-size:14px;margin:10px 8px 0 0}
.btn-calculate:hover{background:#075e78;color:white}
.btn-secondary{background:#647789}
.btn-secondary:hover{background:#465b6c;color:white}
.result-card{background:linear-gradient(120deg,#123d58,#087b9b);color:white;padding:26px;border-radius:12px;margin-bottom:24px}
.result-card h4{color:#d6eaf2;margin-top:0}
.result-card h2{font-size:36px;font-weight:bold;margin:7px 0}
.table{margin-bottom:0}
.table thead{background:#edf3f7}
.table th,.table td{padding:12px!important;vertical-align:middle!important}
.total-row{font-weight:bold;background:#e8f3f7}
.hidden-results{display:none}
.note{color:#758493;font-size:12px;margin-top:12px;line-height:1.6}
.status-line{font-size:12px;color:#60798a;margin:10px 0 0}
.derived{background:#f5f9fb;border:1px dashed #c9dbe5;padding:10px 12px;border-radius:7px;color:#456273;font-size:12px;margin-top:5px}
.table-responsive{border-radius:6px}
.optional-box{border:1px solid #dce7ed;border-radius:10px;margin:10px 0 22px;overflow:hidden}
.optional-box summary{cursor:pointer;list-style:none;padding:16px 18px;background:#f1f7fa;color:#174b68;font-weight:bold;display:flex;align-items:center;justify-content:space-between}
.optional-box summary::-webkit-details-marker{display:none}
.optional-box summary:after{content:"＋";font-size:20px;color:#087b9b}
.optional-box[open] summary:after{content:"−"}
.optional-content{padding:20px 18px 5px;background:#fff}
.optional-description{font-size:12px;color:#718494;line-height:1.6;margin-bottom:18px}
.assumptions-wrap{background:linear-gradient(120deg,#123d58,#087b9b);border-radius:12px;padding:25px;color:white}
.assumptions-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:17px}
.assumptions-head h3{border:0;margin:0;padding:0;color:white}
.assumptions-head span{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#d6eaf2;font-weight:bold}
.assumption-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
.assumption-card{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.22);border-radius:11px;padding:17px 18px;min-height:120px}
.assumption-card .eyebrow{font-size:11px;color:#bce8f5;text-transform:uppercase;letter-spacing:.08em;font-weight:bold;margin-bottom:7px}
.assumption-card h4{font-size:15px;color:white;font-weight:bold;margin:0 0 7px}
.assumption-card p{font-size:12px;line-height:1.55;color:#e0edf3;margin:0}
.assumption-wide{grid-column:1/-1}
footer{text-align:center;padding:24px;color:#84919e;font-size:12px}
[dir=rtl]{direction:rtl;text-align:right}
[dir=rtl] .language{right:auto;left:22px}
[dir=rtl] .btn-calculate{margin:10px 0 0 8px}
[dir=rtl] .optional-box summary:after{margin-right:10px}
[dir=rtl] .table th,[dir=rtl] .table td{text-align:right}
@media(max-width:767px){
 .welcome{padding:75px 16px 27px}
 .welcome h1{font-size:24px}
 .welcome p{font-size:13px}
 .language{top:12px;right:12px;left:auto}
 [dir=rtl] .language{left:12px;right:auto}
 .main-container{margin:18px auto;padding:0 12px}
 .panel-custom{padding:17px}
 .assumption-grid{grid-template-columns:1fr}
 .assumption-wide{grid-column:auto}
 .result-card{padding:20px}
 .result-card h2{font-size:28px}
 .btn-calculate{width:100%;margin:7px 0}
 .optional-content{padding:15px 12px}
 .table th,.table td{font-size:12px;white-space:normal}
}
@media print{
 .language,.btn-calculate,.optional-box,footer{display:none!important}
 body{background:white}
 .panel-custom,.result-card{box-shadow:none;break-inside:avoid}
}
</style>
</head>

<body>

<section class="welcome">
 <div class="language">
  <span>🌐</span>
  <select id="language" aria-label="Language">
   <option value="en">English</option>
   <option value="el">Ελληνικά</option>
   <option value="de">Deutsch</option>
   <option value="fr">Français</option>
   <option value="ar">العربية</option>
  </select>
 </div>
 <h1 data-i18n="title">Budget Estimate Calculator</h1>
 <p data-i18n="subtitle">Preliminary EPC Project Cost Estimation Tool</p>
</section>

<div class="main-container">

<form id="budgetForm" novalidate>

<div class="panel-custom">

<h3 data-i18n="projectInfo">Project Information</h3>

<div class="row">

 <div class="col-md-6">
  <div class="form-group">
   <label for="country" data-i18n="country">Country / Market</label>
   <select id="country" class="form-control" required>
    <option value="" data-i18n="selectCountry">Select Country</option>
   </select>
  </div>
 </div>

 <div class="col-md-6">
  <div class="form-group">
   <label for="projectType" data-i18n="projectType">Project Type</label>
   <select id="projectType" class="form-control" required>
    <option value="" data-i18n="selectProject">Select Project</option>
    <option value="solar" data-i18n="solar">Solar PV</option>
    <option value="bess" data-i18n="bess">BESS</option>
    <option value="datacenter" data-i18n="datacenter">Data Center</option>
   </select>
  </div>
 </div>

 <div class="col-md-6">
  <div class="form-group">
   <label id="capacityLabel" for="capacity">Project Capacity (MW)</label>
   <input id="capacity" class="form-control" type="number" min="0.01" step="any" required placeholder="Enter capacity">
  </div>
 </div>

 <div class="col-md-6" id="solarTechnologyGroup" style="display:none">
  <div class="form-group">
   <label for="solarTechnology" data-i18n="technology">PV Module Technology</label>
   <select id="solarTechnology" class="form-control">
    <option value="" data-i18n="selectTechnology">Select Technology</option>
    <option value="topcon_mono">N-type TOPCon Monofacial</option>
    <option value="topcon_bifacial">N-type TOPCon Bifacial</option>
   </select>
  </div>
 </div>

 <div class="col-md-6" id="modulePowerGroup" style="display:none">
  <div class="form-group">
   <label for="modulePower" data-i18n="modulePower">PV Module Power (Wp)</label>
   <select id="modulePower" class="form-control">
    <option value="" data-i18n="selectPower">Select Module Power</option>
    <option>450</option><option>500</option><option>550</option>
    <option>575</option><option>600</option><option>610</option>
    <option>620</option><option>630</option><option>640</option>
    <option>650</option><option>700</option>
   </select>
  </div>
 </div>

 <div class="col-md-6" id="mountingGroup" style="display:none">
  <div class="form-group">
   <label for="mountingType" data-i18n="mounting">Mounting System</label>
   <select id="mountingType" class="form-control">
    <option value="" data-i18n="selectMounting">Select Mounting System</option>
    <option value="fixed" data-i18n="fixed">Fixed Tilt</option>
    <option value="tracker" data-i18n="tracker">Single Axis Tracker</option>
   </select>
  </div>
 </div>

 <div class="col-md-6" id="invertersGroup" style="display:none">
  <div class="form-group">
   <label for="inverters" data-i18n="inverters">Number of Inverters</label>
   <input id="inverters" class="form-control" type="number" min="1" step="1">
  </div>
 </div>

 <div class="col-md-6" id="substationsGroup" style="display:none">
  <div class="form-group">
   <label for="substations" data-i18n="substations">Number of MV Substations</label>
   <input id="substations" class="form-control" type="number" min="1" step="1">
  </div>
 </div>

 <div class="col-md-6" id="modulesStringGroup" style="display:none">
  <div class="form-group">
   <label for="modulesPerString" data-i18n="modulesString">Modules per String</label>
   <input id="modulesPerString" class="form-control" type="number" min="1" step="1">
  </div>
 </div>

</div>

<!-- All optional inputs in one expandable section -->

<details class="optional-box" id="optionalDetails">
 <summary data-i18n="optionalTitle">Optional Project Details – Expand</summary>
 <div class="optional-content">
  <p class="optional-description" data-i18n="optionalDescription">
   Enter actual route lengths if available. If left blank, the calculator will use indicative project assumptions based on installed capacity.
  </p>

  <div class="row">

   <div class="col-md-6" id="mvCableGroup" style="display:none">
    <div class="form-group">
     <label for="mvCableLength" data-i18n="mvCable">MV Cable Route Length (m)</label>
     <input id="mvCableLength" class="form-control" type="number" min="0" step="any">
    </div>
   </div>

   <div class="col-md-6" id="dcCableGroup" style="display:none">
    <div class="form-group">
     <label for="dcCableLength" data-i18n="dcCable">DC Cable Length (m)</label>
     <input id="dcCableLength" class="form-control" type="number" min="0" step="any">
    </div>
   </div>

   <div class="col-md-6" id="acCableGroup" style="display:none">
    <div class="form-group">
     <label for="acCableLength" data-i18n="acCable">AC LV Cable Length (m)</label>
     <input id="acCableLength" class="form-control" type="number" min="0" step="any">
    </div>
   </div>

   <div class="col-md-6" id="hvCableGroup" style="display:none">
    <div class="form-group">
     <label for="hvCableLength" data-i18n="hvCable">HV / Export Cable Length (m)</label>
     <input id="hvCableLength" class="form-control" type="number" min="0" step="any">
    </div>
   </div>

   <div class="col-md-6" id="fibreCableGroup" style="display:none">
    <div class="form-group">
     <label for="fibreCableLength" data-i18n="fibreCable">Fibre Optic Cable Length (m)</label>
     <input id="fibreCableLength" class="form-control" type="number" min="0" step="any">
    </div>
   </div>

   <div class="col-md-6" id="roadLengthGroup" style="display:none">
    <div class="form-group">
     <label for="roadLength" data-i18n="roadLength">Access Road Length (m)</label>
     <input id="roadLength" class="form-control" type="number" min="0" step="any">
    </div>
   </div>

  </div>
 </div>
</details>

<!-- BESS options -->

<div class="row">

 <div class="col-md-6" id="durationGroup" style="display:none">
  <div class="form-group">
   <label for="duration" data-i18n="duration">BESS Duration (Hours)</label>
   <input id="duration" class="form-control" type="number" min="0.5" step="any">
  </div>
 </div>

 <div class="col-md-6" id="chemistryGroup" style="display:none">
  <div class="form-group">
   <label for="batteryChemistry" data-i18n="chemistry">Battery Chemistry</label>
   <select id="batteryChemistry" class="form-control">
    <option value="" data-i18n="selectChemistry">Select Chemistry</option>
    <option value="LFP">LFP</option>
    <option value="NMC">NMC</option>
   </select>
  </div>
 </div>

 <div class="col-md-6" id="tierGroup" style="display:none">
  <div class="form-group">
   <label for="dataCenterTier" data-i18n="tier">Data Center Tier</label>
   <select id="dataCenterTier" class="form-control">
    <option value="" data-i18n="selectTier">Select Tier</option>
    <option>Tier II</option><option>Tier III</option><option>Tier IV</option>
   </select>
  </div>
 </div>

 <div class="col-md-6" id="coolingGroup" style="display:none">
  <div class="form-group">
   <label for="coolingType" data-i18n="cooling">Cooling System</label>
   <select id="coolingType" class="form-control">
    <option value="" data-i18n="selectCooling">Select Cooling</option>
    <option data-i18n="airCooling">Air Cooling</option>
    <option data-i18n="liquidCooling">Liquid Cooling</option>
   </select>
  </div>
 </div>

</div>

<div id="solarDerived" class="derived" style="display:none"></div>

<button class="btn btn-calculate" type="submit" data-i18n="calculate">Calculate Budget</button>
<button class="btn btn-calculate btn-secondary" type="button" id="resetBtn" data-i18n="reset">Reset</button>

<p class="note" data-i18n="inputNote">
 Budget updates automatically when you change a project input.
</p>

<p id="validationMessage" class="status-line" role="status"></p>

</div>
</form>

<div id="results" class="hidden-results">

 <div class="result-card">
  <h4 data-i18n="totalEpc">Total Estimated EPC Cost</h4>
  <h2 id="totalBudget">€0</h2>
  <p id="projectSummary"></p>
  <p id="marketSummary"></p>
  <h4 id="costPerMW"></h4>
 </div>

 <div class="panel-custom">
  <h3 data-i18n="breakdown">EPC Cost Breakdown</h3>
  <div class="table-responsive">
   <table class="table table-bordered">
    <thead>
     <tr>
      <th data-i18n="category">Work Category</th>
      <th data-i18n="baseCost">Base Cost (€)</th>
      <th data-i18n="factor">Market Factor</th>
      <th data-i18n="estimatedCost">Estimated Cost (€)</th>
     </tr>
    </thead>
    <tbody id="costTable"></tbody>
    <tfoot>
     <tr class="total-row">
      <td colspan="3" data-i18n="total">TOTAL EPC COST</td>
      <td id="costTotal">€0</td>
     </tr>
    </tfoot>
   </table>
  </div>
  <p class="note" data-i18n="epcNote">EPC total includes procurement, construction, installation, engineering, commissioning and contingency.</p>
 </div>

 <div class="panel-custom">
  <h3 data-i18n="materialReference">Material / Equipment Reference</h3>
  <div class="table-responsive">
   <table class="table table-bordered">
    <thead>
     <tr>
      <th data-i18n="material">Material / Equipment</th>
      <th data-i18n="quantity">Estimated Quantity</th>
      <th data-i18n="unit">Unit</th>
      <th data-i18n="unitPrice">Indicative Unit Price (€)</th>
      <th data-i18n="referenceTotal">Reference Total (€)</th>
     </tr>
    </thead>
    <tbody id="materialTable"></tbody>
    <tfoot>
     <tr class="total-row">
      <td colspan="4" data-i18n="referenceSum">TOTAL MATERIAL REFERENCE VALUE</td>
      <td id="materialTotal">€0</td>
     </tr>
    </tfoot>
   </table>
  </div>
  <p class="note" data-i18n="materialNote">Reference values are informational only and are already included in the EPC estimate.</p>
  <p class="note" id="assumptionNote"></p>
 </div>

 <div class="panel-custom">
  <div class="assumptions-wrap">
   <div class="assumptions-head">
    <h3 data-i18n="assumptions">Project Assumptions & Cost Parameters</h3>
    <span data-i18n="budgetary">Budgetary model</span>
   </div>
   <div class="assumption-grid">

    <div class="assumption-card">
     <div class="eyebrow" data-i18n="marketAdjustment">01 · Market</div>
     <h4 data-i18n="countryFactor">Country adjustment</h4>
     <p data-i18n="countryFactorText">Country factor adjusts labour, logistics and installation costs.</p>
    </div>

    <div class="assumption-card">
     <div class="eyebrow" data-i18n="epcScope">02 · EPC scope</div>
     <h4 data-i18n="turnkey">Turnkey cost structure</h4>
     <p data-i18n="turnkeyText">The EPC estimate includes procurement, civil and electrical works, installation and commissioning.</p>
    </div>

    <div class="assumption-card">
     <div class="eyebrow" data-i18n="contingencyLabel">03 · Risk allowance</div>
     <h4 data-i18n="contingency">Contingency / Unforeseen costs</h4>
     <p data-i18n="contingencyText">A budget reserve for design changes and unforeseen site conditions.</p>
    </div>

    <div class="assumption-card">
     <div class="eyebrow" data-i18n="pricing">04 · Pricing</div>
     <h4 data-i18n="bulk">Bulk procurement references</h4>
     <p data-i18n="bulkText">Indicative project-scale procurement levels, not retail prices or binding quotations.</p>
    </div>

    <div class="assumption-card assumption-wide">
     <div class="eyebrow" data-i18n="projectConsiderations">05 · Project definition</div>
     <h4 data-i18n="siteSpecific">Site-specific cost factors</h4>
     <p data-i18n="siteSpecificText">Final costs depend on grid connection, geotechnical conditions, detailed design, cable routes, taxes, transport, equipment and EPC contract boundaries.</p>
    </div>

   </div>
  </div>
 </div>

 <button class="btn btn-calculate" type="button" id="exportBtn" data-i18n="excel">Download Excel</button>
 <button class="btn btn-calculate" type="button" onclick="window.print()" data-i18n="print">Print / Save as PDF</button>

</div>
</div>

<footer data-i18n="footer">Budget Estimate Calculator | Preliminary EPC Estimation</footer>

<script>
const $ = id => document.getElementById(id);

const countryCodes = `AD AE AL AM AO AR AT AU AZ BA BE BG BH BR BY CA CH CL CN CO CR CY CZ DE DK EE ES FI FR GB GE GR HR HU ID IE IL IN IS IT JP KR LT LU LV MA ME MK MT MX MY NL NO NZ PH PL PT RO RS SA SE SG SI SK TR TW UA US VN ZA`.split(/\s+/);

const localeMap = {en:'en',el:'el',de:'de',fr:'fr',ar:'ar'};
let countryNames;

function refreshCountries(){
 const lang = $('language').value;
 countryNames = new Intl.DisplayNames([localeMap[lang] || 'en'],{type:'region'});
 const select = $('country');
 const previous = select.value;
 select.innerHTML = `<option value="" data-i18n="selectCountry">${tr('selectCountry')}</option>`;
 countryCodes.sort((a,b)=>countryNames.of(a).localeCompare(countryNames.of(b),localeMap[lang])).forEach(code=>{
  const option=document.createElement('option');
  option.value=code;
  option.textContent=countryNames.of(code);
  select.appendChild(option);
 });
 select.value=previous;
}

/* Original country market factors */

const countryRates = {
 IE:1,GB:1.04,DE:1.02,FR:1,NL:1.03,BE:1.02,
 ES:.88,PT:.86,IT:.96,GR:.83,US:1.08,CA:1.1,
 AU:1.08,JP:1.15,KR:1.02,IN:.55,CN:.62,BR:.75,
 ZA:.7,SA:.9,AE:.93,PL:.78,RO:.7,BG:.68,
 SE:1.05,NO:1.13,DK:1.07,FI:1.03,TR:.72
};

/* Original PV module prices */

const moduleOptions = {
 topcon_mono:{name:'N-type TOPCon Monofacial',price:.120},
 topcon_bifacial:{name:'N-type TOPCon Bifacial',price:.114}
};

/* Original EPC base rates */

const rates = {
 solar:{civil:110000,mechanical:90000,electrical:160000},
 bess:{civil:300000,mechanical:0,electrical:0,batteryPerMWh:93000,contingency:.05},
 datacenter:{civil:1200000,mechanical:2400000,electrical:3800000}
};

/*
Indicative optional-length assumptions.
These are used only when the user leaves a field blank.
User-entered quantities always override them.
*/

const lengthAssumptions = {
 dc:1200,       // metres per MWp
 ac:120,        // metres per MW
 mv:180,        // metres per MW
 hv:100,        // metres per MW
 fibre:150,     // metres per MW
 road:70        // metres per MW
};

let lastCalculation=null;
let autoTimer=null;

/* Complete language dictionaries */

const labels = {

en:{
 title:'Budget Estimate Calculator',subtitle:'Preliminary EPC Project Cost Estimation Tool',
 projectInfo:'Project Information',country:'Country / Market',selectCountry:'Select Country',
 projectType:'Project Type',selectProject:'Select Project',solar:'Solar PV',bess:'BESS',datacenter:'Data Center',
 technology:'PV Module Technology',selectTechnology:'Select Technology',modulePower:'PV Module Power (Wp)',
 selectPower:'Select Module Power',mounting:'Mounting System',selectMounting:'Select Mounting System',
 fixed:'Fixed Tilt',tracker:'Single Axis Tracker',inverters:'Number of Inverters',
 substations:'Number of MV Substations',modulesString:'Modules per String',
 optionalTitle:'Optional Project Details – Expand',optionalDescription:'Enter actual route lengths if available. If left blank, indicative project assumptions based on installed capacity will be used.',
 mvCable:'MV Cable Route Length (m)',dcCable:'DC Cable Length (m)',acCable:'AC LV Cable Length (m)',
 hvCable:'HV / Export Cable Length (m)',fibreCable:'Fibre Optic / Communication Cable Length (m)',
 roadLength:'Access Road Length (m)',duration:'BESS Duration (Hours)',chemistry:'Battery Chemistry',
 selectChemistry:'Select Chemistry',tier:'Data Center Tier',selectTier:'Select Tier',
 cooling:'Cooling System',selectCooling:'Select Cooling',airCooling:'Air Cooling',liquidCooling:'Liquid Cooling',
 calculate:'Calculate Budget',reset:'Reset',inputNote:'Budget updates automatically when you change a project input. Press Enter to calculate manually.',
 totalEpc:'Total Estimated EPC Cost',breakdown:'EPC Cost Breakdown',category:'Work Category',
 baseCost:'Base Cost (€)',factor:'Market Factor',estimatedCost:'Estimated Cost (€)',total:'TOTAL EPC COST',
 epcNote:'EPC total includes equipment procurement, construction, installation, engineering, commissioning and contingency.',
 materialReference:'Material / Equipment Reference',material:'Material / Equipment',quantity:'Estimated Quantity',
 unit:'Unit',unitPrice:'Indicative Unit Price (€)',referenceTotal:'Reference Total (€)',
 referenceSum:'TOTAL MATERIAL REFERENCE VALUE',
 materialNote:'Reference values are informational only. They are already represented within the EPC estimate and are NOT added again.',
 assumptions:'Project Assumptions & Cost Parameters',budgetary:'Budgetary model',
 marketAdjustment:'01 · Market',countryFactor:'Country adjustment',
 countryFactorText:'The selected country factor adjusts labour, logistics, installation and local subcontractor costs.',
 epcScope:'02 · EPC scope',turnkey:'Turnkey cost structure',
