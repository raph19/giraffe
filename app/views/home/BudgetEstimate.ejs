let currentLanguage = "en";

function t(key) {
    return translations[currentLanguage][key] ||
           translations.en[key] ||
           key;
}

function changeLanguage(language) {
    currentLanguage = language;

    document.documentElement.lang = language;
    document.documentElement.dir = language === "ar" ? "rtl" : "ltr";

    document.getElementById("languageSelect").value = language;

    document.querySelectorAll("[data-i18n]").forEach(element => {
        const key = element.getAttribute("data-i18n");

        if (translations[language][key]) {
            element.textContent = translations[language][key];
        }
    });

    document.getElementById("capacity").placeholder = t("enterCapacity");
    document.getElementById("modulePower").placeholder = t("enterModulePower");
    document.getElementById("inverterCount").placeholder = t("enterInverters");
    document.getElementById("substationCount").placeholder = t("enterSubstations");
    document.getElementById("modulesPerString").placeholder = t("enterModulesPerString");

    updateProjectOptions();

    if (lastCalculation) {
        renderResults(lastCalculation);
    }
}


// =============================================
// PROJECT OPTIONS
// =============================================

function updateProjectOptions() {

    const type = document.getElementById("projectType").value;

    const groups = [
        "solarOptions",
        "modulePowerGroup",
        "mountingGroup",
        "invertersGroup",
        "substationsGroup",
        "modulesPerStringGroup",
        "durationGroup",
        "chemistryGroup",
        "tierGroup",
        "coolingGroup"
    ];

    groups.forEach(id => {
        document.getElementById(id).style.display = "none";
    });

    const label = document.getElementById("capacityLabel");

    if (type === "solar") {
        label.textContent = t("capacity").replace("(MW)", "(MWp)");

        [
            "solarOptions",
            "modulePowerGroup",
            "mountingGroup",
            "invertersGroup",
            "substationsGroup",
            "modulesPerStringGroup"
        ].forEach(id => {
            document.getElementById(id).style.display = "block";
        });

    } else if (type === "bess") {
        label.textContent = t("capacity");

        document.getElementById("durationGroup").style.display = "block";
        document.getElementById("chemistryGroup").style.display = "block";

    } else if (type === "datacenter") {
        label.textContent = t("capacity");

        document.getElementById("tierGroup").style.display = "block";
        document.getElementById("coolingGroup").style.display = "block";

    } else {
        label.textContent = t("capacity");
    }
}


// =============================================
