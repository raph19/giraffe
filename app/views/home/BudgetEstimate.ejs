
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EPC Project Budget Estimator</title>

<link rel="stylesheet"
href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css">

<style>
:root {
    --navy: #173b57;
    --blue: #246b91;
    --teal: #249b91;
    --background: #f3f6fa;
    --border: #e4eaf0;
    --text: #263746;
    --muted: #718096;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: "Segoe UI", Arial, sans-serif;
}

.header {
    background: linear-gradient(120deg, #14344f, #246b91);
    color: white;
    padding: 35px 20px;
}

.header-inner {
    max-width: 1050px;
    margin: auto;
}

.header h1 {
    font-size: 29px;
    font-weight: 700;
    margin: 0 0 9px;
}

.header p {
    margin: 0;
    color: #dceaf2;
    font-size: 14px;
}

.header-label {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: rgba(255,255,255,.13);
    padding: 6px 10px;
    border-radius: 20px;
    margin-bottom: 14px;
}

.main-container {
    max-width: 1050px;
    margin: 30px auto;
    padding: 0 15px 40px;
}

.panel {
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 26px;
    margin-bottom: 22px;
    box-shadow: 0 3px 12px rgba(25,55,80,.04);
}

.section-title {
    color: var(--navy);
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 7px;
}

.section-subtitle {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 23px;
}

.form-group {
    margin-bottom: 20px;
}

label {
    font-size: 13px;
    font-weight: 600;
    color: #405466;
    margin-bottom: 8px;
}

.form-control {
    height: 44px;
    border: 1px solid #dce4eb;
    border-radius: 6px;
    box-shadow: none;
    font-size: 14px;
}

.form-control:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 2px rgba(36,107,145,.10);
}

.form-control::placeholder {
    color: #a5b0ba;
}

.button-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 5px;
}

.btn-primary-custom {
    background: var(--navy);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 25px;
    font-weight: 600;
}

.btn-primary-custom:hover,
.btn-primary-custom:focus {
    background: var(--blue);
    color: white;
}

.btn-secondary-custom {
    background: white;
    color: #536779;
    border: 1px solid #dce4eb;
    border-radius: 6px;
    padding: 12px 20px;
}

.btn-secondary-custom:hover {
    background: #f4f7fa;
}

#results {
    display: none;
}

.result-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
}

.status-label {
    color: #21816d;
    background: #e7f5f0;
    border-radius: 20px;
    padding: 6px 11px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}

.summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 13px;
}

.summary-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 18px 15px;
    background: #fff;
    min-width: 0;
}

.summary-card .card-label {
    color: var(--muted);
    font-size: 12px;
    display: block;
    margin-bottom: 10px;
}

.summary-card .card-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--navy);
    word-break: break-word;
}

.summary-card.profit-card {
    background: #f0f8f4;
    border-color: #d8ede1;
}

.summary-card.profit-card .card-value {
    color: #21805a;
}

.selling-price {
    background: linear-gradient(110deg, #173b57, #246b91);
    color: white;
    border-radius: 9px;
    padding: 25px;
    margin-top: 16px;
    text-align: center;
}

.selling-price .label-text {
    font-size: 13px;
    color: #dceaf2;
}

.selling-price .price {
    font-size: 34px;
    font-weight: 700;
    margin-top: 8px;
    word-break: break-word;
}

.selling-price .description {
    font-size: 12px;
    color: #dceaf2;
    margin-top: 5px;
}

.table {
    margin-bottom: 0;
}

.table th {
    background: #f0f4f8;
    color: #405466;
    font-size: 12px;
    border-bottom: 1px solid var(--border) !important;
}

.table td {
    font-size: 13px;
    vertical-align: middle !important;
}

.table .total-row {
    font-weight: 700;
    background: #f0f5f8;
    color: var(--navy);
}

.project-info {
    background: #f6f8fb;
    padding: 15px;
    border-radius: 7px;
    margin-top: 18px;
    color: #536779;
    font-size: 13px;
}

.assumption {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
    margin-top: 15px;
}

.footer {
    text-align: center;
    color: #8a98a5;
    font-size: 12px;
    padding: 15px;
}

@media (max-width: 767px) {
    .summary-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .panel {
        padding: 19px;
    }

    .header h1 {
        font-size: 24px;
    }

    .selling-price .price {
        font-size: 27px;
    }
}

@media print {
    body {
        background: white;
    }

    .header {
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
    }

    .no-print {
        display: none !important;
    }

    #results {
        display: block !important;
    }

    .panel {
        box-shadow: none;
        break-inside: avoid;
    }

    .selling-price {
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
    }
}
</style>
</head>

<body>

<header class="header">
    <div class="header-inner">
        <div class="header-label">Project Management & Cost Control</div>
        <h1>EPC Project Budget Estimator</h1>
        <p>Preliminary cost estimation and EPC selling price calculation</p>
    </div>
</header>

<div class="main-container">

    <div class="panel">
        <h3 class="section-title">Project Information</h3>
        <p class="section-subtitle">
            Enter your project details to generate an indicative EPC budget.
        </p>

        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    <label for="country">Project Country *</label>
                    <select id="country" class="form-control">
                        <option value="">Select country</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="projectType">Project Type *</label>
                    <select id="projectType" class="form-control">
                        <option value="">Select project type</option>
                        <option value="solar">Solar PV</option>
                        <option value="bess">Battery Energy Storage (BESS)</option>
                        <option value="datacenter">Data Center</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="capacity">Project Capacity (MW) *</label>
                    <input type="number" id="capacity"
                           class="form-control"
                           placeholder="Enter project capacity"
                           min="0.1" step="0.1">
                </div>
            </div>

            <div class="col-md-6" id="durationGroup" style="display:none;">
                <div class="form-group">
                    <label for="duration">BESS Duration *</label>
                    <select id="duration" class="form-control">
                        <option value="">Select duration</option>
                        <option value="2">2 Hours</option>
                        <option value="4">4 Hours</option>
                        <option value="6">6 Hours</option>
                        <option value="8">8 Hours</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="margin">Target Profit Margin (%) *</label>
                    <input type="number" id="margin"
                           class="form-control"
                           placeholder="Enter target margin"
                           min="0" max="99.9" step="0.01">
                </div>
            </div>

        </div>

        <div class="button-row no-print">
            <button class="btn btn-primary-custom"
                    onclick="calculateBudget()">
                Calculate Budget
            </button>

            <button class="btn btn-secondary-custom"
                    onclick="resetCalculator()">
                Reset
            </button>
        </div>

    </div>


    <div id="results">

        <div class="panel">

            <div class="result-heading">
                <h3 class="section-title">Financial Overview</h3>
                <span class="status-label">Estimate Generated</span>
            </div>

            <div class="summary-grid">

                <div class="summary-card">
                    <span class="card-label">Civil Works</span>
                    <div class="card-value" id="civilCost">€0</div>
                </div>

                <div class="summary-card">
                    <span class="card-label">Mechanical Works</span>
                    <div class="card-value" id="mechanicalCost">€0</div>
                </div>

                <div class="summary-card">
                    <span class="card-label">Electrical Works</span>
                    <div class="card-value" id="electricalCost">€0</div>
                </div>

                <div class="summary-card">
                    <span class="card-label">Additional Costs</span>
                    <div class="card-value" id="extraCost">€0</div>
                </div>

                <div class="summary-card">
                    <span class="card-label">Total EPC Cost</span>
                    <div class="card-value" id="totalCost">€0</div>
                </div>

                <div class="summary-card">
                    <span class="card-label">Profit Margin</span>
                    <div class="card-value" id="marginResult">0%</div>
                </div>

                <div class="summary-card profit-card">
                    <span class="card-label">Estimated Profit</span>
                    <div class="card-value" id="profit">€0</div>
                </div>

                <div class="summary-card">
                    <span class="card-label">Cost per MW</span>
                    <div class="card-value" id="costPerMW">€0</div>
                </div>

            </div>

            <div class="selling-price">
                <div class="label-text">EPC Selling Price to Customer</div>
                <div class="price" id="sellingPrice">€0</div>
                <div class="description">
                    Total estimated contract value
                </div>
            </div>

            <div class="project-info" id="projectDetails"></div>

        </div>


        <div class="panel">

            <h3 class="section-title">EPC Cost Breakdown</h3>
            <p class="section-subtitle">
                Estimated cost allocation by project work category.
            </p>

            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Cost Category</th>
                            <th>Estimated Cost per MW</th>
                            <th>Total Estimated Cost</th>
                        </tr>
                    </thead>

                    <tbody id="breakdownTable"></tbody>
                </table>
            </div>

            <div class="assumption">
                <strong>Estimation notes</strong><br>
                The calculation uses indicative base EPC cost assumptions
                and country adjustment factors. Results are preliminary
                estimates and should be validated against project-specific
                BOQs, supplier quotations, site conditions and grid
                connection requirements.
                <br><br>
                The profit margin is calculated as a percentage of the
                EPC selling price, not as a markup on cost.
            </div>

            <div class="button-row no-print">
                <button class="btn btn-primary-custom"
                        onclick="window.print()">
                    Print / Save as PDF
                </button>
            </div>

        </div>

    </div>

    <div class="footer">
        EPC Project Budget Estimator | Preliminary Planning Tool
    </div>

</div>


<script>

// ---------------------------------------------
// COUNTRIES
// ---------------------------------------------

const countryCodes = `
AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ
BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT
BV BW BY BZ CA CC CD CF CG CH CI CK CL CM CN CO CR
CU CV CW CX CY CZ DE DJ DK DM DO DZ EC EE EG EH ER
ES ET FI FJ FK FO FR GA GB GD GE GF GG GH GI GL GM GN
GP GQ GR GT GU GW GY HK HN HR HT HU ID IE IL IM IN
IO IQ IR IS IT JE JM JO JP KE KG KH KI KM KN KR KW
KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME
MG MH MK ML MM MN MO MP MQ MR MS MT MU MV MW MX MY
MZ NA NC NE NG NI NL NO NP NR NU NZ OM PA PE PF PG
PH PK PL PR PT PW PY QA RO RS RU RW SA SB SC SD SE
SG SI SK SL SM SN SO SR SS ST SV SX SY SZ TC TD TF
TG TH TJ TL TM TN TO TR TT TW TZ UA UG US UY UZ VA
VC VE VG VI VN VU WF WS YE ZA ZM ZW
`.trim().split(/\s+/);

const countryNames = new Intl.DisplayNames(['en'], {
    type: 'region'
});

const countrySelect = document.getElementById('country');

countryCodes
    .map(code => ({
        code: code,
        name: countryNames.of(code)
    }))
    .filter(item => item.name && item.name !== item.code)
    .sort((a, b) => a.name.localeCompare(b.name))
    .forEach(item => {
        const option = document.createElement('option');
        option.value = item.code;
        option.textContent = item.name;
        countrySelect.appendChild(option);
    });


// ---------------------------------------------
// COUNTRY ADJUSTMENT FACTORS
// ---------------------------------------------

const countryFactors = {
    IE: 1.12,
    DE: 1.08,
    FR: 1.05,
    NL: 1.07,
    BE: 1.06,
    ES: 0.94,
    PT: 0.91,
    IT: 1.00,
    GR: 0.88,
    GB: 1.13,
    US: 1.18,
    CA: 1.15,
    AU: 1.16,
    JP: 1.20,
    KR: 1.10,
    IN: 0.65,
    CN: 0.72,
    BR: 0.83,
    ZA: 0.78,
    SA: 0.96,
    AE: 1.04,
    PL: 0.84,
    RO: 0.76,
    BG: 0.72,
    TR: 0.68,
    SE: 1.12,
    NO: 1.25,
    DK: 1.14,
    FI: 1.08
};


// ---------------------------------------------
// BASE EPC RATES PER MW (€)
// ---------------------------------------------

const projectRates = {
    solar: {
        civil: 110000,
        mechanical: 90000,
        electrical: 160000,
        extra: 0
    },

    bess: {
        civil: 70000,
        mechanical: 120000,
        electrical: 180000,
        extra: 180000
    },

    datacenter: {
        civil: 1200000,
        mechanical: 2400000,
        electrical: 3800000,
        extra: 0
    }
};


// ---------------------------------------------
// FORMAT CURRENCY
// ---------------------------------------------

function euro(value) {
    return new Intl.NumberFormat('en-IE', {
        style: 'currency',
        currency: 'EUR',
        maximumFractionDigits: 0
    }).format(value);
}


// ---------------------------------------------
// PROJECT TYPE SELECTION
// ---------------------------------------------

document.getElementById('projectType')
.addEventListener('change', function() {

    document.getElementById('durationGroup').style.display =
        this.value === 'bess' ? 'block' : 'none';

    document.getElementById('results').style.display = 'none';
});


// ---------------------------------------------
// CALCULATE BUDGET
// ---------------------------------------------

function calculateBudget() {

    const country = countrySelect.value;
    const type = document.getElementById('projectType').value;
    const capacity = Number(document.getElementById('capacity').value);
    const margin = Number(document.getElementById('margin').value);
    const duration = document.getElementById('duration').value;

    // Validation
    if (!country || !type ||
        document.getElementById('capacity').value === '' ||
        document.getElementById('margin').value === '') {

        alert('Please complete all required fields.');
        return;
    }

    if (!Number.isFinite(capacity) || capacity <= 0) {
        alert('Please enter a valid project capacity.');
        return;
    }

    if (!Number.isFinite(margin) || margin < 0 || margin >= 100) {
        alert('Please enter a profit margin between 0 and 99.9%.');
        return;
    }

    if (type === 'bess' && !duration) {
        alert('Please select BESS duration.');
        return;
    }

    const factor = countryFactors[country] || 1.00;
    const rates = projectRates[type];

    // Cost per MW
    const civilPerMW = rates.civil * factor;
    const mechanicalPerMW = rates.mechanical * factor;
    const electricalPerMW = rates.electrical * factor;
    const extraPerMW = rates.extra * factor;

    // Total category costs
    const civil = civilPerMW * capacity;
    const mechanical = mechanicalPerMW * capacity;
    const electrical = electricalPerMW * capacity;
    const extra = extraPerMW * capacity;

    // Total EPC cost
    const totalCost = civil + mechanical + electrical + extra;

    // Selling price based on profit margin
    const sellingPrice = totalCost / (1 - margin / 100);
    const profit = sellingPrice - totalCost;

    // Display summary
    document.getElementById('civilCost').textContent = euro(civil);
    document.getElementById('mechanicalCost').textContent = euro(mechanical);
    document.getElementById('electricalCost').textContent = euro(electrical);
    document.getElementById('extraCost').textContent = euro(extra);
    document.getElementById('totalCost').textContent = euro(totalCost);

    document.getElementById('marginResult').textContent =
        margin.toFixed(2) + '%';

    document.getElementById('profit').textContent = euro(profit);

    document.getElementById('costPerMW').textContent =
        euro(totalCost / capacity);

    document.getElementById('sellingPrice').textContent =
        euro(sellingPrice);

    // Project details
    const countryName = countryNames.of(country);

    const projectName = document.getElementById('projectType')
        .selectedOptions[0].text;

    document.getElementById('projectDetails').textContent =
        'Project: ' + projectName +
        ' | Country: ' + countryName +
        ' | Capacity: ' + capacity + ' MW' +
        (type === 'bess' ? ' | Duration: ' + duration + ' Hours' : '');

    // Cost breakdown table
    const rows = [
        ['Civil Works', civilPerMW, civil],
        ['Mechanical Works', mechanicalPerMW, mechanical],
        ['Electrical Works', electricalPerMW, electrical],
        ['Additional Costs', extraPerMW, extra],
        ['TOTAL EPC COST', totalCost / capacity, totalCost]
    ];

    const tbody = document.getElementById('breakdownTable');
    tbody.innerHTML = '';

    rows.forEach((item, index) => {

        const tr = document.createElement('tr');

        if (index === rows.length - 1) {
            tr.className = 'total-row';
        }

        item.forEach((value, cellIndex) => {

            const td = document.createElement('td');

            td.textContent = cellIndex === 0
                ? value
                : euro(value);

            tr.appendChild(td);
        });

        tbody.appendChild(tr);
    });

    document.getElementById('results').style.display = 'block';

    document.getElementById('results').scrollIntoView({
        behavior: 'smooth',
        block: 'start'
    });
}


// ---------------------------------------------
// RESET
// ---------------------------------------------

function resetCalculator() {

    document.getElementById('country').value = '';
    document.getElementById('projectType').value = '';
    document.getElementById('capacity').value = '';
    document.getElementById('margin').value = '';
    document.getElementById('duration').value = '';

    document.getElementById('durationGroup').style.display = 'none';
    document.getElementById('results').style.display = 'none';

    window.scrollTo({
        top: 0,
        behavior: 'smooth'
    });
}

</script>

</body>
</html>
