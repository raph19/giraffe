function localName(name){const lang=$('language').value;return (generatedNames[lang]&&generatedNames[lang][name])||name;}

function fmt(n){return new Intl.NumberFormat('en-IE',{maximumFractionDigits:2}).format(n)}function money(n){return new Intl.NumberFormat('en-IE',{style:'currency',currency:'EUR',maximumFractionDigits:0}).format(n)}
function getMaterials(type,cap,duration,o,factor){let m=[];if(type==='solar'){let count=Math.ceil(cap*1e6/o.modulePower),strings=Math.ceil(count/o.modulesPerString),modRate=moduleOptions[o.tech].price*o.modulePower;m=[['PV Modules',count,'pcs',modRate],['PV Strings',strings,'strings',0],['String Inverters',o.inverters,'units',18000],['Mounting Structure',count,'sets',31],['DC Cables',o.dcLength,'m',1.25],['AC LV Cables',o.acLength,'m',7.5],['MV Cable',o.mvLength,'m',22],['HV / Export Cable',o.hvLength,'m',38],['Fibre Optic / Communication Cable',o.fibreLength,'m',1.8],['Access Roads',o.roadLength,'m',95],['MV Substations',o.substations,'units',95000],['MV Switchgear',o.substations,'sets',28000],['DC Connectors',count*2,'pcs',2.1],['SCADA / Monitoring',cap,'MWp',2400]];}else if(type==='bess'){let energy=cap*duration,containers=Math.ceil(energy/o.batteryBlockSize),pcs=Math.ceil(cap/o.pcsBlockSize),transformers=Math.ceil(cap/5);m=[['Battery System / Containers',energy,'MWh',93000],['Power Conversion System (PCS)',pcs,'units',85000*o.pcsBlockSize],['MV Transformer & Switchgear',transformers,'sets',95000],['EMS / BMS',1,'system',45000],['Fire Suppression & HVAC',containers,'sets',26000],['Civil Foundations',energy,'MWh',6500],['MV / HV Cabling',o.bessCableLength,'m',22],['Access Roads',o.bessRoadLength,'m',95]];}else{let upsFactor=o.upsRedundancy,genCount=Math.ceil(cap/o.generatorBlockSize),transformers=Math.ceil(cap/5),coolingLoad=cap*1.2*(o.pue/1.4);m=[['Server Racks',cap*80,'units',4500],['UPS Systems',cap*upsFactor,'MW',180000],['Generators',genCount,'units',o.generatorBlockSize*350000/2],['MV Transformers',transformers,'units',85000],['Cooling Systems',coolingLoad,'MWth',95000],['Power Cables',o.dcPowerLength,'m',12],['Fibre Optic / Data Cables',o.dcFibreLength,'m',1.8],['Fire Suppression',cap,'systems',18000]];}return m.map(x=>[x[0],x[1],x[2],x[3]*factor]);}
function calculateBudget(scroll=false){const country=$('country').value,type=$('projectType').value,cap=Number($('capacity').value);let err='';if(!country||!type||!Number.isFinite(cap)||cap<=0)err=tr('validation');let o={};const readLength=(id,assumption)=>{const raw=$(id).value;return raw.trim()===''?assumption:Math.max(0,Number(raw)||0)};if(type==='solar'){o.tech=$('solarTechnology').value;o.modulePower=Number($('modulePower').value);o.mounting=$('mountingType').value;o.inverters=Number($('inverters').value);o.substations=Number($('substations').value);o.modulesPerString=Number($('modulesPerString').value);o.dcLength=readLength('dcCableLength',cap*assumptions.solar.dc);o.acLength=readLength('acCableLength',cap*assumptions.solar.ac);o.mvLength=readLength('mvCableLength',cap*assumptions.solar.mv);o.hvLength=readLength('hvCableLength',cap*assumptions.solar.hv);o.fibreLength=readLength('fibreCableLength',cap*assumptions.solar.fibre);o.roadLength=readLength('roadLength',cap*assumptions.solar.road);if(!o.tech||!o.modulePower||!o.mounting||!Number.isInteger(o.inverters)||o.inverters<1||!Number.isInteger(o.substations)||o.substations<1||!Number.isInteger(o.modulesPerString)||o.modulesPerString<1)err=tr('solarValidation');}if(type==='bess'){o.duration=Number($('duration').value);o.chemistry=$('batteryChemistry').value;o.batteryBlockSize=Number($('batteryBlockSize').value)||5;o.pcsBlockSize=Number($('pcsBlockSize').value)||2.5;o.bessCableLength=readLength('bessCableLength',cap*assumptions.bess.cable);o.bessRoadLength=readLength('bessRoadLength',cap*assumptions.bess.road);if(!o.duration||o.duration<=0||!o.chemistry)err=tr('bessValidation');}if(type==='datacenter'){o.tier=$('dataCenterTier').value;o.cooling=$('coolingType').value;o.pue=Number($('pue').value)||1.4;o.upsRedundancy=Number($('upsRedundancy').value)||1.1;o.generatorBlockSize=Number($('generatorBlock').value)||2;o.dcPowerLength=readLength('dcCableRoute',cap*assumptions.datacenter.powerCable);o.dcFibreLength=readLength('dcFibreRoute',cap*assumptions.datacenter.fibre);if(!o.tier||!o.cooling)err=tr('dcValidation');}if(err){$('validationMessage').textContent=err;$('results').style.display='none';lastCalculation=null;return false;}$('validationMessage').textContent='';const factor=countryRates[country]??1;let costs=[],total=0;if(type==='solar'){let base=cap*(rates.solar.civil+rates.solar.mechanical+rates.solar.electrical);if(o.mounting==='tracker')base*=1.08;const contingency=base*.06;costs=[['Civil Works & Infrastructure',cap*rates.solar.civil],['Mechanical Works & Mounting',cap*rates.solar.mechanical*(o.mounting==='tracker'?1.08:1)],['Electrical Works & Grid Equipment',cap*rates.solar.electrical],['Engineering, PM & Commissioning',base*.07],['Contingency / Unforeseen Costs',contingency]];let sum=costs.reduce((s,x)=>s+x[1],0);costs[3][1]=Math.max(0,sum-(costs[0][1]+costs[1][1]+costs[2][1]+costs[4][1]));}else if(type==='bess'){let energy=cap*o.duration,battery=energy*rates.bess.batteryPerMWh,bop=cap*rates.bess.civil;let pre=battery+bop;costs=[['Battery System Procurement',battery],['PCS, MV & Electrical Balance of Plant',bop],['Engineering, Integration & Commissioning',pre*.08],['Contingency / Unforeseen Costs',pre*.05]];}else{let pre=cap*(rates.datacenter.civil+rates.datacenter.mechanical+rates.datacenter.electrical);costs=[['Civil Works',cap*rates.datacenter.civil],['Mechanical & Cooling',cap*rates.datacenter.mechanical],['Electrical & Power Systems',cap*rates.datacenter.electrical],['Engineering, Integration & Commissioning',pre*.08],['Contingency / Unforeseen Costs',pre*.07]];}
// Route-length variation is priced from the existing BOQ unit rates. The 15% uplift allows for installation, handling and contractor delivery costs; the country factor is applied consistently.
let routeAdjustments=[];const addRouteAdjustment=(label,actual,baseline,unitRate)=>{const delta=actual-baseline;const amount=delta*unitRate*1.15*factor;if(Math.abs(amount)>.005)routeAdjustments.push({label,actual,baseline,delta,unitRate,amount});};if(type==='solar'){addRouteAdjustment('DC Cables',o.dcLength,cap*assumptions.solar.dc,routeRates.dc);addRouteAdjustment('AC LV Cables',o.acLength,cap*assumptions.solar.ac,routeRates.ac);addRouteAdjustment('MV Cable',o.mvLength,cap*assumptions.solar.mv,routeRates.mv);addRouteAdjustment('HV / Export Cable',o.hvLength,cap*assumptions.solar.hv,routeRates.hv);addRouteAdjustment('Fibre Optic / Communication Cable',o.fibreLength,cap*assumptions.solar.fibre,routeRates.fibre);addRouteAdjustment('Access Roads',o.roadLength,cap*assumptions.solar.road,routeRates.road);}else if(type==='bess'){addRouteAdjustment('MV / HV Cabling',o.bessCableLength,cap*assumptions.bess.cable,routeRates.bessCable);addRouteAdjustment('Access Roads',o.bessRoadLength,cap*assumptions.bess.road,routeRates.bessRoad);}else{addRouteAdjustment('Power Cables',o.dcPowerLength,cap*assumptions.datacenter.powerCable,routeRates.dcPower);addRouteAdjustment('Fibre Optic / Data Cables',o.dcFibreLength,cap*assumptions.datacenter.fibre,routeRates.dcFibre);}const routeAdjustment=routeAdjustments.reduce((sum,x)=>sum+x.amount,0);let designAdjustment=0;if(type==='datacenter'){const baselineUps=1.1,baselinePue=1.4;designAdjustment=((o.upsRedundancy-baselineUps)*cap*180000+(cap*1.2*(o.pue/1.4)-cap*1.2)*95000)*1.15*factor;}costs=costs.map(x=>[x[0],x[1],x[1]*factor]);let totalBeforeAdjustment=costs.reduce((sum,x)=>sum+x[2],0);let adjustedTotal=Math.max(0,totalBeforeAdjustment+routeAdjustment+designAdjustment);costs.push(['Route / Quantity Adjustment',routeAdjustment/factor,routeAdjustment]);if(Math.abs(designAdjustment)>.005)costs.push(['Design Configuration Adjustment',designAdjustment/factor,designAdjustment]);total=adjustedTotal;const denominator=type==='bess'?cap*o.duration:cap;const unitLabel=type==='bess'?tr('perMWh'):tr('perMW');$('costTable').innerHTML=costs.map(x=>`<tr><td>${localName(x[0])}</td><td>${money(x[1])}</td><td>${factor.toFixed(2)}</td><td>${money(x[2])}</td></tr>`).join('');$('costTotal').textContent=money(total);$('totalBudget').textContent=money(total);$('costPerMW').textContent=`${tr('estimatedCostPer')} ${unitLabel}: ${money(total/denominator)}`;let detail=type==='solar'?`${moduleOptions[o.tech].name} · ${o.modulePower} Wp · ${o.mounting==='tracker'?tr('singleAxis'):tr('fixedTilt')} · ${fmt(Math.ceil(cap*1e6/o.modulePower))} ${tr('modules')} · ${fmt(Math.ceil(Math.ceil(cap*1e6/o.modulePower)/o.modulesPerString))} ${tr('strings')} · ${o.inverters} ${tr('invertersUnit')} · ${o.substations} ${tr('mvSubstations')}`:type==='bess'?`${o.chemistry} · ${fmt(cap*o.duration)} MWh · ${o.duration} ${tr('hours')} · ${Math.ceil(cap/o.pcsBlockSize)} PCS blocks`: `${o.tier} · ${o.cooling} · PUE ${o.pue} · UPS ${o.upsRedundancy===2?'2N':o.upsRedundancy===1.1?'N+1':'N'}`;$('projectSummary').textContent=`${type==='solar'?tr('solarPV'):type==='bess'?tr('bess'):tr('dataCenter')} | ${fmt(cap)} ${type==='solar'?'MWp':'MW'} | ${detail}`;$('marketSummary').textContent=`${tr('market')}: ${getCountryName(country)} | ${tr('marketFactor')}: ${factor.toFixed(2)}`;let materials=getMaterials(type,cap,o.duration||0,o,factor);$('materialTable').innerHTML=materials.map(x=>{let q=x[1],line=q*x[3];return `<tr><td>${localName(x[0])}</td><td>${fmt(q)}</td><td>${x[2]}</td><td>${money(x[3])}</td><td>${money(line)}</td></tr>`}).join('');const materialTotal=materials.reduce((sum,x)=>sum+x[1]*x[3],0);$('materialTotal').textContent=money(materialTotal);lastCalculation={country,countryName:getCountryName(country),type,capacity:cap,options:o,factor,costs,total,unitCost:total/denominator,materials,materialTotal,routeAdjustments,routeAdjustment,designAdjustment,baselineAssumptions:assumptions[type]};$('results').style.display='block';if(scroll)$('results').scrollIntoView({behavior:'smooth',block:'start'});return true;}
function scheduleCalculation(){clearTimeout(autoTimer);autoTimer=setTimeout(()=>{if($('country').value&&$('projectType').value&&$('capacity').value)calculateBudget(false);},220)}
$('budgetForm').addEventListener('submit',e=>{e.preventDefault();calculateBudget(true);});$('budgetForm').addEventListener('keydown',e=>{if(e.key==='Enter'&&(e.target.matches('input,select'))){e.preventDefault();calculateBudget(true);}});$('projectType').addEventListener('change',()=>{updateCapacityLabel();scheduleCalculation()});$('language').addEventListener('change',()=>{setLanguage();if(lastCalculation)calculateBudget(false);});$('budgetForm').querySelectorAll('input,select').forEach(el=>{el.addEventListener('input',scheduleCalculation);el.addEventListener('change',scheduleCalculation);});
$('resetBtn').addEventListener('click',()=>{$('budgetForm').reset();$('results').style.display='none';$('validationMessage').textContent='';$('solarDerived').style.display='none';lastCalculation=null;updateCapacityLabel();});
$('exportBtn').addEventListener('click',()=>{if(!lastCalculation){alert(tr('exportAlert'));return;}if(typeof XLSX==='undefined'){alert(tr('excelAlert'));return;}const d=lastCalculation;const wb=XLSX.utils.book_new();let rows=[['EPC BUDGET ESTIMATE'],['Country',d.countryName],['Project Type',d.type],['Capacity (MW / MWp)',d.capacity],['Market Factor',d.factor],[],['EPC Breakdown'],['Category','Base Cost (€)','Estimated Cost (€)'],...d.costs.map(x=>[x[0],x[1],x[2]]),['TOTAL EPC COST','','',d.total],[],['Material Reference'],['Material','Quantity','Unit','Unit Price (€)','Reference Total (€)'],...d.materials.map(x=>[x[0],x[1],x[2],x[3],x[1]*x[3]]),['Material reference total','','','',d.materialTotal],[],['Material reference is informational only and is not added again to EPC total.']];XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rows),'Budget Estimate');XLSX.writeFile(wb,`EPC_Budget_${d.country}_${d.type}_${d.capacity}.xlsx`);});
function updateSolarDerived(){if($('projectType').value==='solar'){const cap=Number($('capacity').value),wp=Number($('modulePower').value),mps=Number($('modulesPerString').value);if(cap>0&&wp>0&&mps>0){const modules=Math.ceil(cap*1e6/wp);$('solarDerived').style.display='block';$('solarDerived').textContent=`${tr('calculatedModules')}: ${fmt(modules)} | ${tr('estimatedStrings')}: ${fmt(Math.ceil(modules/mps))}`;}else $('solarDerived').style.display='none';}}['capacity','modulePower','modulesPerString'].forEach(id=>$(id).addEventListener('input',updateSolarDerived));
setLanguage();updateCapacityLabel();
