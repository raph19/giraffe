/* TRANSLATION FUNCTION */

function tr(key){
 const lang=$('language').value;
 return (labels[lang] && labels[lang][key]) || labels.en[key] || key;
}

/* TRANSLATE ALL ELEMENTS */

function setLanguage(){

 const lang=$('language').value;

 document.documentElement.lang=lang;
 document.documentElement.dir=lang==='ar'?'rtl':'ltr';

 document.querySelectorAll('[data-i18n]').forEach(el=>{
  const key=el.dataset.i18n;
  if(tr(key)) el.textContent=tr(key);
 });

 updateCapacityLabel();
 updateSolarDerived();

 if(lastCalculation) calculateBudget(false);
}

/* CAPACITY LABEL */

function updateCapacityLabel(){

 const type=$('projectType').value;

 $('capacityLabel').textContent=
  type==='solar'?tr('capacitySolar'):
  type==='bess'?tr('capacityBess'):
  type==='datacenter'?tr('capacityDc'):
  tr('projectType');

 const groups=[
  'solarTechnologyGroup','modulePowerGroup','mountingGroup',
  'invertersGroup','substationsGroup','modulesStringGroup',
  'mvCableGroup','dcCableGroup','acCableGroup','hvCableGroup',
  'fibreCableGroup','roadLengthGroup','durationGroup',
  'chemistryGroup','tierGroup','coolingGroup'
 ];

 groups.forEach(id=>$(id).style.display='none');

 const show=ids=>ids.forEach(id=>$(id).style.display='block');

 if(type==='solar') show(groups.slice(0,12));
 if(type==='bess') show(['durationGroup','chemistryGroup']);
 if(type==='datacenter') show(['tierGroup','coolingGroup']);
}

/* FORMATTING */

function fmt(n){
 return new Intl.NumberFormat('en-IE',{maximumFractionDigits:2}).format(n);
}

function money(n){
 return new Intl.NumberFormat('en-IE',{
  style:'currency',
  currency:'EUR',
  maximumFractionDigits:0
 }).format(n);
}

let lastCalculation=null;
let autoTimer=null;

/* MATERIAL REFERENCE */

function getMaterials(type,cap,duration,o,factor){

 let materials=[];

 if(type==='solar'){

  let count=Math.ceil(cap*1e6/o.modulePower);
  let strings=Math.ceil(count/o.modulesPerString);
  let moduleRate=moduleOptions[o.tech].price*o.modulePower;

  materials=[
   ['PV Modules',count,'pcs',moduleRate],
   ['PV Strings',strings,'strings',0],
   ['String Inverters',o.inverters,'units',18000],
   ['Mounting Structure',count,'sets',31],
   ['DC Cables',o.dcLength,'m',1.25],
   ['AC LV Cables',o.acLength,'m',7.5],
   ['MV Cable',o.mvLength,'m',22],
   ['HV / Export Cable',o.hvLength,'m',38],
   ['Fibre Optic Cable',o.fibreLength,'m',1.8],
   ['Access Roads',o.roadLength,'m',95],
   ['MV Substations',o.substations,'units',95000],
   ['MV Switchgear',o.substations,'sets',28000],
   ['DC Connectors',count*2,'pcs',2.1],
   ['SCADA / Monitoring',cap,'MWp',2400]
  ];

 }else if(type==='bess'){

  let energy=cap*duration;
  let containers=Math.ceil(energy/5);

  materials=[
   ['Battery System / Containers',energy,'MWh',93000],
   ['Power Conversion System (PCS)',cap,'MW',85000],
   ['MV Transformer & Switchgear',cap/5,'sets',95000],
   ['EMS / BMS',1,'system',45000],
   ['Fire Suppression & HVAC',containers,'sets',26000],
   ['Civil Foundations',energy,'MWh',6500],
   ['MV / HV Cabling',cap*250,'m',22]
  ];

 }else{

  materials=[
   ['Server Racks',cap*80,'units',4500],
   ['UPS Systems',cap,'MW',180000],
   ['Generators',cap/2,'units',350000],
   ['MV Transformers',cap/5,'units',85000],
   ['Cooling Systems',cap*1.2,'MWth',95000],
   ['Power Cables',cap*1800,'m',12],
   ['Fire Suppression',cap,'systems',18000]
  ];
 }

 return materials.map(item=>[
  item[0],item[1],item[2],item[3]*factor
 ]);
}

/* MAIN CALCULATION */

function calculateBudget(scroll=false){

 const country=$('country').value;
 const type=$('projectType').value;
 const cap=Number($('capacity').value);

 let error='';

 if(!country||!type||!Number.isFinite(cap)||cap<=0){
  error=tr('error');
 }

 let o={};

 if(type==='solar'){

  o.tech=$('solarTechnology').value;
  o.modulePower=Number($('modulePower').value);
  o.mounting=$('mountingType').value;
  o.inverters=Number($('inverters').value);
  o.substations=Number($('substations').value);
  o.modulesPerString=Number($('modulesPerString').value);

  o.mvLength=Number($('mvCableLength').value)||0;
  o.dcLength=Number($('dcCableLength').value)||0;
  o.acLength=Number($('acCableLength').value)||0;
  o.hvLength=Number($('hvCableLength').value)||0;
  o.fibreLength=Number($('fibreCableLength').value)||0;
  o.roadLength=Number($('roadLength').value)||0;

  if(!o.tech||!o.modulePower||!o.mounting||
     !Number.isInteger(o.inverters)||o.inverters<1||
     !Number.isInteger(o.substations)||o.substations<1||
     !Number.isInteger(o.modulesPerString)||o.modulesPerString<1){
   error=tr('errorSolar');
  }
 }

 if(type==='bess'){

  o.duration=Number($('duration').value);
  o.chemistry=$('batteryChemistry').value;

  if(!o.duration||o.duration<=0||!o.chemistry){
   error=tr('errorBess');
  }
 }

 if(type==='datacenter'){

  o.tier=$('dataCenterTier').value;
  o.cooling=$('coolingType').value;

  if(!o.tier||!o.cooling){
   error=tr('errorDc');
  }
 }

 if(error){
  $('validationMessage').textContent=error;
  $('results').style.display='none';
  lastCalculation=null;
  return false;
 }

 $('validationMessage').textContent='';

 const factor=countryRates[country]??1;

 let costs=[];

 /* SOLAR */

 if(type==='solar'){

  let base=cap*(
   rates.solar.civil+
   rates.solar.mechanical+
   rates.solar.electrical
  );

  if(o.mounting==='tracker') base*=1.08;

  const contingency=base*.06;

  costs=[
   ['Civil Works & Infrastructure',cap*rates.solar.civil],
   ['Mechanical Works & Mounting',cap*rates.solar.mechanical*(o.mounting==='tracker'?1.08:1)],
   ['Electrical Works & Grid Equipment',cap*rates.solar.electrical],
   ['Engineering, PM & Commissioning',base*.07],
   ['Contingency / Unforeseen Costs',contingency]
  ];

  let sum=costs.reduce((s,x)=>s+x[1],0);

  costs[3][1]=Math.max(0,sum-(
   costs[0][1]+costs[1][1]+costs[2][1]+costs[4][1]
  ));

 }

 /* BESS */

 else if(type==='bess'){

  let energy=cap*o.duration;
  let battery=energy*rates.bess.batteryPerMWh;
  let bop=cap*rates.bess.civil;
  let pre=battery+bop;

  costs=[
   ['Battery System Procurement',battery],
   ['PCS, MV & Electrical Balance of Plant',bop],
   ['Engineering, Integration & Commissioning',pre*.08],
   ['Contingency / Unforeseen Costs',pre*.05]
  ];

 }

 /* DATA CENTER */

 else{

  let pre=cap*(
   rates.datacenter.civil+
   rates.datacenter.mechanical+
   rates.datacenter.electrical
  );

  costs=[
   ['Civil Works',cap*rates.datacenter.civil],
   ['Mechanical & Cooling',cap*rates.datacenter.mechanical],
   ['Electrical & Power Systems',cap*rates.datacenter.electrical],
   ['Engineering, Integration & Commissioning',pre*.08],
   ['Contingency / Unforeseen Costs',pre*.07]
  ];
 }

 costs=costs.map(item=>[
  item[0],item[1],item[1]*factor
 ]);

 const total=costs.reduce((sum,item)=>sum+item[2],0);

 const denominator=type==='bess'?cap*o.duration:cap;

 const unitLabel=type==='bess'?tr('perMWh'):tr('perMW');

 $('costTable').innerHTML=costs.map(item=>`
 <tr>
 <td>${item[0]}</td>
 <td>${money(item[1])}</td>
 <td>${factor.toFixed(2)}</td>
 <td>${money(item[2])}</td>
 </tr>
 `).join('');

 $('costTotal').textContent=money(total);
 $('totalBudget').textContent=money(total);

 $('costPerMW').textContent=
 `${unitLabel}: ${money(total/denominator)}`;

 let detail=type==='solar'
  ?`${moduleOptions[o.tech].name} · ${o.modulePower} Wp · ${o.mounting} · ${fmt(Math.ceil(cap*1e6/o.modulePower))} modules · ${fmt(Math.ceil(Math.ceil(cap*1e6/o.modulePower)/o.modulesPerString))} strings · ${o.inverters} inverters · ${o.substations} MV substations`
  :type==='bess'
  ?`${o.chemistry} · ${fmt(cap*o.duration)} MWh · ${o.duration} hours`
  :`${o.tier} · ${o.cooling}`;

 $('projectSummary').textContent=
 `${type.toUpperCase()} | ${fmt(cap)} ${type==='solar'?'MWp':'MW'} | ${detail}`;

 $('marketSummary').textContent=
 `${tr('market')}: ${countryNames.of(country)} | ${tr('marketFactor')}: ${factor.toFixed(2)}`;

 let materials=getMaterials(type,cap,o.duration||0,o,factor);

 $('materialTable').innerHTML=materials.map(item=>{

  let quantity=item[1];
  let line=quantity*item[3];

  return `
  <tr>
  <td>${item[0]}</td>
  <td>${fmt(quantity)}</td>
  <td>${item[2]}</td>
  <td>${money(item[3])}</td>
  <td>${money(line)}</td>
  </tr>
  `;

 }).join('');

 const materialTotal=materials.reduce(
  (sum,item)=>sum+item[1]*item[3],0
 );

 $('materialTotal').textContent=money(materialTotal);

 lastCalculation={
  country,
  countryName:countryNames.of(country),
  type,
  capacity:cap,
  options:o,
  factor,
  costs,
  total,
  unitCost:total/denominator,
  materials,
  materialTotal
 };

 $('results').style.display='block';

 if(scroll){
  $('results').scrollIntoView({
   behavior:'smooth',
   block:'start'
  });
 }

 return true;
}

/* AUTOMATIC CALCULATION */

function scheduleCalculation(){

 clearTimeout(autoTimer);

 autoTimer=setTimeout(()=>{

  if($('country').value&&
     $('projectType').value&&
     $('capacity').value){
   calculateBudget(false);
  }

 },300);
}

/* SOLAR MODULE PREVIEW */

function updateSolarDerived(){

 if($('projectType').value!=='solar'){
  $('solarDerived').style.display='none';
  return;
 }

 const cap=Number($('capacity').value);
 const wp=Number($('modulePower').value);
 const mps=Number($('modulesPerString').value);

 if(cap>0&&wp>0&&mps>0){

  const modules=Math.ceil(cap*1e6/wp);
  const strings=Math.ceil(modules/mps);

  $('solarDerived').style.display='block';

  $('solarDerived').textContent=
  `${tr('modules')}: ${fmt(modules)} | ${tr('strings')}: ${fmt(strings)}`;

 }else{
  $('solarDerived').style.display='none';
 }
}

/* EVENTS */

$('budgetForm').addEventListener('submit',e=>{
 e.preventDefault();
 calculateBudget(true);
});

$('budgetForm').addEventListener('keydown',e=>{
 if(e.key==='Enter'&&e.target.matches('input,select')){
  e.preventDefault();
  calculateBudget(true);
 }
});

$('projectType').addEventListener('change',()=>{
 updateCapacityLabel();
 updateSolarDerived();
 scheduleCalculation();
});

$('language').addEventListener('change',setLanguage);

$('budgetForm').querySelectorAll('input,select').forEach(el=>{
 el.addEventListener('input',()=>{
  updateSolarDerived();
  scheduleCalculation();
 });
 el.addEventListener('change',scheduleCalculation);
});

/* RESET */

$('resetBtn').addEventListener('click',()=>{

 $('budgetForm').reset();
 $('results').style.display='none';
 $('validationMessage').textContent='';
 $('solarDerived').style.display='none';

 lastCalculation=null;

 updateCapacityLabel();

});

/* EXCEL EXPORT */

$('exportBtn').addEventListener('click',()=>{

 if(!lastCalculation){
  alert(tr('calculateFirst'));
  return;
 }

 if(typeof XLSX==='undefined'){
  alert(tr('noExcel'));
  return;
 }

 const d=lastCalculation;

 const wb=XLSX.utils.book_new();

 let rows=[
  ['EPC BUDGET ESTIMATE'],
  ['Country',d.countryName],
  ['Project Type',d.type],
  ['Capacity (MW / MWp)',d.capacity],
  ['Market Factor',d.factor],
  [],
  ['EPC Breakdown'],
  ['Category','Base Cost (€)','Estimated Cost (€)'],
  ...d.costs.map(x=>[x[0],x[1],x[2]]),
  ['TOTAL EPC COST','','',d.total],
  [],
  ['Material Reference'],
  ['Material','Quantity','Unit','Unit Price (€)','Reference Total (€)'],
  ...d.materials.map(x=>[x[0],x[1],x[2],x[3],x[1]*x[3]]),
  ['Material Reference Total','','','',d.materialTotal],
  [],
  ['Material reference is informational only and is not added again to EPC total.']
 ];

 XLSX.utils.book_append_sheet(
  wb,
  XLSX.utils.aoa_to_sheet(rows),
  'Budget Estimate'
 );

 XLSX.writeFile(
  wb,
  `EPC_Budget_${d.country}_${d.type}_${d.capacity}.xlsx`
 );

});

/* INITIALISE */

setLanguage();
updateCapacityLabel();

</script>
</body>
</html>
